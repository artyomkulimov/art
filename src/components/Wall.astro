---
/**
 * The site. One architectural drawing: lettered grid axes run down the whole
 * page, the paintings hang on wall elevations, and a schedule below lists
 * every work. Clicking a painting opens it in place — the grid stays put,
 * everything else steps aside — and scrolling down puts it back. `open`
 * renders a painting already open, for its own address (/<id>/).
 */
import { Picture } from "astro:assets";
import { getPaintings } from "@/lib/paintings";
import { type Elevation, HANG, hang, sizeOf } from "@/lib/sheet";

interface Props {
  open?: string;
}

const paintings = await getPaintings();
const openIndex = paintings.findIndex((p) => p.id === Astro.props.open);

const sizes = paintings.map(sizeOf);
const aspects = paintings.map((p) => p.image.width / p.image.height);

const D_COLS = 12;
const M_COLS = 4;
const desk = hang(aspects, { cols: D_COLS, perRow: 3, maxW: 3.3, maxH: 3.4 });
const mob = hang(aspects, { cols: M_COLS, perRow: 1, maxW: 3.3, maxH: 3.6 });

const pad = (n: number) => String(n).padStart(2, "0");
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
const dims = (i: number) =>
  `${sizes[i].approx ? "≈ " : ""}${fmt(sizes[i].h)} × ${fmt(sizes[i].w)} cm`;
const SIZE_IN_MEDIUM = /,?\s*\d[\d.]*\s*[×x]\s*\d[\d.]*\s*cm/;
const mediumOf = (m: string) => m.replace(SIZE_IN_MEDIUM, "");
const letter = (k: number) => String.fromCharCode(97 + k);

const years = paintings
  .map((p) => Number.parseInt(p.year, 10))
  .filter(Number.isFinite);
const span =
  years.length > 0 ? `${Math.min(...years)}–${Math.max(...years)}` : "";
const total = pad(paintings.length);
const rights = [...new Set(paintings.map((p) => p.rights.toLowerCase()))].join(
  " / "
);

/** Inline position for something placed in cells, with desktop and mobile values. */
const at = (
  d: { x: number; y: number; w: number; h: number },
  m: { x: number; y: number; w: number; h: number }
) =>
  `--dx:${d.x};--dy:${d.y};--dw:${d.w};--dh:${d.h};--mx:${m.x};--my:${m.y};--mw:${m.w};--mh:${m.h}`;

const wallsOf = (e: Elevation, cls: string) =>
  e.walls.map((w, k) => ({
    ...w,
    k,
    cls,
    name: `wall ${letter(k)}`,
    hung: e.hung.filter((h) => h.wall === k),
  }));
const walls = [...wallsOf(desk, "d-only"), ...wallsOf(mob, "m-only")];

const siteTitle = "paintings — artyom kulimov";
const opened = openIndex >= 0 ? paintings[openIndex] : undefined;
const title = opened
  ? `${opened.title.toLowerCase()} — ${siteTitle}`
  : siteTitle;
const description = opened
  ? `${opened.title} by ${opened.artist}, ${opened.year}.`
  : "A collection of paintings Artyom Kulimov finds beautiful.";
---

<!doctype html>
<html lang="en" class:list={[{ "is-open": openIndex >= 0 }]}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
    <link
      rel="preload"
      href="/fonts/switzer-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    >
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&display=swap"
    >
  </head>
  <body>
    <main class="page">
      <div
        class="sheet"
        id="sheet"
        style={`--dh-elev:${desk.height};--mh-elev:${mob.height}`}
      >
        <!-- The grid: lettered axes, the same on every view. -->
        <div class="grid" aria-hidden="true">
          {Array.from({ length: D_COLS + 1 }, (_, k) => (
              <i class:list={["axis", { "d-only": k > M_COLS }]} data-k={k} style={`--k:${k}`} />
            ))}
        </div>
        <div class="strip" aria-hidden="true">
          {Array.from({ length: D_COLS + 1 }, (_, k) => (
              <span class:list={["bubble mono", { "d-only": k > M_COLS }]} data-k={k} style={`--k:${k}`}>
                {letter(k)}
              </span>
            ))}
        </div>

        <div class="content" id="content">
          <header class="hero">
            <div class="ko hero-main">
              <p class="mono label">art.artyomkulimov.com</p>
              <h1>paintings</h1>
              <p class="lede">a collection of paintings i find beautiful.</p>
            </div>
            <dl class="ko hero-meta mono">
              <div>
                <dt>works</dt>
                <dd>{total}</dd>
              </div>
              <div>
                <dt>period</dt>
                <dd>{span}</dd>
              </div>
              <div>
                <dt>rights</dt>
                <dd>{rights}</dd>
              </div>
              <div>
                <dt>hang</dt>
                <dd>{HANG * 100} cm on centre</dd>
              </div>
            </dl>
          </header>

          <section class="elev" aria-label="The paintings">
            {walls.map((w) => (
                <div class={`wall ${w.cls}`} aria-hidden="true">
                  <span class="wall-name ko mono" style={`top:calc(${w.top} * var(--cell))`}>
                    {w.name} <span class="faint">· elevation</span>
                  </span>
                  <i class="datum" style={`top:calc(${w.datum} * var(--cell))`} />
                  <span class="level mono" style={`top:calc(${w.datum} * var(--cell))`}>
                    <b>+{HANG.toFixed(2)}</b>
                  </span>
                  <i class="floor" style={`top:calc(${w.floor} * var(--cell))`} />
                  <span class="level mono" style={`top:calc(${w.floor} * var(--cell))`}>
                    <b>±0.00</b>
                  </span>
                  {w.hung.map((h) => (
                    <i
                      class="leader"
                      style={`left:calc(${h.cx} * var(--cell));top:calc(${w.tags} * var(--cell) + 12px);height:calc(${h.y - w.tags} * var(--cell) - 12px)`}
                    />
                  ))}
                </div>
              ))}

            {paintings.map((p, i) => {
                const d = desk.hung[i];
                const m = mob.hung[i];
                return (
                  <>
                    <a
                      class="tag at"
                      href={`/${p.id}/`}
                      data-i={i}
                      tabindex="-1"
                      aria-label={`No. ${pad(i + 1)}: ${p.title}`}
                      style={`${at({ x: d.cx, y: desk.walls[d.wall].tags, w: 0, h: 0 }, { x: m.cx, y: mob.walls[m.wall].tags, w: 0, h: 0 })};--i:${i}`}
                    >
                      <span class="tag-no mono">{pad(i + 1)}</span>
                      <span class="tag-name ko">{p.title}</span>
                    </a>
                    <a
                      class:list={["work at", { away: i === openIndex }]}
                      href={`/${p.id}/`}
                      data-i={i}
                      data-axis={d.cx}
                      data-maxis={m.cx}
                      style={`${at(d, m)};--i:${i}`}
                      draggable="false"
                      aria-label={`${p.title}, ${p.artist}, ${p.year}`}
                    >
                      <span class="frame" style={`background-color:${p.palette[0]}`}>
                        <Picture
                          src={p.image}
                          formats={["avif", "webp"]}
                          widths={[320, 480, 640, 800, 1000, 1280]}
                          sizes={`(max-width: 760px) ${Math.ceil((m.w / M_COLS) * 94)}vw, ${Math.ceil((d.w / D_COLS) * 94)}vw`}
                          alt=""
                          loading={i < 6 ? "eager" : "lazy"}
                          fetchpriority={i < 3 ? "high" : "auto"}
                          decoding="async"
                          draggable="false"
                        />
                      </span>
                      <span class="dim dim-w mono" aria-hidden="true">
                        <b class="ko">{fmt(sizes[i].w)}</b>
                      </span>
                      <span class="dim dim-h mono" aria-hidden="true">
                        <b class="ko">{fmt(sizes[i].h)}</b>
                      </span>
                    </a>
                  </>
                );
              })}
          </section>

          <section class="schedule" aria-label="Schedule of works">
            <p class="ko mono label sched-title">schedule of works</p>
            <div class="row head mono" aria-hidden="true">
              <span class="c-no">no.</span>
              <span class="c-title">title</span>
              <span class="c-artist">artist, year</span>
              <span class="c-medium">medium</span>
              <span class="c-size">size</span>
            </div>
            {paintings.map((p, i) => (
                <a class="row" href={`/${p.id}/`} data-i={i}>
                  <span class="c-no mono">{pad(i + 1)}</span>
                  <span class="c-title">{p.title}</span>
                  <span class="c-artist">
                    {p.artist}, {p.year}
                  </span>
                  <span class="c-medium">{mediumOf(p.medium)}</span>
                  <span class="c-size mono">{dims(i)}</span>
                </a>
              ))}
          </section>
        </div>
      </div>
    </main>

    <div
      class:list={["view", { in: openIndex >= 0 }]}
      id="view"
      hidden={openIndex < 0}
      data-open={openIndex}
      data-site-title={siteTitle}
      role="dialog"
      aria-modal="true"
      aria-label="Painting"
      tabindex="-1"
    >
      <div class="vsheet">
        {paintings.map((p, i) => (
            <section
              class="detail"
              data-i={i}
              data-id={p.id}
              data-title={p.title.toLowerCase()}
              hidden={i !== openIndex}
              style={`--ar:${aspects[i]}`}
              aria-label={p.title}
            >
              <div class="stage">
                <figure class="fig" style={`background-color:${p.palette[0]}`}>
                  <Picture
                    src={p.image}
                    formats={["avif", "webp"]}
                    widths={[800, 1200, 1600, 2000, 2600, 3200]}
                    sizes="(max-width: 760px) 100vw, 75vw"
                    alt={`${p.title} by ${p.artist}, ${p.year}`}
                    loading={i === openIndex ? "eager" : "lazy"}
                    fetchpriority={i === openIndex ? "high" : "auto"}
                    decoding="async"
                    draggable="false"
                  />
                  <span class="dim dim-w mono" aria-hidden="true">
                    <b class="ko">{fmt(sizes[i].w)} cm</b>
                  </span>
                  <span class="dim dim-h mono" aria-hidden="true">
                    <b class="ko">{fmt(sizes[i].h)} cm</b>
                  </span>
                </figure>
              </div>
              <div class="info ko">
                <p class="mono label">
                  no. {pad(i + 1)} <span class="faint">/ {total}</span>
                </p>
                <h2>{p.title}</h2>
                <p class="by">
                  {p.artist}, {p.year}
                </p>
                {p.story && <p class="story">{p.story}</p>}
                <dl class="spec">
                  <div>
                    <dt class="mono">medium</dt>
                    <dd>{mediumOf(p.medium)}</dd>
                  </div>
                  <div>
                    <dt class="mono">size</dt>
                    <dd>{dims(i)}</dd>
                  </div>
                  <div>
                    <dt class="mono">held at</dt>
                    <dd>{p.location}</dd>
                  </div>
                  <div>
                    <dt class="mono">rights</dt>
                    <dd>{p.rights}</dd>
                  </div>
                  <div>
                    <dt class="mono">image</dt>
                    <dd>{p.source}</dd>
                  </div>
                </dl>
                <a class="orig" href={p.original} target="_blank" rel="noopener">
                  full-resolution original <span aria-hidden="true">↗</span>
                </a>
              </div>
            </section>
          ))}

        <div class="vbar">
          <button type="button" class="ko vb-back" data-close>
            ← the wall
          </button>
          <span class="ko vb-ret">
            <span
              ><span class="on-wheel">scroll down</span
              ><span class="on-touch">swipe up</span>
              to put it back</span
            >
            <i class="ret-bar"><b></b></i>
          </span>
          <span class="ko vb-nav">
            <button type="button" data-step="-1" aria-label="Previous painting">
              ←
            </button>
            <span id="vnum" class="mono"
              >{pad(Math.max(0, openIndex) + 1)}
              / {total}</span
            >
            <button type="button" data-step="1" aria-label="Next painting">
              →
            </button>
          </span>
        </div>
      </div>
    </div>

    <style is:global>
      @font-face {
        font-family: "Switzer";
        src: url("/fonts/switzer-300.woff2") format("woff2");
        font-weight: 300;
        font-display: swap;
      }
      @font-face {
        font-family: "Switzer";
        src: url("/fonts/switzer-400.woff2") format("woff2");
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: "Switzer";
        src: url("/fonts/switzer-500.woff2") format("woff2");
        font-weight: 500;
        font-display: swap;
      }
      * {
        box-sizing: border-box;
        margin: 0;
      }
      :root {
        --bg: #000;
        --ink: #ecebe5;
        --soft: #bebcb3;
        --dim: #84827a;
        --faint: #55534d;
        --axis: #262624;
        --line: #1f1f1d;
        --gut: 48px;
        --cols: 12;
        --pad: 16px;
        --strip: 44px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        /* Resolved inside .page and .view, which both span the viewport. */
        --cell: calc(min(100cqw - 2 * var(--gut), 1600px) / var(--cols));
        color-scheme: dark;
      }
      html {
        scrollbar-gutter: stable;
        background: var(--bg);
      }
      html.is-open {
        overflow: hidden;
      }
      body {
        overflow-x: hidden;
        font-family: "Switzer", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: var(--ink);
        text-transform: lowercase;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button {
        all: unset;
        cursor: pointer;
      }
      img {
        display: block;
      }
      :focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 3px;
      }
      .mono {
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 11px;
        letter-spacing: 0.01em;
      }
      .label {
        color: var(--dim);
      }
      .faint {
        color: var(--faint);
      }
      /* Text masks the grid behind it, like lettering on a drawing. */
      .ko {
        background: var(--bg);
      }

      /* ---------- page, sheet, grid ---------- */
      .page {
        container-type: inline-size;
      }
      .sheet {
        position: relative;
        width: calc(var(--cell) * var(--cols));
        padding-bottom: calc(var(--cell) * 1);
        margin: 0 auto;
      }
      .view {
        container-type: inline-size;
      }

      .grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .axis {
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(var(--k) * var(--cell));
        width: 1px;
        background: repeating-linear-gradient(
          to bottom,
          var(--axis) 0 18px,
          transparent 18px 23px,
          var(--axis) 23px 25px,
          transparent 25px 30px
        );
        transition: filter 0.6s;
        animation: draw 1.8s calc(var(--k) * 45ms) cubic-bezier(0.6, 0, 0.2, 1)
          both;
      }
      .axis.near {
        filter: brightness(1.7);
      }
      @keyframes draw {
        from {
          clip-path: inset(0 0 100% 0);
        }
      }
      @keyframes fade {
        from {
          opacity: 0;
        }
      }
      @keyframes reveal {
        from {
          clip-path: inset(0 0 100% 0);
        }
      }

      /* Lettered bubbles: they stay at the top while you scroll. */
      .strip {
        position: sticky;
        top: 0;
        z-index: 5;
        height: var(--strip);
        padding: 0 var(--gut);
        margin: 0 calc(var(--gut) * -1);
        pointer-events: none;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
      }
      .bubble {
        position: absolute;
        top: 50%;
        left: calc(var(--gut) + var(--k) * var(--cell));
        display: grid;
        place-items: center;
        width: 21px;
        height: 21px;
        padding-bottom: 1px;
        font-size: 10px;
        line-height: 1;
        color: var(--faint);
        background: var(--bg);
        border: 1px solid #353431;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition:
          color 0.5s,
          border-color 0.5s;
        animation: fade 1s calc(0.3s + var(--k) * 45ms) both;
      }
      .bubble.near {
        color: var(--dim);
        border-color: #4a4945;
      }
      .bubble.lit {
        color: var(--ink);
        border-color: #8a877f;
      }

      .content {
        position: relative;
        transition: opacity 0.45s var(--ease);
      }
      html.is-open .content {
        pointer-events: none;
        opacity: 0;
      }

      /* ---------- hero ---------- */
      .hero {
        display: grid;
        grid-template-columns: repeat(var(--cols), var(--cell));
        padding-top: calc(var(--cell) * 0.55);
        animation: fade 1.2s 0.4s both;
      }
      .hero-main {
        grid-column: 1 / span 7;
        padding: var(--pad) var(--pad) calc(var(--pad) * 1.5);
        margin-left: 1px;
      }
      h1 {
        margin: 22px 0 22px -0.05em;
        font-size: clamp(56px, calc(var(--cell) * 1.08), 156px);
        font-weight: 400;
        line-height: 0.9;
        letter-spacing: -0.055em;
      }
      .lede {
        font-size: clamp(16px, calc(var(--cell) * 0.17), 21px);
        font-weight: 300;
        line-height: 1.45;
        color: var(--soft);
        letter-spacing: -0.01em;
      }
      .hero-meta {
        grid-column: 10 / span 3;
        align-self: end;
        padding: var(--pad);
        margin-left: 1px;
      }
      .hero-meta div {
        display: flex;
        gap: 16px;
        justify-content: space-between;
        padding: 9px 0;
        border-bottom: 1px solid var(--line);
      }
      .hero-meta div:last-child {
        border-bottom: 0;
      }
      .hero-meta dt {
        color: var(--faint);
      }
      .hero-meta dd {
        color: var(--soft);
      }

      /* ---------- elevation ---------- */
      .elev {
        position: relative;
        height: calc(var(--dh-elev) * var(--cell));
        margin-top: calc(var(--cell) * 0.5);
      }
      .wall {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .wall-name {
        position: absolute;
        left: 1px;
        padding: 4px var(--pad);
        color: var(--dim);
        animation: fade 1s 0.8s both;
      }
      .datum {
        position: absolute;
        right: 0;
        left: 0;
        height: 1px;
        background: repeating-linear-gradient(
          to right,
          #2e2d2a 0 18px,
          transparent 18px 23px,
          #2e2d2a 23px 25px,
          transparent 25px 30px
        );
        animation: draw-x 1.6s 0.5s cubic-bezier(0.6, 0, 0.2, 1) both;
      }
      .floor {
        position: absolute;
        right: 0;
        left: 0;
        height: 13px;
        background: repeating-linear-gradient(
          -45deg,
          #24231f 0 1px,
          transparent 1px 7px
        );
        border-top: 1px solid #55534d;
        animation: draw-x 1.6s 0.35s cubic-bezier(0.6, 0, 0.2, 1) both;
      }
      @keyframes draw-x {
        from {
          clip-path: inset(0 100% 0 0);
        }
      }
      .level {
        position: absolute;
        left: 0;
        font-size: 10px;
        color: var(--dim);
        animation: fade 1s 1.2s both;
      }
      .level b {
        position: absolute;
        right: 9px;
        bottom: 3px;
        font-weight: 400;
        white-space: nowrap;
      }
      /* the level triangle, tip on the line at the sheet's edge */
      .level::after {
        position: absolute;
        bottom: 0;
        left: -5px;
        content: "";
        border: 5px solid transparent;
        border-top: 7px solid #6a6862;
        border-bottom: 0;
      }
      .leader {
        position: absolute;
        width: 1px;
        background: #3a3935;
        transform-origin: top;
        animation: grow 0.9s calc(1.2s + var(--i, 0) * 0.12s) var(--ease) both;
      }
      @keyframes grow {
        from {
          transform: scaleY(0);
        }
      }

      /* everything placed in grid cells */
      .at {
        --x: var(--dx);
        --y: var(--dy);
        --w: var(--dw);
        --h: var(--dh);
        position: absolute;
        top: calc(var(--y) * var(--cell));
        left: calc(var(--x) * var(--cell));
        width: calc(var(--w) * var(--cell));
        height: calc(var(--h) * var(--cell));
      }

      .work {
        display: block;
        -webkit-user-drag: none;
      }
      .frame {
        position: absolute;
        inset: 0;
        overflow: hidden;
        animation: reveal 1.3s calc(0.6s + var(--i) * 0.14s)
          cubic-bezier(0.7, 0, 0.2, 1) both;
      }
      .frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.88);
        transition: filter 0.8s;
        -webkit-user-drag: none;
      }
      .work.hot .frame img,
      .work:focus-visible .frame img {
        filter: none;
      }
      .work.away .frame {
        visibility: hidden;
      }
      .work:focus-visible {
        outline: none;
      }
      .work:focus-visible .frame {
        outline: 1px solid var(--ink);
        outline-offset: 5px;
      }

      /* Dimension lines with architectural slash ticks: width below, height right. */
      .dim {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        color: #55534d;
        pointer-events: none;
        transition: color 0.6s;
        animation: fade 1s calc(1.3s + var(--i, 0) * 0.14s) both;
      }
      .dim::before,
      .dim::after {
        position: absolute;
        width: 9px;
        height: 1px;
        content: "";
        background: currentColor;
        transform: rotate(-45deg);
      }
      .dim b {
        position: relative;
        padding: 0 7px;
        font-weight: 400;
        line-height: 1;
      }
      .dim-w {
        right: 0;
        bottom: -17px;
        left: 0;
        height: 1px;
        background:
          linear-gradient(currentColor, currentColor) center / 100% 1px
          no-repeat;
      }
      .dim-w::before {
        left: -4px;
      }
      .dim-w::after {
        right: -4px;
      }
      .dim-h {
        top: 0;
        right: -17px;
        bottom: 0;
        width: 1px;
        background:
          linear-gradient(currentColor, currentColor) center / 1px 100%
          no-repeat;
      }
      .dim-h::before {
        top: 0;
      }
      .dim-h::after {
        bottom: 0;
      }
      .dim-h b {
        padding: 7px 0;
        writing-mode: vertical-rl;
      }
      .work.hot .dim {
        color: #a9a69c;
      }

      /* Numbered tags along the top of each wall. */
      .tag {
        display: flex;
        align-items: center;
        animation: fade 1s calc(1.5s + var(--i) * 0.12s) both;
      }
      .tag-no {
        display: grid;
        flex: none;
        place-items: center;
        width: 24px;
        height: 24px;
        margin-left: -12px;
        font-size: 9.5px;
        color: var(--dim);
        background: var(--bg);
        border: 1px solid #45443f;
        border-radius: 50%;
        transition:
          color 0.4s,
          background-color 0.4s,
          border-color 0.4s;
      }
      .tag-name {
        padding: 3px 12px 4px 8px;
        margin-left: 4px;
        font-size: 14px;
        color: var(--dim);
        letter-spacing: -0.005em;
        white-space: nowrap;
        transition: color 0.4s;
      }
      .tag.hot .tag-no {
        color: var(--bg);
        background: var(--ink);
        border-color: var(--ink);
      }
      .tag.hot .tag-name {
        color: var(--ink);
      }

      /* ---------- schedule: columns are the grid's columns ---------- */
      .schedule {
        position: relative;
        margin-top: calc(var(--cell) * 0.25);
        animation: fade 1.2s 1s both;
      }
      .sched-title {
        display: inline-block;
        padding: 6px var(--pad);
        margin-left: 1px;
      }
      .row {
        display: grid;
        grid-template-columns: repeat(var(--cols), var(--cell));
        align-items: baseline;
        background: var(--bg);
        border-top: 1px solid var(--line);
        transition: background-color 0.3s;
      }
      .row:last-child {
        border-bottom: 1px solid var(--line);
      }
      .row > span {
        min-width: 0;
        padding: 16px var(--pad);
        line-height: 1.45;
        border-left: 1px solid var(--line);
      }
      .row.head > span {
        padding-top: 10px;
        padding-bottom: 10px;
        color: var(--faint);
      }
      .row:not(.head) {
        font-size: 15px;
        font-weight: 300;
        color: var(--soft);
      }
      .row .mono {
        font-size: 11px;
      }
      .c-no {
        grid-column: 1 / span 1;
      }
      .c-title {
        grid-column: 2 / span 3;
      }
      .c-artist {
        grid-column: 5 / span 3;
      }
      .c-medium {
        grid-column: 8 / span 3;
      }
      .c-size {
        grid-column: 11 / span 2;
        border-right: 1px solid var(--line);
      }
      .row:not(.head) .c-title {
        font-size: 18px;
        font-weight: 400;
        color: var(--ink);
        letter-spacing: -0.015em;
      }
      .row:not(.head).hot,
      .row:not(.head):focus-visible {
        outline: none;
        background: #0c0c0b;
      }
      .row.hot .c-no {
        color: var(--ink);
      }

      /* ---------- detail view: same grid, painting in front ---------- */
      .view {
        --p: 0;
        position: fixed;
        inset: 0;
        z-index: 4;
        overscroll-behavior: contain;
      }
      .view[hidden] {
        display: none;
      }
      .view:focus {
        outline: none;
      }
      .vsheet {
        position: absolute;
        top: var(--strip);
        bottom: 0;
        left: 50%;
        width: calc(var(--cell) * var(--cols));
        transform: translateX(-50%);
      }
      .detail {
        position: absolute;
        inset: 0;
        transform: translateY(calc(var(--p) * -32px));
        transition: transform 0.35s var(--ease);
      }
      .detail[hidden] {
        display: none;
      }
      .stage {
        position: absolute;
        top: 52px;
        right: 26px;
        bottom: 96px;
        left: calc(var(--cell) * 3);
        display: grid;
        align-items: start;
        justify-items: start;
        container-type: size;
        pointer-events: none;
      }
      .fig {
        position: relative;
        width: min(100cqw, 100cqh * var(--ar));
        aspect-ratio: var(--ar);
        pointer-events: auto;
        background-size: cover;
        transform-origin: 0 0;
      }
      .fig img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .fig .dim {
        color: #6d6b64;
        animation: none;
      }
      .fig .dim-w {
        bottom: -21px;
      }
      .fig .dim-h {
        right: -21px;
      }
      .info {
        position: absolute;
        top: 0;
        left: 1px;
        width: calc(var(--cell) * 3 - 1px);
        padding: 52px var(--pad) calc(var(--pad) * 1.5);
      }
      .info h2 {
        margin: 18px 0 10px;
        font-size: clamp(32px, calc(var(--cell) * 0.42), 54px);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.045em;
        text-wrap: balance;
      }
      .by {
        font-size: 17px;
        font-weight: 300;
        color: var(--soft);
      }
      .story {
        margin-top: 22px;
        font-size: 14.5px;
        font-weight: 300;
        line-height: 1.55;
        color: var(--soft);
        text-wrap: pretty;
      }
      .spec {
        margin-top: 26px;
        border-top: 1px solid var(--line);
      }
      .spec div {
        display: grid;
        grid-template-columns: 70px 1fr;
        gap: 12px;
        padding: 9px 0;
        border-bottom: 1px solid var(--line);
      }
      .spec dt {
        padding-top: 2px;
        color: var(--faint);
      }
      .spec dd {
        font-size: 13.5px;
        font-weight: 300;
        line-height: 1.45;
        color: var(--soft);
      }
      .orig {
        display: inline-flex;
        gap: 8px;
        padding-bottom: 4px;
        margin-top: 24px;
        font-size: 15px;
        color: var(--ink);
        border-bottom: 1px solid #5d5b55;
        transition: border-color 0.3s;
      }
      .orig:hover {
        border-color: var(--ink);
      }

      .vbar {
        position: absolute;
        right: 0;
        bottom: 26px;
        left: 0;
        display: grid;
        grid-template-columns: repeat(var(--cols), var(--cell));
        align-items: center;
        font-size: 14px;
        color: var(--dim);
      }
      .vbar > * {
        padding: 8px var(--pad);
        margin-left: 1px;
      }
      .vb-back {
        grid-column: 1 / span 2;
        justify-self: start;
        transition: color 0.2s;
      }
      .vb-back:hover {
        color: var(--ink);
      }
      .vb-ret {
        display: flex;
        flex-direction: column;
        grid-column: 6 / span 2;
        gap: 9px;
        align-items: center;
        justify-self: center;
        color: var(--faint);
        white-space: nowrap;
      }
      .ret-bar {
        display: block;
        width: 96px;
        height: 1px;
        overflow: hidden;
        background: #2a2927;
      }
      .ret-bar b {
        display: block;
        height: 100%;
        background: var(--ink);
        transform: scaleX(var(--p));
        transform-origin: left;
        transition: transform 0.25s;
      }
      .vb-nav {
        display: flex;
        grid-column: 11 / span 2;
        gap: 14px;
        align-items: center;
        justify-self: end;
        font-variant-numeric: tabular-nums;
      }
      .vb-nav button {
        transition: color 0.2s;
      }
      .vb-nav button:hover {
        color: var(--ink);
      }
      .on-touch {
        display: none;
      }
      @media (hover: none) {
        .on-wheel {
          display: none;
        }
        .on-touch {
          display: inline;
        }
      }

      /* fade the detail's lettering in after the painting lands */
      .info,
      .vbar,
      .fig .dim {
        opacity: 0;
        transition: opacity 0.2s;
      }
      .view.in .info,
      .view.in .vbar,
      .view.in .fig .dim {
        opacity: 1;
        transition: opacity 0.6s 0.35s;
      }

      .m-only {
        display: none;
      }

      /* ---------- small screens ---------- */
      @media (max-width: 760px) {
        :root {
          --gut: 16px;
          --cols: 4;
          --pad: 12px;
          --strip: 40px;
        }
        .d-only {
          display: none;
        }
        .m-only {
          display: block;
        }
        .at {
          --x: var(--mx);
          --y: var(--my);
          --w: var(--mw);
          --h: var(--mh);
        }
        .elev {
          height: calc(var(--mh-elev) * var(--cell));
        }
        .hero-main {
          grid-column: 1 / -1;
        }
        h1 {
          font-size: 64px;
        }
        .hero-meta {
          grid-column: 1 / -1;
          margin-top: 8px;
        }
        .level b {
          display: none;
        }
        .row > span {
          padding: 13px var(--pad);
        }
        .c-no {
          grid-column: 1 / span 1;
        }
        .c-title {
          grid-column: 2 / span 3;
          border-right: 1px solid var(--line);
        }
        .c-artist,
        .c-medium,
        .c-size {
          display: none;
        }
        .stage {
          top: 34px;
          right: 22px;
          bottom: auto;
          left: 0;
          height: min(
            46svh,
            calc((100cqw - 2 * var(--gut) - 22px) / var(--ar))
          );
        }
        .info {
          top: calc(
            34px +
            min(46svh, calc((100cqw - 2 * var(--gut) - 22px) / var(--ar))) +
            26px
          );
          width: calc(var(--cell) * 4 - 1px);
          padding-top: var(--pad);
        }
        .info h2 {
          margin: 10px 0 6px;
          font-size: 32px;
        }
        .story {
          margin-top: 14px;
        }
        .spec {
          margin-top: 16px;
        }
        .spec div {
          padding: 7px 0;
        }
        .orig {
          margin-top: 16px;
        }
        .vbar {
          bottom: 12px;
        }
        .vb-back {
          grid-column: 1 / span 2;
        }
        .vb-ret {
          display: none;
        }
        .vb-nav {
          grid-column: 3 / span 2;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>

    <script>
      import "@/scripts/wall";
    </script>
  </body>
</html>
