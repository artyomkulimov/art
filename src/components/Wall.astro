---
/**
 * The site: every painting on one engineering-style sheet. The sheet can be
 * dragged around and springs back home when left alone. Clicking a painting
 * lifts it into a detail view (/<id>/); scrolling down drops it back onto the
 * sheet. `open` renders a painting's detail view already open, for direct links.
 */
import { Picture } from "astro:assets";
import { asciiOf } from "@/lib/ascii";
import { getPaintings, imagePathOf } from "@/lib/paintings";
import { type Box, layout, plotOf, sizeOf } from "@/lib/sheet";

interface Props {
  open?: string;
}

const paintings = await getPaintings();
const openIndex = paintings.findIndex((p) => p.id === Astro.props.open);

const sizes = paintings.map(sizeOf);
// Drawn size in metres: real width, height from the image so nothing is cropped.
const metres = paintings.map((p, i) => ({
  w: sizes[i].w / 100,
  h: (sizes[i].w / 100) * (p.image.height / p.image.width),
}));

const DESK = layout(metres, {
  cols: 12,
  perMeter: 2.9,
  hero: { x: 1, y: 1, w: 4, h: 3.5 },
  margin: 0.5,
  foot: 1,
});
const MOB = layout(metres, {
  cols: 4,
  perMeter: 1.6,
  hero: { x: 0, y: 0.5, w: 4, h: 3.5 },
  margin: 0.5,
  foot: 2,
});

const pos = (d: Box, m: Box) =>
  `--dx:${d.x};--dy:${d.y};--dw:${d.w};--dh:${d.h};--mx:${m.x};--my:${m.y};--mw:${m.w};--mh:${m.h}`;
const pad = (n: number) => String(n).padStart(2, "0");
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
const dims = (i: number) =>
  `${sizes[i].approx ? "≈ " : ""}${fmt(sizes[i].h)} × ${fmt(sizes[i].w)} cm`;
const SIZE_IN_MEDIUM = /,?\s*\d[\d.]*\s*[×x]\s*\d[\d.]*\s*cm/;
const mediumOf = (m: string) => m.replace(SIZE_IN_MEDIUM, "");

const years = paintings
  .map((p) => Number.parseInt(p.year, 10))
  .filter(Number.isFinite);
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : "";
const total = pad(paintings.length);
const stamp = new Date().toISOString().slice(0, 7).replace("-", ".");

// Footer strip: one ASCII slice per painting, widths in proportion to the real widths.
const widthSum = sizes.reduce((a, s) => a + s.w, 0);
const strips = await Promise.all(
  paintings.map((p, i) =>
    asciiOf(
      imagePathOf(p.id),
      p.title,
      Math.ceil((230 * sizes[i].w) / widthSum)
    )
  )
);

const plots = [
  { i: -1, d: plotOf(DESK.hero), m: plotOf(MOB.hero) },
  ...paintings.map((_, i) => ({
    i,
    d: plotOf(DESK.boxes[i]),
    m: plotOf(MOB.boxes[i]),
  })),
];

const siteTitle = "Paintings — Artyom Kulimov";
const title =
  openIndex >= 0 ? `${paintings[openIndex].title} — ${siteTitle}` : siteTitle;
const description =
  openIndex >= 0
    ? `${paintings[openIndex].title} by ${paintings[openIndex].artist}, ${paintings[openIndex].year}.`
    : "A small, slowly growing collection of paintings Artyom Kulimov finds beautiful.";
---

<!doctype html>
<html lang="en" class:list={[{ "is-open": openIndex >= 0 }]}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@400;500&display=swap"
    >
  </head>
  <body>
    <main class="page">
      <div class="meta mono">
        <span>art.artyomkulimov.com</span>
        <span class="meta-mid">Sheet 01 — Paintings</span>
        <span id="hud" class="hud">x ——— y ——— cm</span>
      </div>

      <div
        class="sheet"
        id="sheet"
        style={`--drows:${DESK.rows};--mrows:${MOB.rows};--dpm:${DESK.perMeter};--mpm:${MOB.perMeter}`}
        data-dpm={DESK.perMeter}
        data-mpm={MOB.perMeter}
      >
        <svg
          class="arc"
          viewBox="0 0 1000 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M 215 0 A 456 456 0 0 0 785 0"
            vector-effect="non-scaling-stroke"
          ></path>
          <path
            class="glint"
            d="M 215 0 A 456 456 0 0 0 785 0"
            pathLength="1000"
            vector-effect="non-scaling-stroke"
          ></path>
        </svg>
        <div class="grid" aria-hidden="true"></div>
        <div class="ruler ruler-y" aria-hidden="true"><i></i></div>
        <div class="ruler ruler-x" aria-hidden="true"><i></i></div>

        {plots.map((pl) => (
            <div class="plot at" data-i={pl.i} style={pos(pl.d, pl.m)} aria-hidden="true">
              <i class="reg tl" />
              <i class="reg tr" />
              <i class="reg bl" />
              <i class="reg br" />
            </div>
          ))}

        <header class="hero at" style={pos(DESK.hero, MOB.hero)}>
          <p class="mono eyebrow">{total} works · {span}</p>
          <h1>Paintings</h1>
          <p class="lede">
            A small, slowly growing collection of paintings I find beautiful.
          </p>
          <a class="btn" href={`/${paintings[0].id}/`} data-open="0"
            >Begin with {paintings[0].title}</a
          >
          <p class="mono hint">
            <span class="fine">Drag the sheet around · click a painting</span>
          </p>
        </header>

        {paintings.map((p, i) => {
            const d = DESK.boxes[i];
            const m = MOB.boxes[i];
            return (
              <a
                class:list={["work at", { away: i === openIndex }]}
                href={`/${p.id}/`}
                data-i={i}
                data-id={p.id}
                style={`${pos(d, m)};--i:${i}`}
                draggable="false"
                aria-label={`${p.title}, ${p.artist}, ${p.year}`}
              >
                <span class="frame" style={`background-color:${p.palette[0]}`}>
                  <Picture
                    src={p.image}
                    formats={["avif", "webp"]}
                    widths={[320, 480, 640, 800, 1000, 1280, 1600]}
                    sizes={`(max-width: 760px) ${Math.ceil((m.w / 4) * 94)}vw, ${Math.ceil((d.w / 12) * 94)}vw`}
                    alt=""
                    loading={d.y < 6 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "auto"}
                    decoding="async"
                    draggable="false"
                  />
                </span>
                <span class="dim dim-w mono" aria-hidden="true">
                  <b>{fmt(sizes[i].w)}</b>
                </span>
                <span class="dim dim-h mono" aria-hidden="true">
                  <b>{fmt(sizes[i].h)}</b>
                </span>
                <span class="cap mono" aria-hidden="true">
                  <span class="fig-no">Fig. {pad(i + 1)}</span> {p.title}
                  <span class="cap-by">
                    {p.artist}, {p.year}
                  </span>
                </span>
              </a>
            );
          })}

        <footer class="foot at" style={pos(DESK.footer, MOB.footer)}>
          <div class="strip" aria-hidden="true">
            {strips.map((lines, i) => (
                <div class="seg" data-i={i} style={`flex-grow:${sizes[i].w}`}>
                  {lines.map((runs) => (
                    <span class="ln">
                      {runs.map((r) => (
                        <span class={`t${r.tone}`}>{r.text}</span>
                      ))}
                    </span>
                  ))}
                </div>
              ))}
          </div>
          <dl class="tb mono">
            <div>
              <dt>Works</dt>
              <dd>{total}</dd>
            </div>
            <div>
              <dt>Period</dt>
              <dd>{span}</dd>
            </div>
            <div class="tb-scale">
              <dt>Scale</dt>
              <dd><i class="bar"></i><span>50 cm</span></dd>
            </div>
            <div>
              <dt>Kept by</dt>
              <dd>A. Kulimov</dd>
            </div>
            <div>
              <dt>Rev.</dt>
              <dd>{stamp}</dd>
            </div>
          </dl>
        </footer>
      </div>
    </main>

    <div
      class:list={["view", { in: openIndex >= 0 }]}
      id="view"
      hidden={openIndex < 0}
      data-open={openIndex}
      data-site-title={siteTitle}
      role="dialog"
      aria-modal="true"
      aria-label="Painting"
    >
      <div class="vgrid" aria-hidden="true"></div>
      <div class="vbar vtop mono">
        <button type="button" class="vbtn" data-close>← The wall</button>
        <span class="vnav">
          <button
            type="button"
            class="vbtn"
            data-step="-1"
            aria-label="Previous painting"
          >
            ←
          </button>
          <span id="vnum">{pad(Math.max(0, openIndex) + 1)} / {total}</span>
          <button
            type="button"
            class="vbtn"
            data-step="1"
            aria-label="Next painting"
          >
            →
          </button>
        </span>
      </div>

      {paintings.map((p, i) => (
          <section
            class="detail"
            data-i={i}
            data-title={p.title}
            hidden={i !== openIndex}
            style={`--ar:${p.image.width / p.image.height}`}
            aria-label={p.title}
          >
            <div class="info">
              <p class="mono eyebrow">
                Fig. {pad(i + 1)} <span class="of">/ {total}</span>
              </p>
              <h2>{p.title}</h2>
              <p class="by">
                {p.artist}, {p.year}
              </p>
              <dl class="spec mono">
                <div>
                  <dt>Medium</dt>
                  <dd>{mediumOf(p.medium)}</dd>
                </div>
                <div>
                  <dt>Size</dt>
                  <dd>{dims(i)}</dd>
                </div>
                <div>
                  <dt>Held at</dt>
                  <dd>{p.location}</dd>
                </div>
                <div>
                  <dt>Rights</dt>
                  <dd>{p.rights}</dd>
                </div>
                <div>
                  <dt>Image</dt>
                  <dd>{p.source}</dd>
                </div>
              </dl>
              <a class="btn" href={p.original} target="_blank" rel="noopener">
                Full-resolution original ↗
              </a>
            </div>
            <div class="stage">
              <figure class="fig" style={`background-color:${p.palette[0]}`}>
                <Picture
                  src={p.image}
                  formats={["avif", "webp"]}
                  widths={[800, 1200, 1600, 2000, 2600, 3200]}
                  sizes="(max-width: 760px) 100vw, 66vw"
                  alt={`${p.title} by ${p.artist}, ${p.year}`}
                  loading={i === openIndex ? "eager" : "lazy"}
                  fetchpriority={i === openIndex ? "high" : "auto"}
                  decoding="async"
                  draggable="false"
                />
                <span class="dim dim-w mono" aria-hidden="true">
                  <b>{fmt(sizes[i].w)} cm</b>
                </span>
                <span class="dim dim-h mono" aria-hidden="true">
                  <b>{fmt(sizes[i].h)} cm</b>
                </span>
              </figure>
            </div>
          </section>
        ))}

      <div class="vbar vbottom mono">
        <span class="ret">
          <span class="ret-txt"
            ><span class="on-wheel">Scroll down</span
            ><span class="on-touch">Swipe up</span>
            to return to the wall</span
          >
          <i class="ret-bar"><b></b></i>
        </span>
      </div>
    </div>

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
      }
      :root {
        --bg: #000;
        --ink: #edeadf;
        --dim: #85827a;
        --faint: #4b4944;
        --row: #1b1b1a;
        --col: #2b2a28;
        --frame: #2b2a28;
        --plot: #2a2927;
        --gut: 48px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        color-scheme: dark;
      }
      html {
        scrollbar-gutter: stable;
        background: var(--bg);
      }
      html.is-open {
        overflow: hidden;
      }
      body {
        overflow-x: hidden;
        font-family: "Geist", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        color: var(--ink);
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button {
        all: unset;
        cursor: pointer;
      }
      .mono {
        font-family: "Geist Mono", ui-monospace, monospace;
        font-size: 10.5px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      img {
        display: block;
      }
      :focus-visible {
        outline: 1px solid var(--ink);
        outline-offset: 3px;
      }

      /* ---------- page + sheet ---------- */
      .page {
        --cols: 12;
        --cell: calc(min(100cqw - 2 * var(--gut), 1600px) / var(--cols));
        --foot: 1;
        padding: 0 0 var(--gut);
        container-type: inline-size;
      }
      .meta {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: start;
        width: min(100cqw - 2 * var(--gut), 1600px);
        height: calc(var(--cell) * 1.1);
        padding-top: 22px;
        margin: 0 auto;
        color: var(--dim);
      }
      .meta-mid {
        color: var(--faint);
      }
      .hud {
        justify-self: end;
        font-variant-numeric: tabular-nums;
        color: var(--faint);
        transition: color 0.4s;
      }
      .hud.live {
        color: var(--dim);
      }

      .sheet {
        --rows: var(--drows);
        --pm: var(--dpm);
        position: relative;
        width: calc(var(--cell) * var(--cols));
        height: calc(var(--cell) * var(--rows));
        margin: 0 auto;
        touch-action: pan-y;
        cursor: grab;
        -webkit-user-select: none;
        user-select: none;
        outline: 1px solid var(--frame);
      }
      html.dragging,
      html.dragging * {
        cursor: grabbing !important;
      }

      .arc {
        position: absolute;
        bottom: 100%;
        left: 0;
        width: 100%;
        height: calc(var(--cell) * 0.82);
        overflow: visible;
        pointer-events: none;
        fill: none;
      }
      .arc path {
        stroke: #2c2b29;
        stroke-width: 1;
      }
      .arc .glint {
        stroke: var(--ink);
        stroke-opacity: 0.55;
        stroke-dasharray: 70 930;
        animation: glint 22s linear infinite;
      }
      @keyframes glint {
        from {
          stroke-dashoffset: 1000;
        }
        to {
          stroke-dashoffset: 0;
        }
      }

      .grid {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .grid::before,
      .grid::after {
        position: absolute;
        inset: 0;
        content: "";
      }
      /* columns: dashed */
      .grid::before {
        background:
          linear-gradient(90deg, var(--col) 1px, transparent 1px) 0 0 /
          var(--cell) 100%;
        mask: repeating-linear-gradient(#000 0 4px, transparent 4px 9px);
        animation: draw-down 1.8s cubic-bezier(0.65, 0, 0.2, 1) both;
      }
      /* rows: solid */
      .grid::after {
        background:
          linear-gradient(var(--row) 1px, transparent 1px) 0 0 / 100%
          var(--cell);
        animation: draw-across 1.8s 0.15s cubic-bezier(0.65, 0, 0.2, 1) both;
      }
      @keyframes draw-down {
        from {
          clip-path: inset(0 0 100% 0);
        }
      }
      @keyframes draw-across {
        from {
          clip-path: inset(0 100% 0 0);
        }
      }
      @keyframes fade {
        from {
          opacity: 0;
        }
      }
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
      }
      @keyframes reveal {
        from {
          clip-path: inset(0 0 100% 0);
        }
      }

      .ruler {
        position: absolute;
        pointer-events: none;
      }
      .ruler-y {
        top: 0;
        bottom: calc(var(--cell) * var(--foot));
        left: 0;
        width: 22px;
        background:
          linear-gradient(#3a3936 1px, transparent 1px) 0 0 / 7px
          calc(var(--cell) / 8) repeat-y,
          linear-gradient(#45443f 1px, transparent 1px) 0 0 / 13px
          calc(var(--cell) / 2) repeat-y,
          linear-gradient(#5a5852 1px, transparent 1px) 0 0 / 22px var(--cell)
          repeat-y;
        animation: fade 1.2s 0.6s both;
      }
      .ruler-x {
        top: 0;
        right: 0;
        left: 0;
        height: 7px;
        background:
          linear-gradient(90deg, #3a3936 1px, transparent 1px) 0 0 /
          calc(var(--cell) / 4) 5px repeat-x;
        animation: fade 1.2s 0.6s both;
      }
      .ruler i {
        position: absolute;
        background: var(--ink);
        opacity: 0;
        transition: opacity 0.4s;
      }
      .ruler-y i {
        top: var(--cy, 0);
        left: 0;
        width: 26px;
        height: 1px;
      }
      .ruler-x i {
        top: 0;
        left: var(--cx, 0);
        width: 1px;
        height: 12px;
      }
      .sheet.aim .ruler i {
        opacity: 0.7;
      }

      /* every positioned thing lives in grid cells */
      .at {
        --x: var(--dx);
        --y: var(--dy);
        --w: var(--dw);
        --h: var(--dh);
        position: absolute;
        top: calc(var(--y) * var(--cell));
        left: calc(var(--x) * var(--cell));
        width: calc(var(--w) * var(--cell));
        height: calc(var(--h) * var(--cell));
      }

      .plot {
        margin: 0 -1px -1px 0;
        pointer-events: none;
        border: 1px solid var(--plot);
        transition: border-color 0.6s;
        animation: fade 1.4s 0.9s both;
      }
      .plot.hot {
        border-color: #3e3d39;
      }
      .reg {
        position: absolute;
        width: 7px;
        height: 7px;
        background: var(--bg);
        border: 1px solid #3d3c38;
        transition:
          border-color 0.5s,
          background-color 0.5s;
      }
      .reg.tl {
        top: -4px;
        left: -4px;
      }
      .reg.tr {
        top: -4px;
        right: -4px;
      }
      .reg.bl {
        bottom: -4px;
        left: -4px;
      }
      .reg.br {
        right: -4px;
        bottom: -4px;
      }
      .plot.hot .reg {
        border-color: var(--ink);
      }

      /* ---------- hero ---------- */
      .hero {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: calc(var(--cell) * 0.4) calc(var(--cell) * 0.36);
        animation: rise 1.2s 0.5s var(--ease) both;
      }
      .eyebrow {
        color: var(--dim);
      }
      h1 {
        margin: 0.32em 0 0.34em -0.04em;
        font-size: clamp(44px, calc(var(--cell) * 0.86), 128px);
        font-weight: 400;
        line-height: 0.95;
        letter-spacing: -0.045em;
      }
      .lede {
        max-width: 25em;
        font-size: clamp(15px, calc(var(--cell) * 0.165), 20px);
        font-weight: 300;
        line-height: 1.5;
        color: #c9c6bb;
      }
      .btn {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        padding: 11px 16px 12px;
        margin-top: 26px;
        font-size: 15px;
        color: #0b0b0a;
        letter-spacing: -0.01em;
        white-space: nowrap;
        background: var(--ink);
        border-radius: 3px;
        transition: background-color 0.3s;
      }
      .btn:hover {
        background: #fff;
      }
      .hint {
        margin-top: auto;
        color: var(--faint);
      }

      /* ---------- works ---------- */
      .work {
        display: block;
        cursor: inherit;
        -webkit-user-drag: none;
      }
      .frame {
        position: absolute;
        inset: 0;
        overflow: hidden;
        animation: reveal 1.3s calc(0.55s + var(--i) * 0.14s)
          cubic-bezier(0.7, 0, 0.2, 1) both;
      }
      .frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.9);
        transition:
          filter 0.8s,
          opacity 0.2s;
        -webkit-user-drag: none;
      }
      .work:hover .frame img,
      .work:focus-visible .frame img {
        filter: none;
      }
      .work.away .frame img {
        opacity: 0;
      }
      .work:focus-visible {
        outline: none;
      }
      .work:focus-visible .frame {
        outline: 1px solid var(--ink);
        outline-offset: 4px;
      }

      .dim {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 9.5px;
        color: var(--faint);
        letter-spacing: 0.04em;
        pointer-events: none;
        border-color: #3a3936;
        transition:
          color 0.6s,
          border-color 0.6s;
        animation: fade 1s calc(1.3s + var(--i, 0) * 0.14s) both;
      }
      .dim::before {
        position: absolute;
        content: "";
        background: currentColor;
        opacity: 0.55;
      }
      .dim b {
        position: relative;
        padding: 0 6px;
        font-weight: 400;
        line-height: 1;
        background: var(--bg);
      }
      .dim-w {
        top: -17px;
        right: 0;
        left: 0;
        height: 9px;
        border-right: 1px solid;
        border-left: 1px solid;
      }
      .dim-w::before {
        top: 4px;
        right: 0;
        left: 0;
        height: 1px;
      }
      .dim-h {
        top: 0;
        right: -17px;
        bottom: 0;
        width: 9px;
        border-top: 1px solid;
        border-bottom: 1px solid;
      }
      .dim-h::before {
        top: 0;
        bottom: 0;
        left: 4px;
        width: 1px;
      }
      .dim-h b {
        padding: 6px 0;
        writing-mode: vertical-rl;
      }
      .work:hover .dim,
      .work.hot .dim {
        color: #bdb9ad;
        border-color: #77746c;
      }

      .cap {
        position: absolute;
        top: calc(100% + 11px);
        left: 0;
        font-size: 10px;
        line-height: 1.55;
        color: var(--dim);
        white-space: nowrap;
        transition: color 0.5s;
        animation: fade 1s calc(1.4s + var(--i) * 0.14s) both;
      }
      .fig-no {
        margin-right: 6px;
        color: var(--faint);
        transition: color 0.5s;
      }
      .cap-by {
        display: block;
        color: var(--faint);
      }
      .work:hover .cap,
      .work:hover .fig-no {
        color: var(--ink);
      }

      /* ---------- footer: ascii strip + title block ---------- */
      .foot {
        display: grid;
        grid-template-columns: 9fr 3fr;
        background: #080807;
        border-top: 1px solid var(--frame);
        animation: fade 1.4s 1s both;
      }
      .strip {
        display: flex;
        min-width: 0;
        padding: calc(var(--cell) * 0.1) 0 0;
        overflow: hidden;
      }
      .seg {
        flex: 1 1 0;
        min-width: 0;
        padding-left: 14px;
        overflow: hidden;
        font:
          400 10px / 1.32 "Geist Mono",
          ui-monospace,
          monospace;
        color: #34332f;
        border-left: 1px dashed #1e1e1c;
      }
      .seg:first-child {
        border-left: 0;
      }
      .ln {
        display: block;
        white-space: pre;
      }
      .seg .t1 {
        color: #57554f;
        transition: color 0.6s;
      }
      .seg .t2 {
        color: #a8a497;
        transition: color 0.6s;
      }
      .seg.hot .t1 {
        color: #86837a;
      }
      .seg.hot .t2 {
        color: #fffdf4;
      }

      .tb {
        display: grid;
        grid-template-rows: repeat(3, 1fr);
        grid-template-columns: 1fr 1fr;
        font-size: 9.5px;
        border-left: 1px solid var(--frame);
      }
      .tb div {
        display: flex;
        gap: 10px;
        align-items: center;
        min-width: 0;
        padding: 0 12px;
        border-bottom: 1px solid var(--row);
      }
      .tb div:nth-child(odd):not(.tb-scale) {
        border-right: 1px solid var(--row);
      }
      .tb div:nth-last-child(-n + 2) {
        border-bottom: 0;
      }
      .tb dt {
        color: var(--faint);
      }
      .tb dd {
        display: flex;
        gap: 8px;
        align-items: center;
        color: #bdb9ad;
        white-space: nowrap;
      }
      .tb-scale {
        grid-column: 1 / -1;
      }
      .bar {
        display: block;
        width: calc(var(--cell) * var(--pm) * 0.5);
        height: 5px;
        background:
          linear-gradient(90deg, #77746c 50%, transparent 50%) 0 0 / 50% 100%;
        border: 1px solid #77746c;
      }

      /* ---------- detail view ---------- */
      .view {
        --vcell: calc((100vw - 2 * var(--gut)) / 12);
        --p: 0;
        position: fixed;
        inset: 0;
        z-index: 10;
        overscroll-behavior: contain;
        background: rgb(0 0 0 / 0);
        transition: background-color 0.5s var(--ease);
      }
      .view[hidden] {
        display: none;
      }
      .view.in {
        background: rgb(0 0 0 / 1);
      }
      .vgrid {
        position: absolute;
        inset: 0 var(--gut);
        pointer-events: none;
        background:
          linear-gradient(90deg, #121211 1px, transparent 1px) 0 0 /
          var(--vcell) 100%,
          linear-gradient(#0f0f0e 1px, transparent 1px) 0 0 / 100% var(--vcell);
        border-right: 1px solid #121211;
        border-left: 1px solid #121211;
      }
      .vgrid,
      .vbar,
      .detail .info,
      .detail .dim {
        opacity: 0;
        transition: opacity 0.2s;
      }
      .view.in .vgrid,
      .view.in .vbar,
      .view.in .detail .info,
      .view.in .detail .dim {
        opacity: 1;
        transition: opacity 0.6s 0.3s;
      }
      .detail .dim {
        animation: none;
      }
      .vbar {
        position: absolute;
        right: var(--gut);
        left: var(--gut);
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--dim);
      }
      .vtop {
        top: 0;
        height: 64px;
      }
      .vbottom {
        bottom: 0;
        justify-content: center;
        height: 72px;
      }
      .vbtn {
        padding: 6px 4px;
        color: var(--dim);
        transition: color 0.2s;
      }
      .vbtn:hover {
        color: var(--ink);
      }
      .vnav {
        display: flex;
        gap: 14px;
        align-items: center;
        font-variant-numeric: tabular-nums;
      }
      .ret {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
        color: var(--faint);
      }
      .ret-bar {
        display: block;
        width: 120px;
        height: 1px;
        overflow: hidden;
        background: #2a2927;
      }
      .ret-bar b {
        display: block;
        height: 100%;
        background: var(--ink);
        transform: scaleX(var(--p));
        transform-origin: left;
        transition: transform 0.25s;
      }
      .on-touch {
        display: none;
      }
      @media (hover: none) {
        .on-wheel {
          display: none;
        }
        .on-touch {
          display: inline;
        }
      }

      .detail {
        position: absolute;
        inset: 0;
        transform: translateY(calc(var(--p) * -36px));
        transition: transform 0.35s var(--ease);
      }
      .detail[hidden] {
        display: none;
      }
      .detail .info {
        position: absolute;
        top: 120px;
        left: var(--gut);
        width: calc(var(--vcell) * 3.4);
        padding-left: calc(var(--vcell) * 0.3);
      }
      .info h2 {
        margin: 18px 0 12px;
        font-size: clamp(34px, 3.4vw, 56px);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.035em;
        text-wrap: balance;
      }
      .by {
        font-size: 17px;
        font-weight: 300;
        color: #c9c6bb;
      }
      .spec {
        margin-top: 36px;
        font-size: 10px;
        border-top: 1px solid #1d1d1b;
      }
      .spec div {
        display: grid;
        grid-template-columns: 76px 1fr;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #1d1d1b;
      }
      .spec dt {
        color: var(--faint);
      }
      .spec dd {
        line-height: 1.5;
        color: #bdb9ad;
        text-transform: none;
        letter-spacing: 0.02em;
      }
      .info .btn {
        margin-top: 28px;
        font-size: 14px;
      }

      .stage {
        position: absolute;
        top: 96px;
        right: calc(var(--gut) + 30px);
        bottom: 110px;
        left: calc(var(--gut) + var(--vcell) * 4);
        display: grid;
        place-items: center;
        container-type: size;
        pointer-events: none;
      }
      .fig {
        position: relative;
        width: min(100cqw, 100cqh * var(--ar));
        aspect-ratio: var(--ar);
        pointer-events: auto;
        background-size: cover;
        transform-origin: 0 0;
      }
      .fig img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .fig .dim-w {
        top: -22px;
      }
      .fig .dim-h {
        right: -22px;
      }
      .fig .dim b {
        color: #8b887f;
      }

      /* ---------- small screens ---------- */
      @media (max-width: 760px) {
        :root {
          --gut: 16px;
        }
        .page {
          --cols: 4;
          --foot: 2;
        }
        .sheet {
          --rows: var(--mrows);
          --pm: var(--mpm);
        }
        .at {
          --x: var(--mx);
          --y: var(--my);
          --w: var(--mw);
          --h: var(--mh);
        }
        .meta {
          grid-template-columns: 1fr auto;
          height: 64px;
        }
        .meta-mid {
          display: none;
        }
        .foot {
          grid-template-rows: 1fr 1fr;
          grid-template-columns: 1fr;
        }
        .tb {
          border-top: 1px solid var(--frame);
          border-left: 0;
        }
        .seg {
          padding-left: 8px;
          font-size: 8.5px;
        }
        .hint {
          display: none;
        }
        .hero {
          padding: 28px 20px;
        }
        h1 {
          font-size: 58px;
        }
        .view {
          --vcell: calc((100vw - 32px) / 4);
        }
        .stage {
          top: 76px;
          right: calc(var(--gut) + 22px);
          bottom: auto;
          left: var(--gut);
          height: min(52svh, calc((100vw - 54px) / var(--ar)));
        }
        .detail .info {
          top: calc(76px + min(52svh, calc((100vw - 54px) / var(--ar))) + 30px);
          right: var(--gut);
          left: var(--gut);
          width: auto;
          padding: 0;
        }
        .info h2 {
          margin: 10px 0 6px;
          font-size: 32px;
        }
        .by {
          font-size: 15px;
        }
        .spec {
          margin-top: 18px;
        }
        .spec div {
          grid-template-columns: 64px 1fr;
          padding: 7px 0;
        }
        .info .btn {
          margin-top: 18px;
        }
        .vtop {
          height: 56px;
        }
        .vbottom {
          height: 56px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>

    <script>
      import "@/scripts/wall";
    </script>
  </body>
</html>
