---
/**
 * Bare HTML shell for an idea page. Each idea brings its own styles and
 * scripts; this only sets up the document, fonts preconnect and title.
 */
type Props = { title: string; background?: string };
const { title, background = "#000" } = Astro.props;
---
<!doctype html>
<html lang="en" style={`background:${background}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — art.artyomkulimov.com</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
