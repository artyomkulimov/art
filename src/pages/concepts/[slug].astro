---
import {getImage} from 'astro:assets';
import {paintings} from '../../data/paintings';
import {concepts} from '../../data/concepts';
import '../../styles/concepts.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/cormorant-garamond/400.css';
export function getStaticPaths(){return concepts.map(concept=>({params:{slug:concept.slug},props:{concept}}));}
const {concept}=Astro.props;
const actionLabels:Record<string,string>={reveal:'Reveal',aperture:'Open',spotlight:'Illuminate',horizon:'Unfold',contact:'Overview',shutters:'Reset panels'};
const works=await Promise.all(paintings.map(async p=>({...p,src:(await getImage({src:p.image,width:2400,format:'webp',quality:88})).src})));
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{concept.title} — Art studies</title><meta name="description" content={concept.description}/><meta name="robots" content="noindex"/></head>
<body data-mode={concept.slug}>
 <header><a href="/">← Studies</a><span>{concept.number} / {concept.title}</span><button id="info" aria-haspopup="dialog">About the work ↗</button></header>
 <main id="stage" aria-label={concept.title}>
  <div class="pictures">{works.map((p,i)=><img class:list={['painting',{active:i===0}]} src={p.src} alt={`${p.title}, ${p.artist}, ${p.year}`} data-index={i} fetchpriority={i===0?'high':'auto'}/>)}</div>
  <div class="shade"></div><div id="lens" aria-hidden="true" style={`background-image:url('${works[0].src}')`}></div>
  <div class="seam" aria-hidden="true"><span>↔</span></div>
  <div class="large-type" aria-hidden="true">{concept.slug==='horizon'?'Stay a little longer.':concept.slug==='reveal'?'Everything begins\nwith a detail.':concept.slug==='aperture'?'A world, waiting.':''}</div>
  <div class="selection">{works.map((p,i)=><button data-select={i}><small>0{i+1} / {p.year}</small><span>{p.title}</span><em>{p.artist}</em></button>)}</div>
  <div class="caption"><span class="eyebrow">A personal collection / <span id="count">01 — 03</span></span><h1 id="title">{works[0].title}</h1><p id="byline">{works[0].artist} <span>·</span> {works[0].year}</p></div>
 </main>
 <footer><p id="hint">{concept.hint}</p><div class="controls"><button id="prev" aria-label="Previous painting">←</button><button id="action">{actionLabels[concept.slug]||'Next painting'}</button><button id="next" aria-label="Next painting">→</button></div><label class="distance">{concept.slug==='diptych'?'Balance':'Distance'}<input id="distance" aria-label={concept.slug==='diptych'?'Painting balance':'Zoom distance'} type="range" min="0" max="100" value={concept.slug==='diptych'?50:0}/></label></footer>
 <dialog id="details"><button id="close" aria-label="Close details">✕</button><span class="eyebrow">The work / <span id="detail-year"></span></span><h2 id="detail-title"></h2><p id="detail-artist"></p><p id="detail-note"></p><dl><dt>Source</dt><dd id="detail-source"></dd><dt>Rights</dt><dd><a id="detail-rights" target="_blank" rel="noreferrer"></a></dd></dl><p class="credit-note">Images resized for this study. Immersive views may crop the composition; the original shows it in full.</p><a id="original" target="_blank" rel="noreferrer">View original on Wikimedia Commons ↗</a></dialog>
 <script id="works" type="application/json" set:html={JSON.stringify(works.map(({image,...p})=>p))}/>
 <script>import '../../scripts/concepts';</script>
</body></html>
