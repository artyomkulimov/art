---
/**
 * dissolve — one painting at a time, edge to edge. To move on, the current
 * painting is washed away in brush strokes and the next one is revealed
 * underneath, its wet edge dragging the old pigment along before it dries.
 * Hand-written WebGL (see src/ideas/dissolve/gl.ts); a plain crossfade of the
 * same <picture>s if WebGL is unavailable.
 */
import { Picture } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();
const pad = (n: number) => String(n).padStart(2, "0");
---
<Idea title="Dissolve" background="#0d0b09">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,400;1,500&family=Spline+Sans+Mono:wght@300;400&display=swap" rel="stylesheet" />
  <script slot="head" is:inline>document.documentElement.classList.add("js");</script>

  <main class="stage" data-stage aria-roledescription="carousel" aria-label="Paintings">
    <div class="plates">
      {paintings.map((p, i) => (
        <Picture
          class={`plate${i === 0 ? " on" : ""}`}
          src={p.image}
          widths={[1280, 1920, 2560, 3200]}
          sizes="100vw"
          formats={["avif", "webp"]}
          alt={`${p.title} by ${p.artist} (${p.year})`}
          loading="eager"
          fetchpriority={i === 0 ? "high" : "low"}
          decoding="async"
          data-plate={i}
        />
      ))}
    </div>
    <canvas class="gl" data-gl aria-hidden="true"></canvas>
    <div class="scrim" aria-hidden="true"></div>

    <p class="mark">Artyom Kulimov <i>— a collection</i></p>

    <div class="captions" aria-live="polite">
      {paintings.map((p, i) => (
        <section class="caption" data-caption={i} aria-hidden={i === 0 ? "false" : "true"}>
          <h2 class="title"><span>{p.title}</span></h2>
          <p class="by"><span>{p.artist}, {p.year}</span></p>
          <p class="fine">
            <span>{p.medium} · {p.location}</span>
            <span>{p.rights} · {p.source} · <a href={p.original} target="_blank" rel="noopener" tabindex={i === 0 ? 0 : -1}>original&nbsp;↗</a></span>
          </p>
        </section>
      ))}
    </div>

    <nav class="ctl" aria-label="Painting">
      <button type="button" data-prev aria-label="Previous painting">←</button>
      <span class="count"><b data-count>{pad(1)}</b> / {pad(paintings.length)}</span>
      <button type="button" data-next aria-label="Next painting">→</button>
    </nav>
  </main>
</Idea>

<style is:global>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #0d0b09; }
  body { color: #f1ebe0; font-family: "Spline Sans Mono", ui-monospace, monospace; font-weight: 300; -webkit-font-smoothing: antialiased; }
</style>

<style>
  .stage { position: fixed; inset: 0; overflow: hidden; cursor: pointer; }
  .plates :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Without JS the first painting simply shows; with JS the canvas (or the
     crossfade fallback) decides what is visible. */
  :global(html:not(.js)) .plates :global(img.on),
  .stage.fallback .plates :global(img.on) { opacity: 1; }

  .gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; }
  .stage.gl-on .gl { opacity: 1; }

  .scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(70% 55% at 0% 100%, rgba(8, 6, 4, 0.62), transparent 70%),
      linear-gradient(0deg, rgba(8, 6, 4, 0.38), transparent 32%);
  }

  .mark {
    position: absolute;
    left: 44px;
    top: 34px;
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-weight: 500;
    font-size: 17px;
    letter-spacing: 0.01em;
    color: #f1ebe0;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .mark i { font-weight: 400; color: #d8cfbf; }

  /* ---------- caption: the title in the corner ---------- */
  .captions { position: absolute; left: 44px; bottom: 38px; width: min(640px, 70vw); height: 160px; pointer-events: none; }
  .caption { position: absolute; left: 0; bottom: 0; text-shadow: 0 1px 18px rgba(0, 0, 0, 0.5); }
  .caption > * { margin: 0; overflow: hidden; }
  .caption > * > span, .fine span { display: block; }
  .title {
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(40px, 4.4vw, 66px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: #f6f0e4;
    padding-bottom: 0.08em;
  }
  .by {
    margin-top: 4px !important;
    font-family: "Cormorant Garamond", serif;
    font-size: 21px;
    color: #e4dbca;
  }
  .fine {
    margin-top: 16px !important;
    font-size: 10.5px;
    line-height: 1.75;
    letter-spacing: 0.06em;
    color: #c9bfae;
  }
  .fine a { color: #f1ebe0; text-decoration: none; border-bottom: 1px solid rgba(241, 235, 224, 0.4); pointer-events: auto; }
  .fine a:hover, .fine a:focus-visible { border-color: #f1ebe0; outline: none; }

  /* Lines rise out of their own masks, title first; leave the way they came. */
  .caption > * > span, .fine span {
    transform: translateY(105%);
    opacity: 0;
    transition: transform 0.7s cubic-bezier(0.6, 0, 0.8, 0.4), opacity 0.5s ease;
  }
  .caption.on > * > span, .caption.on .fine span {
    transform: none;
    opacity: 1;
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 1s ease;
  }
  :global(html:not(.js)) .caption:first-child span { transform: none; opacity: 1; }
  .caption.on .title span { transition-delay: var(--in, 1.1s); }
  .caption.on .by span { transition-delay: calc(var(--in, 1.1s) + 0.14s); }
  .caption.on .fine span:first-child { transition-delay: calc(var(--in, 1.1s) + 0.3s); }
  .caption.on .fine span:last-child { transition-delay: calc(var(--in, 1.1s) + 0.38s); }

  /* ---------- controls ---------- */
  .ctl {
    position: absolute;
    right: 40px;
    bottom: 38px;
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: #d9cfbe;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }
  .ctl button {
    all: unset;
    cursor: pointer;
    font-family: "Cormorant Garamond", serif;
    font-size: 22px;
    line-height: 1;
    padding: 6px 4px;
    color: #efe8dc;
    opacity: 0.7;
    transition: opacity 0.3s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ctl button:hover, .ctl button:focus-visible { opacity: 1; }
  .ctl [data-prev]:hover { transform: translateX(-3px); }
  .ctl [data-next]:hover { transform: translateX(3px); }
  .ctl button:focus-visible { outline: 1px solid rgba(241, 235, 224, 0.6); outline-offset: 4px; }
  .count { font-variant-numeric: tabular-nums; }
  .count b { font-weight: 400; color: #f6f0e4; }

  @media (max-width: 700px) {
    .mark { left: 22px; top: 22px; }
    .captions { left: 22px; bottom: 84px; width: calc(100vw - 44px); }
    .ctl { right: 22px; bottom: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caption > * > span, .fine span, .caption.on > * > span, .caption.on .fine span { transition: opacity 0.3s !important; transform: none !important; }
    .plates :global(img) { transition-duration: 0.3s; }
  }
</style>

<script>
  import { createDissolve, GROUND, type Dissolve } from "@/ideas/dissolve/gl";

  const stage = document.querySelector<HTMLElement>("[data-stage]")!;
  const canvas = stage.querySelector<HTMLCanvasElement>("[data-gl]")!;
  const plates = [...stage.querySelectorAll<HTMLImageElement>("img[data-plate]")];
  const captions = [...stage.querySelectorAll<HTMLElement>("[data-caption]")];
  const countEl = stage.querySelector<HTMLElement>("[data-count]")!;
  const n = plates.length;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const ready = plates.map((img) =>
    (img.complete && img.naturalWidth
      ? Promise.resolve()
      : new Promise<void>((res) => {
          img.addEventListener("load", () => res(), { once: true });
          img.addEventListener("error", () => res(), { once: true });
        })
    ).then(() => img.decode().catch(() => {})),
  );

  let fx: Dissolve | null = null;
  try {
    fx = createDissolve(canvas, [13, 11, 9]);
  } catch {
    fx = null;
  }
  if (!fx) stage.classList.add("fallback");

  const dpr = Math.min(2, devicePixelRatio || 1);
  const size = () => fx?.resize(Math.round(innerWidth * dpr), Math.round(innerHeight * dpr));
  size();

  // ------------------------------------------------------------------ state
  let cur = 0;
  let busy = false;
  let queued: number | null = null;
  let rest = { a: GROUND, seed: 0, angle: 0 };
  const PAINT_MS = reduced ? 450 : 2900;

  const easeInOut = (t: number) => 0.5 - 0.5 * Math.cos(Math.PI * t);
  const easeOut = (t: number) => 1 - (1 - t) ** 3;

  const drawRest = () => {
    if (!fx || fx.lost()) return;
    fx.draw({ a: rest.a, b: rest.a, p: 0, zoomA: 1, zoomB: 1, seed: rest.seed, angle: rest.angle, crossfade: true });
  };

  const upload = async (i: number) => {
    await ready[i];
    if (fx && !fx.has(i) && plates[i].naturalWidth) fx.setTexture(i, plates[i]);
  };

  const showCaption = (i: number, delay: number) => {
    captions.forEach((c, k) => {
      const on = k === i;
      c.style.setProperty("--in", `${delay}s`);
      c.classList.toggle("on", on);
      c.setAttribute("aria-hidden", on ? "false" : "true");
      c.querySelector("a")?.setAttribute("tabindex", on ? "0" : "-1");
    });
    countEl.textContent = String(i + 1).padStart(2, "0");
  };

  /** Wash from painting `from` (or the dark ground) to painting `to`. */
  const wash = async (from: number, to: number, dir: 1 | -1) => {
    await upload(to);
    if (!fx || fx.lost()) {
      stage.classList.remove("gl-on");
      stage.classList.add("fallback");
      plates.forEach((p, k) => p.classList.toggle("on", k === to));
      await new Promise((r) => setTimeout(r, reduced ? 300 : 1400));
      return;
    }
    stage.classList.add("gl-on");
    // Forward washes run down and to the right, like water down a tilted
    // board; going back runs up and to the left. A fresh seed every time.
    const base = dir > 0 ? -0.62 : Math.PI - 0.62;
    const angle = base + (Math.random() - 0.5) * 0.55;
    const seed = Math.random() * 97;
    const t0 = performance.now();
    await new Promise<void>((done) => {
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / PAINT_MS);
        fx!.draw({
          a: from,
          b: to,
          p: easeInOut(t),
          zoomA: 1 + 0.018 * easeInOut(t),
          zoomB: 1.045 - 0.045 * easeOut(t),
          seed,
          angle,
          crossfade: reduced,
        });
        if (t < 1) requestAnimationFrame(step);
        else done();
      };
      requestAnimationFrame(step);
    });
    rest = { a: to, seed, angle };
    drawRest();
  };

  const go = async (to: number, dir: 1 | -1) => {
    to = (to + n) % n;
    if (busy) {
      queued = to;
      return;
    }
    if (to === cur) return;
    busy = true;
    const from = cur;
    cur = to;
    showCaption(to, reduced ? 0.1 : 1.15);
    await wash(from, to, dir);
    busy = false;
    if (queued !== null) {
      const q = queued;
      queued = null;
      if (q !== cur) go(q, q > cur || (cur === n - 1 && q === 0) ? 1 : -1);
    }
  };

  // ------------------------------------------------------------------ start
  // The first painting washes in over the dark ground.
  Promise.all([document.fonts.ready, ready[0]]).then(async () => {
    busy = true;
    showCaption(0, reduced ? 0.1 : 1.3);
    await wash(GROUND, 0, 1);
    busy = false;
    // warm the rest in order
    for (let i = 1; i < n; i++) await upload(i);
    if (queued !== null) {
      const q = queued;
      queued = null;
      go(q, 1);
    }
  });

  addEventListener("resize", () => { size(); drawRest(); });

  // ------------------------------------------------------------------ input
  const next = () => go(cur + 1, 1);
  const prev = () => go(cur - 1, -1);
  stage.querySelector("[data-next]")!.addEventListener("click", (e) => { e.stopPropagation(); next(); });
  stage.querySelector("[data-prev]")!.addEventListener("click", (e) => { e.stopPropagation(); prev(); });
  stage.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a, button")) return;
    next();
  });
  addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (["ArrowRight", "ArrowDown", "PageDown", " "].includes(e.key)) { e.preventDefault(); next(); }
    else if (["ArrowLeft", "ArrowUp", "PageUp"].includes(e.key)) { e.preventDefault(); prev(); }
  });
  let acc = 0;
  let lockUntil = 0;
  addEventListener("wheel", (e) => {
    const now = performance.now();
    if (now < lockUntil || busy) { acc = 0; return; }
    acc += Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
    if (Math.abs(acc) > 60) {
      if (acc > 0) next(); else prev();
      acc = 0;
      lockUntil = now + 900;
    }
  }, { passive: true });
</script>
