---
import Idea from "@/layouts/Idea.astro";
import { getWorks } from "@/ideas/zoom-reveal/works";

const works = await getWorks();
const roman = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];
---
<Idea title="Zoom reveal" background="#000">
  <link slot="head" rel="preload" as="image" href={works[0].full} fetchpriority="high" />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
  />

  <main class="zr" aria-roledescription="carousel" aria-label="Paintings, each revealed from a detail">
    <div class="stage">
      {
        works.map((w, i) => (
          <figure class="layer" data-i={i} style={`width:${w.w}px;height:${w.h}px`} aria-hidden={i === 0 ? "false" : "true"}>
            <img class="tiny" src={w.tiny} alt="" width={w.w} height={w.h} />
            <img
              class="full"
              src={i === 0 ? w.full : undefined}
              data-src={w.full}
              alt={`${w.title}, ${w.artist}, ${w.year}`}
              width={w.w}
              height={w.h}
              decoding="async"
              fetchpriority={i === 0 ? "high" : "low"}
            />
          </figure>
        ))
      }
    </div>
    <div class="shade" aria-hidden="true"></div>

    <header class="chrome top">
      <span class="mark">Artyom Kulimov <i>—</i> paintings I keep returning to</span>
      <span class="count" aria-live="polite"><b id="zr-num">I</b> / {roman[works.length - 1]}</span>
    </header>

    <p class="note" id="zr-note" aria-live="polite"></p>

    <section class="label" id="zr-label" aria-live="polite">
      <h1 class="title"><span id="zr-title"></span></h1>
      <p class="by"><span id="zr-artist"></span><span class="dot">·</span><span id="zr-year"></span></p>
    </section>

    <aside class="meta" id="zr-meta">
      <p id="zr-medium"></p>
      <p id="zr-location"></p>
      <p><span id="zr-rights"></span> · <span id="zr-source"></span> · <a id="zr-original" target="_blank" rel="noreferrer">Full resolution ↗</a></p>
    </aside>

    <p class="hint" id="zr-hint" aria-hidden="true"><span></span>Scroll for the next painting</p>
  </main>

  <script id="zr-data" type="application/json" set:html={JSON.stringify(works)} />

  <style is:global>
    html,
    body {
      margin: 0;
      height: 100%;
      overflow: hidden;
      background: #000;
      color: #f2ece1;
      -webkit-font-smoothing: antialiased;
    }
    .zr {
      position: fixed;
      inset: 0;
      overflow: hidden;
      font-family: "Instrument Sans", system-ui, sans-serif;
      cursor: default;
    }
    .zr .stage {
      position: absolute;
      inset: 0;
    }
    .zr .layer {
      position: absolute;
      left: 0;
      top: 0;
      margin: 0;
      transform-origin: 0 0;
      opacity: 0;
      will-change: transform, opacity;
      backface-visibility: hidden;
      contain: strict;
    }
    .zr .layer img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      user-select: none;
      -webkit-user-drag: none;
    }
    .zr .layer .full {
      opacity: 0;
      transition: opacity 0.9s ease;
    }
    .zr .layer .full.ready {
      opacity: 1;
    }
    .zr .shade {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.18) 22%, transparent 38%),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.12) 11%, transparent 19%);
    }

    .zr .chrome {
      position: absolute;
      left: 0;
      right: 0;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 30px 44px;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(242, 236, 225, 0.66);
      text-shadow: 0 0 16px rgba(0, 0, 0, 0.55), 0 1px 2px rgba(0, 0, 0, 0.3);
      pointer-events: none;
    }
    .zr .top {
      top: 0;
    }
    .zr .mark i {
      font-style: normal;
      opacity: 0.6;
      margin: 0 0.4em;
    }
    .zr .count {
      font-family: "Instrument Serif", serif;
      font-size: 15px;
      letter-spacing: 0.08em;
    }
    .zr .count b {
      font-weight: 400;
      color: #f2ece1;
    }

    /* The detail caption: a single line, set word by word. */
    .zr .note {
      position: absolute;
      left: 44px;
      bottom: 46px;
      margin: 0;
      max-width: 60vw;
      font-family: "Instrument Serif", serif;
      font-style: italic;
      font-size: 27px;
      line-height: 1.15;
      color: #f6f0e4;
      text-shadow: 0 0 22px rgba(0, 0, 0, 0.55);
      pointer-events: none;
    }
    .zr .note .w {
      display: inline-block;
      opacity: 0;
      transform: translateY(0.35em);
      transition:
        opacity 0.9s cubic-bezier(0.2, 0.7, 0.1, 1),
        transform 1.1s cubic-bezier(0.2, 0.7, 0.1, 1);
    }
    .zr .note.in .w {
      opacity: 1;
      transform: none;
    }
    .zr .note.out .w {
      opacity: 0;
      transform: translateY(-0.2em);
      transition-duration: 0.5s;
      transition-delay: 0s !important;
    }
    .zr .note .x {
      font-family: "Instrument Sans", sans-serif;
      font-style: normal;
      font-size: 10.5px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(246, 240, 228, 0.55);
      margin-right: 14px;
      vertical-align: 0.35em;
    }

    .zr .label {
      position: absolute;
      left: 44px;
      bottom: 40px;
      pointer-events: none;
    }
    .zr .title {
      margin: 0;
      font-family: "Instrument Serif", serif;
      font-weight: 400;
      font-size: clamp(40px, 5.4vw, 78px);
      line-height: 0.98;
      letter-spacing: -0.012em;
      overflow: hidden;
      padding-bottom: 0.08em;
    }
    .zr .title span {
      display: inline-block;
      transform: translateY(105%);
      transition: transform 1.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .zr .by {
      margin: 12px 0 0;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(242, 236, 225, 0.78);
      text-shadow: 0 0 14px rgba(0, 0, 0, 0.6);
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.9s ease 0.35s,
        transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s;
    }
    .zr .by .dot {
      margin: 0 0.7em;
      opacity: 0.5;
    }
    .zr .label.reset .title span,
    .zr .label.reset .by {
      transition: none !important;
    }
    .zr .label.in .title span {
      transform: none;
    }
    .zr .label.in .by {
      opacity: 1;
      transform: none;
    }
    .zr .label.out .title span {
      transform: translateY(-105%);
      transition-duration: 0.6s;
      transition-timing-function: cubic-bezier(0.7, 0, 0.84, 0);
    }
    .zr .label.out .by {
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .zr .meta {
      position: absolute;
      right: 44px;
      bottom: 44px;
      text-align: right;
      font-size: 11px;
      line-height: 1.75;
      letter-spacing: 0.04em;
      color: rgba(242, 236, 225, 0.66);
      text-shadow: 0 0 14px rgba(0, 0, 0, 0.7), 0 1px 2px rgba(0, 0, 0, 0.4);
      opacity: 0;
      transition: opacity 0.9s ease;
      pointer-events: none;
    }
    .zr .meta p {
      margin: 0;
    }
    .zr .meta.in {
      opacity: 1;
      transition-delay: 0.7s;
      pointer-events: auto;
    }
    .zr .meta a {
      color: #f2ece1;
      text-decoration: none;
      border-bottom: 1px solid rgba(242, 236, 225, 0.35);
      transition: border-color 0.3s;
    }
    .zr .meta a:hover,
    .zr .meta a:focus-visible {
      border-color: #f2ece1;
      outline: none;
    }

    .zr .hint {
      position: absolute;
      left: 50%;
      bottom: 46px;
      transform: translateX(-50%);
      margin: 0;
      font-size: 10.5px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(242, 236, 225, 0.5);
      display: flex;
      align-items: center;
      gap: 14px;
      opacity: 0;
      transition: opacity 1.2s ease;
      pointer-events: none;
    }
    .zr .hint span {
      width: 1px;
      height: 26px;
      background: linear-gradient(rgba(242, 236, 225, 0), rgba(242, 236, 225, 0.7));
      animation: zr-drip 2.4s cubic-bezier(0.6, 0, 0.3, 1) infinite;
      transform-origin: top;
    }
    .zr .hint.in {
      opacity: 1;
      transition-delay: 1.6s;
    }
    @keyframes zr-drip {
      0% {
        transform: scaleY(0);
        transform-origin: top;
      }
      50% {
        transform: scaleY(1);
        transform-origin: top;
      }
      51% {
        transform-origin: bottom;
      }
      100% {
        transform: scaleY(0);
        transform-origin: bottom;
      }
    }

    @media (max-width: 760px) {
      .zr .chrome {
        padding: 20px 22px;
      }
      .zr .mark {
        display: none;
      }
      .zr .note,
      .zr .label {
        left: 22px;
        right: 22px;
        bottom: 120px;
      }
      .zr .note {
        font-size: 21px;
        max-width: none;
      }
      .zr .meta {
        left: 22px;
        right: 22px;
        bottom: 28px;
        text-align: left;
      }
      .zr .hint {
        display: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .zr .note .w,
      .zr .title span,
      .zr .by,
      .zr .hint span {
        transition-duration: 0.01s !important;
        animation: none !important;
      }
    }
  </style>

  <script>
    import "@/ideas/zoom-reveal/main";
  </script>
</Idea>
