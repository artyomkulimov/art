---
import Idea from "@/layouts/Idea.astro";
import { Image } from "astro:assets";
import { getPaintings } from "@/lib/paintings";
import { getWorks } from "@/ideas/loupe/works";

const paintings = await getPaintings();
const works = await getWorks();
const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];
---
<Idea title="Loupe" background="#0b0a09">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@300;400&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&display=swap"
  />

  <main class="lp" data-active="0">
    <header class="lp-top">
      <span class="lp-name">Artyom Kulimov</span>
      <span class="lp-hint" aria-hidden="true">Move to look closer <i>·</i> scroll to change power</span>
    </header>

    <div class="lp-stage" id="lp-stage">
      {
        works.map((w, i) => (
          <figure class:list={["lp-frame", { on: i === 0 }]} data-i={i} style={`--ar:${w.w / w.h}`} aria-hidden={i === 0 ? "false" : "true"}>
            <Image
              src={paintings[i].image}
              widths={[960, 1440, 1920, 2560]}
              sizes="94vw"
              format="webp"
              quality={80}
              alt={`${w.title}, ${w.artist}, ${w.year}`}
              loading="eager"
              fetchpriority={i === 0 ? "high" : "low"}
              decoding="async"
              draggable="false"
            />
            <div class="lp-pois">
              {w.details.map((d, k) => (
                <button
                  class="lp-poi"
                  style={`left:${d.x * 100}%;top:${d.y * 100}%;--delay:${k * 0.8}s`}
                  data-k={k}
                  tabindex={i === 0 ? 0 : -1}
                  aria-label={`Detail ${k + 1}: ${d.note}`}
                >
                  <span />
                </button>
              ))}
            </div>
          </figure>
        ))
      }
      <div class="lp-dim" aria-hidden="true"></div>
    </div>

    <canvas class="lp-lens" id="lp-lens" aria-hidden="true"></canvas>
    <div class="lp-note" id="lp-note" aria-live="polite"><b id="lp-note-k"></b><span id="lp-note-t"></span></div>
    <div class="lp-power" id="lp-power" aria-hidden="true">3.0×</div>

    <footer class="lp-foot">
      <p class="lp-caption" aria-live="polite">
        <em id="lp-title">{works[0].title}</em><span id="lp-by">{works[0].artist}, {works[0].year}</span>
      </p>
      <nav class="lp-nav" aria-label="Paintings">
        {
          works.map((w, i) => (
            <button data-go={i} aria-label={w.title} aria-current={i === 0 ? "true" : undefined}>
              {ROMAN[i]}
            </button>
          ))
        }
      </nav>
      <p class="lp-credit">
        <span id="lp-rights">{works[0].rights}</span><i>·</i><span id="lp-source">{works[0].source}</span><i>·</i><a
          id="lp-original"
          href={works[0].original}
          target="_blank"
          rel="noreferrer">Original ↗</a
        >
      </p>
    </footer>
  </main>

  <script id="lp-data" type="application/json" set:html={JSON.stringify(works)} />

  <style is:global>
    html,
    body {
      margin: 0;
      height: 100%;
      overflow: hidden;
      background: #0b0a09;
      color: #ece6da;
      -webkit-font-smoothing: antialiased;
    }
    .lp {
      position: fixed;
      inset: 0;
      font-family: "Newsreader", Georgia, serif;
    }
    .lp-top,
    .lp-foot {
      position: absolute;
      left: 40px;
      right: 40px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      z-index: 3;
    }
    .lp-top {
      top: 22px;
      font-family: "Martian Mono", monospace;
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(236, 230, 218, 0.48);
    }
    .lp-hint i {
      font-style: normal;
      margin: 0 0.6em;
      opacity: 0.6;
    }
    .lp-hint {
      transition: opacity 1s ease;
    }
    .lp.touched .lp-hint {
      opacity: 0;
    }

    .lp-stage {
      position: absolute;
      inset: 54px 40px 74px;
      container-type: size;
      touch-action: none;
    }
    .lp-frame {
      position: absolute;
      inset: 0;
      margin: auto;
      width: min(100cqw, 100cqh * var(--ar));
      aspect-ratio: var(--ar);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s linear 0.9s;
    }
    .lp-frame.on {
      opacity: 1;
      visibility: visible;
      transition:
        opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1) 0.15s,
        visibility 0s;
    }
    .lp-pois {
      opacity: 0;
      transition: opacity 1.2s ease 0.3s;
    }
    .lp-frame.loaded .lp-pois {
      opacity: 1;
    }
    .lp-frame img {
      opacity: 0;
      transition: opacity 0.7s ease;
    }
    .lp-frame.loaded img {
      opacity: 1;
    }
    .lp-frame img {
      display: block;
      width: 100%;
      height: 100%;
      user-select: none;
      -webkit-user-drag: none;
    }
    .lp-stage.looking,
    .lp-stage.looking * {
      cursor: none;
    }
    .lp-dim {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: #0b0a09;
      opacity: 0;
      transition: opacity 0.8s ease;
    }
    .lp-stage.looking .lp-dim {
      opacity: 0.24;
    }

    /* Points of interest: a seed of light that breathes. */
    .lp-pois {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .lp-poi {
      position: absolute;
      width: 34px;
      height: 34px;
      margin: -17px 0 0 -17px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
      pointer-events: auto;
      border-radius: 50%;
      outline: none;
    }
    .lp-poi span,
    .lp-poi::before,
    .lp-poi::after {
      position: absolute;
      left: 50%;
      top: 50%;
      border-radius: 50%;
      content: "";
    }
    .lp-poi span {
      width: 5px;
      height: 5px;
      margin: -2.5px;
      background: #fff6e6;
      box-shadow: 0 0 6px 1px rgba(255, 238, 205, 0.55);
    }
    .lp-poi::before,
    .lp-poi::after {
      width: 30px;
      height: 30px;
      margin: -15px;
      border: 1px solid rgba(255, 244, 226, 0.7);
      opacity: 0;
      transform: scale(0.2);
      animation: lp-breathe 3.6s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
      animation-delay: var(--delay);
    }
    .lp-poi::after {
      animation-delay: calc(var(--delay) + 1.2s);
    }
    .lp-poi:focus-visible span {
      background: #fff;
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.25);
    }
    @keyframes lp-breathe {
      0% {
        opacity: 0;
        transform: scale(0.2);
      }
      25% {
        opacity: 0.75;
      }
      100% {
        opacity: 0;
        transform: scale(1);
      }
    }

    .lp-lens {
      position: fixed;
      left: 0;
      top: 0;
      pointer-events: none;
      z-index: 4;
      will-change: transform;
    }
    .lp-note,
    .lp-power {
      position: fixed;
      left: 0;
      top: 0;
      z-index: 5;
      pointer-events: none;
      will-change: transform;
    }
    .lp-note {
      width: 280px;
      opacity: 0;
      transition: opacity 0.45s ease;
    }
    .lp-note.on {
      opacity: 1;
    }
    .lp-note b {
      display: block;
      font-family: "Martian Mono", monospace;
      font-weight: 300;
      font-size: 9.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(236, 230, 218, 0.72);
      text-shadow: 0 0 10px rgba(0, 0, 0, 0.9), 0 0 3px rgba(0, 0, 0, 0.6);
      margin-bottom: 7px;
    }
    .lp-note span {
      display: block;
      font-style: italic;
      font-weight: 300;
      font-size: 21px;
      line-height: 1.18;
      color: #f7f1e6;
      text-wrap: balance;
      text-shadow: 0 1px 14px rgba(0, 0, 0, 0.75), 0 0 3px rgba(0, 0, 0, 0.5);
    }
    .lp-note.left {
      text-align: right;
    }
    .lp-power {
      font-family: "Martian Mono", monospace;
      font-size: 9.5px;
      font-weight: 300;
      letter-spacing: 0.06em;
      color: rgba(246, 240, 228, 0.78);
      text-shadow: 0 0 8px rgba(0, 0, 0, 0.9);
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .lp-power.on {
      opacity: 1;
    }

    .lp-foot {
      bottom: 22px;
      font-size: 15px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 32px;
    }
    .lp-foot p {
      margin: 0;
    }
    .lp-caption em {
      font-style: italic;
      font-size: 19px;
      margin-right: 12px;
      color: #f4eee3;
    }
    .lp-caption span {
      color: rgba(236, 230, 218, 0.6);
      font-weight: 300;
    }
    .lp-caption em,
    .lp-caption span,
    .lp-credit {
      transition: opacity 0.45s ease;
    }
    .lp.swapping .lp-caption em,
    .lp.swapping .lp-caption span,
    .lp.swapping .lp-credit {
      opacity: 0;
    }
    .lp-nav {
      display: flex;
      gap: 6px;
    }
    .lp-nav button {
      font: inherit;
      font-size: 14px;
      min-width: 34px;
      padding: 6px 4px;
      background: none;
      border: 0;
      color: rgba(236, 230, 218, 0.36);
      cursor: pointer;
      position: relative;
      transition: color 0.4s ease;
    }
    .lp-nav button::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: 0;
      width: 14px;
      height: 1px;
      margin-left: -7px;
      background: currentColor;
      transform: scaleX(0);
      transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
    }
    .lp-nav button:hover,
    .lp-nav button:focus-visible {
      color: rgba(236, 230, 218, 0.8);
      outline: none;
    }
    .lp-nav button[aria-current="true"] {
      color: #f4eee3;
    }
    .lp-nav button[aria-current="true"]::after {
      transform: scaleX(1);
    }
    .lp-credit {
      text-align: right;
      font-family: "Martian Mono", monospace;
      font-weight: 300;
      font-size: 9.5px;
      line-height: 1.7;
      letter-spacing: 0.04em;
      color: rgba(236, 230, 218, 0.48);
      text-wrap: balance;
    }
    .lp-credit a {
      white-space: nowrap;
    }
    .lp-credit i {
      font-style: normal;
      margin: 0 0.7em;
    }
    .lp-credit a {
      color: rgba(236, 230, 218, 0.85);
      text-decoration: none;
      border-bottom: 1px solid rgba(236, 230, 218, 0.3);
    }
    .lp-credit a:hover,
    .lp-credit a:focus-visible {
      color: #fff;
      border-color: #fff;
      outline: none;
    }

    @media (max-width: 760px) {
      .lp-top,
      .lp-foot {
        left: 18px;
        right: 18px;
      }
      .lp-hint {
        display: none;
      }
      .lp-stage {
        inset: 54px 12px 120px;
      }
      .lp-foot {
        grid-template-columns: 1fr auto;
        row-gap: 10px;
      }
      .lp-caption {
        grid-column: 1 / -1;
      }
      .lp-credit {
        text-align: left;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .lp-poi::before,
      .lp-poi::after {
        animation: none;
        opacity: 0.5;
        transform: scale(0.45);
      }
      .lp-frame,
      .lp-frame.on {
        transition-duration: 0.01s;
      }
    }
  </style>

  <script>
    import "@/ideas/loupe/main";
  </script>
</Idea>
