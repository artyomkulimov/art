---
/**
 * text-index — the collection as a list of titles. Hover (or focus) a title
 * and the painting floods the page behind the type, which inverts over it.
 * Click and the painting pulls back from full-bleed to sit alone with its
 * catalogue entry. Everything is already on the page: no route change.
 */
import { Picture } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();
const pad2 = (n: number) => String(n).padStart(2, "0");
const total = pad2(paintings.length);
---

<Idea title="Index" background="#ebe9e3">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..700&family=IBM+Plex+Mono:wght@400;500&display=swap"
  />

  <div class="stage" aria-hidden="true">
    {
      paintings.map((p, i) => (
        <div
          class="plate"
          data-i={i}
          data-w={p.image.width}
          data-h={p.image.height}
          style={`--ox:${(p.details[0]?.x ?? 0.5) * 100}%;--oy:${(p.details[0]?.y ?? 0.5) * 100}%;background:${p.palette[0]}`}
        >
          <div class="zoom">
            <Picture
              src={p.image}
              formats={["avif", "webp"]}
              widths={[800, 1200, 1600, 2400, 3200]}
              sizes="100vw"
              alt=""
              loading="eager"
              decoding="async"
              fetchpriority={i === 0 ? "high" : "auto"}
            />
          </div>
        </div>
      ))
    }
  </div>

  <div class="ink">
    <header class="top">
      <a class="home" href="#" data-close>Artyom Kulimov<span class="sep">/</span>Paintings</a>
      <span class="count">Index <span class="tab">({total})</span></span>
    </header>

    <main class="list">
      <ol>
        {
          paintings.map((p, i) => (
            <li>
              <a class="row" href={`#${p.id}`} data-i={i}>
                <span class="n">{pad2(i + 1)}</span>
                <span class="t">{p.title}</span>
                <span class="m">
                  {p.artist}, {p.year}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="hint">
        <span>Hover to look. Click to open.</span>
        <span class="keys">↑ ↓ ↵</span>
      </p>
    </main>

    <section class="entry" aria-live="polite">
      {
        paintings.map((p, i) => (
          <article class="card" data-i={i} aria-hidden="true">
            <h1 class="ct">{p.title}</h1>
            <dl class="cm">
              <div>
                <dt>Artist</dt>
                <dd>
                  {p.artist}, {p.year}
                </dd>
              </div>
              <div>
                <dt>Medium</dt>
                <dd>{p.medium}</dd>
              </div>
              <div>
                <dt>Held</dt>
                <dd>{p.location}</dd>
              </div>
            </dl>
            <dl class="cm">
              <div>
                <dt>Rights</dt>
                <dd>{p.rights}</dd>
              </div>
              <div>
                <dt>Source</dt>
                <dd>{p.source}</dd>
              </div>
              <div>
                <dt>Original</dt>
                <dd>
                  <a href={p.original} target="_blank" rel="noopener">
                    Full resolution ↗
                  </a>
                </dd>
              </div>
            </dl>
            <nav class="cn">
              <span class="tab">
                {pad2(i + 1)}/{total}
              </span>
              <button type="button" data-step="-1" aria-label="Previous painting">←</button>
              <button type="button" data-step="1" aria-label="Next painting">→</button>
              <button type="button" class="back" data-close>Index</button>
            </nav>
          </article>
        ))
      }
    </section>
  </div>
</Idea>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    background: #ebe9e3;
    min-height: 100%;
  }
  body {
    --pad: clamp(18px, 2.4vw, 40px);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  body.is-open {
    overflow: hidden;
  }
  a,
  button {
    color: inherit;
    font: inherit;
  }
  button {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  /* ---- stage: one full-bleed plate per painting ---- */
  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .plate {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    transform-origin: 0 0;
    transition: opacity 0.22s linear;
  }
  .plate.on {
    opacity: 1;
    transition-duration: 0.06s;
  }
  .plate.on.front {
    z-index: 1;
  }
  .zoom {
    width: 100%;
    height: 100%;
    transform-origin: var(--ox) var(--oy);
  }
  .plate picture,
  .plate img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ---- ink: every piece of type, inverted against whatever is behind ---- */
  .ink {
    position: relative;
    z-index: 2;
    color: #fff;
    mix-blend-mode: difference;
  }

  .top {
    position: fixed;
    inset: 0 0 auto 0;
    display: flex;
    justify-content: space-between;
    padding: var(--pad);
    font-size: 12px;
    letter-spacing: 0.02em;
    z-index: 3;
  }
  .home {
    text-decoration: none;
  }
  .sep {
    margin: 0 0.6em;
    opacity: 0.5;
  }
  .tab {
    font-variant-numeric: tabular-nums;
  }

  .list {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 18vh var(--pad) var(--pad);
    transition: opacity 0.35s var(--ease);
  }
  .list ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(255 255 255 / 0.32);
  }
  .list li {
    border-bottom: 1px solid rgb(255 255 255 / 0.32);
  }
  .row {
    display: grid;
    grid-template-columns: 7.2vw 1fr auto;
    align-items: baseline;
    gap: 0 1.2vw;
    padding: 0.12em 0 0.06em;
    text-decoration: none;
    font-size: clamp(44px, 7.6vw, 168px);
    outline: none;
    transition: opacity 0.18s linear;
  }
  .row .n,
  .row .m {
    font-size: 12px;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .row .n {
    align-self: start;
    padding-top: 0.9em;
  }
  .row .t {
    font-family: "Archivo", sans-serif;
    font-variation-settings: "wdth" 72;
    font-weight: 380;
    line-height: 0.98;
    letter-spacing: -0.035em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row .m {
    text-align: right;
    white-space: nowrap;
  }
  .list.has-active .row {
    opacity: 0.22;
  }
  .list.has-active .row.active {
    opacity: 1;
  }
  .row:focus-visible .t {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .hint {
    display: flex;
    justify-content: space-between;
    margin: 1.4em 0 0;
    font-size: 12px;
    opacity: 0.55;
    transition: opacity 0.3s linear;
  }
  .list.has-active .hint {
    opacity: 0;
  }

  /* ---- entry: the opened painting's catalogue card ---- */
  .entry {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 var(--pad) var(--pad);
    pointer-events: none;
  }
  .card {
    position: absolute;
    left: var(--pad);
    right: var(--pad);
    bottom: var(--pad);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 2.4vw;
    align-items: end;
    visibility: hidden;
  }
  .card > * {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.3s linear,
      transform 0.5s var(--ease);
  }
  .card.show {
    visibility: visible;
    pointer-events: auto;
  }
  .card.show > * {
    opacity: 1;
    transform: none;
    transition-duration: 0.6s, 0.9s;
  }
  .card.show > :nth-child(1) {
    transition-delay: 0.32s;
  }
  .card.show > :nth-child(2) {
    transition-delay: 0.4s;
  }
  .card.show > :nth-child(3) {
    transition-delay: 0.47s;
  }
  .card.show > :nth-child(4) {
    transition-delay: 0.54s;
  }
  .ct {
    margin: 0;
    font-family: "Archivo", sans-serif;
    font-variation-settings: "wdth" 72;
    font-weight: 380;
    font-size: clamp(32px, 3.6vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .cm {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.55;
  }
  .cm div {
    display: grid;
    grid-template-columns: 6.5em 1fr;
  }
  .cm dt {
    opacity: 0.5;
  }
  .cm dd {
    margin: 0;
  }
  .cm a {
    text-underline-offset: 0.2em;
  }
  .cn {
    display: flex;
    gap: 1.1em;
    align-items: baseline;
    font-size: 12px;
  }
  .cn button {
    font-size: 14px;
    line-height: 1;
  }
  .cn .back {
    font-size: 12px;
    margin-left: 0.6em;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cn button,
  .cm a,
  .home {
    outline: none;
  }
  .cn button:focus-visible,
  .cm a:focus-visible,
  .home:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  body.is-open .list {
    opacity: 0;
    pointer-events: none;
  }
  body.is-open .count {
    opacity: 0;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      font-size: 12vw;
    }
    .row .n {
      display: none;
    }
    .row .m {
      text-align: left;
      padding-bottom: 0.8em;
    }
    .row .t {
      white-space: normal;
    }
    .card {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate,
    .row,
    .list,
    .card > * {
      transition: none !important;
    }
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
  const body = document.body;
  const list = document.querySelector<HTMLElement>(".list")!;
  const rows = [...document.querySelectorAll<HTMLAnchorElement>(".row")];
  const plates = [...document.querySelectorAll<HTMLElement>(".plate")];
  const cards = [...document.querySelectorAll<HTMLElement>(".card")];
  const ids = rows.map((r) => r.hash.slice(1));
  const n = plates.length;

  // Geometry: each plate is laid out at its "contained" rect (how it sits when
  // opened). Its "cover" transform maps that rect onto the full viewport.
  type Geo = { x: number; y: number; w: number; h: number; s: number; tx: number; ty: number };
  let geo: Geo[] = [];
  const layout = () => {
    const vw = innerWidth;
    const vh = innerHeight;
    const pad = Math.max(18, Math.min(40, vw * 0.024));
    const card = cards[0]?.getBoundingClientRect().height ?? 120;
    const top = pad * 2.6;
    const availW = vw - pad * 2;
    const availH = vh - top - card - pad * 2.6;
    geo = plates.map((pl) => {
      const ar = Number(pl.dataset.w) / Number(pl.dataset.h);
      let w = availW;
      let h = w / ar;
      if (h > availH) {
        h = availH;
        w = h * ar;
      }
      const x = (vw - w) / 2;
      const y = top + (availH - h) / 2;
      const s = Math.max(vw / w, vh / h) * 1.002;
      const tx = (vw - w * s) / 2;
      const ty = (vh - h * s) / 2;
      pl.style.width = `${w}px`;
      pl.style.height = `${h}px`;
      return { x, y, w, h, s, tx, ty };
    });
    plates.forEach((pl, i) => place(pl, i, open === i ? "contain" : "cover", false));
  };

  const coverT = (g: Geo) => `translate(${g.tx}px, ${g.ty}px) scale(${g.s})`;
  const containT = (g: Geo) => `translate(${g.x}px, ${g.y}px) scale(1)`;

  const place = (pl: HTMLElement, i: number, mode: "cover" | "contain", animate: boolean) => {
    const g = geo[i];
    const to = mode === "cover" ? coverT(g) : containT(g);
    if (animate && !reduce) {
      const from = getComputedStyle(pl).transform;
      pl.style.transform = to;
      pl.animate([{ transform: from }, { transform: to }], { duration: 1100, easing: EASE });
    } else {
      pl.style.transform = to;
    }
  };

  // ---- hover / focus: show a painting behind the list ----
  let shown = -1;
  let open = -1;
  const show = (i: number) => {
    if (i === shown) return;
    shown = i;
    plates.forEach((pl, k) => {
      pl.classList.toggle("on", k === i);
      pl.classList.toggle("front", k === i);
    });
    rows.forEach((r, k) => r.classList.toggle("active", k === i));
    list.classList.toggle("has-active", i >= 0);
    if (i >= 0 && !reduce) {
      // a small zoom-reveal: arrive on the painting's detail, settle back
      plates[i].querySelector<HTMLElement>(".zoom")!.animate(
        [{ transform: "scale(1.14)" }, { transform: "scale(1)" }],
        { duration: 1500, easing: EASE },
      );
    }
  };

  let leaveTimer = 0;
  rows.forEach((r, i) => {
    r.addEventListener("pointerenter", () => {
      clearTimeout(leaveTimer);
      if (open < 0) show(i);
    });
    r.addEventListener("focus", () => open < 0 && show(i));
    r.addEventListener("click", (e) => {
      e.preventDefault();
      openAt(i, true);
    });
  });
  list.querySelector("ol")!.addEventListener("pointerleave", () => {
    leaveTimer = window.setTimeout(() => open < 0 && show(-1), 60);
  });
  // a painting held by keyboard focus lets go as soon as the pointer wanders
  addEventListener("pointermove", (e) => {
    if (open < 0 && shown >= 0 && !(e.target as Element).closest?.(".row")) {
      clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => open < 0 && show(-1), 60);
    }
  });
  list.addEventListener("focusout", (e) => {
    if (open < 0 && !list.contains(e.relatedTarget as Node)) show(-1);
  });

  // ---- open / close ----
  const setCard = (i: number) =>
    cards.forEach((c, k) => {
      c.classList.toggle("show", k === i);
      c.setAttribute("aria-hidden", String(k !== i));
    });

  const openAt = (i: number, push: boolean) => {
    if (open === i) return;
    const prev = open;
    open = i;
    body.classList.add("is-open");
    if (prev < 0) {
      // from the index: the hovered plate pulls back from full-bleed
      if (shown !== i) {
        shown = -1;
        show(i);
        plates[i].querySelector<HTMLElement>(".zoom")!.getAnimations().forEach((a) => a.finish());
      }
      place(plates[i], i, "contain", true);
    } else {
      // stepping while open: quick dissolve between contained plates
      plates.forEach((pl, k) => {
        pl.classList.toggle("on", k === i);
        pl.classList.toggle("front", k === i);
      });
      place(plates[i], i, "contain", false);
      if (!reduce)
        plates[i].animate([{ opacity: 0, transform: `${containT(geo[i])} scale(1.015)` }, { opacity: 1 }], {
          duration: 700,
          easing: EASE,
        });
      // re-cover the outgoing plate only once it has faded away
      window.setTimeout(() => {
        if (shown !== prev) place(plates[prev], prev, "cover", false);
      }, 320);
      shown = i;
      rows.forEach((r, k) => r.classList.toggle("active", k === i));
    }
    setCard(i);
    if (push) history.pushState({ i }, "", `#${ids[i]}`);
    cards[i].querySelector<HTMLElement>(".back")?.focus({ preventScroll: true });
  };

  const close = (push: boolean) => {
    if (open < 0) return;
    const i = open;
    open = -1;
    setCard(-1);
    body.classList.remove("is-open");
    place(plates[i], i, "cover", true);
    if (push) history.pushState({}, "", location.pathname);
    rows[i].focus({ preventScroll: true });
  };

  document.querySelectorAll<HTMLElement>("[data-close]").forEach((b) =>
    b.addEventListener("click", (e) => {
      e.preventDefault();
      close(true);
    }),
  );
  document.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
    b.addEventListener("click", () => openAt((open + Number(b.dataset.step) + n) % n, true)),
  );

  addEventListener("popstate", () => {
    const i = ids.indexOf(location.hash.slice(1));
    if (i >= 0) openAt(i, false);
    else close(false);
  });

  addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (open >= 0) {
      if (e.key === "Escape") close(true);
      else if (e.key === "ArrowRight") openAt((open + 1) % n, true);
      else if (e.key === "ArrowLeft") openAt((open - 1 + n) % n, true);
      return;
    }
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      const cur = rows.indexOf(document.activeElement as HTMLAnchorElement);
      const next = cur < 0 ? (e.key === "ArrowDown" ? 0 : n - 1) : (cur + (e.key === "ArrowDown" ? 1 : -1) + n) % n;
      rows[next].focus();
    } else if (e.key === "Escape") {
      (document.activeElement as HTMLElement)?.blur();
      show(-1);
    }
  });

  addEventListener("resize", layout);
  layout();

  // warm the decoder so the first hover is instant
  plates.forEach((pl) => pl.querySelector("img")?.decode().catch(() => {}));

  const start = ids.indexOf(location.hash.slice(1));
  if (start >= 0) {
    show(start);
    openAt(start, false);
  }
</script>
