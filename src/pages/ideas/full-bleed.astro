---
/**
 * full-bleed — the painting is the whole site.
 * Edge to edge, nothing on screen at rest. Moving the mouse lets a whisper of
 * information surface; stillness takes it away again. Scrolling dissolves,
 * very slowly, into the next painting.
 */
import { Picture } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();
const pad = (n: number) => String(n).padStart(2, "0");

// Focal point = centre of the painting's points of interest (falls back to centre).
const focus = (p: (typeof paintings)[number]) => {
  if (!p.details.length) return { x: 0.5, y: 0.5 };
  const x = p.details.reduce((s, d) => s + d.x, 0) / p.details.length;
  const y = p.details.reduce((s, d) => s + d.y, 0) / p.details.length;
  return { x, y };
};
---

<Idea title="Full bleed" background="#000">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" />

  <main class="stage" aria-roledescription="carousel" aria-label="Paintings">
    {
      paintings.map((p, i) => {
        const f = focus(p);
        const aspect = p.image.width / p.image.height;
        return (
          <figure
            class:list={["plate", { "is-current": i === 0 }]}
            data-index={i}
            data-aspect={aspect.toFixed(4)}
            style={`--fx:${(f.x * 100).toFixed(1)}%;--fy:${(f.y * 100).toFixed(1)}%`}
            aria-hidden={i === 0 ? "false" : "true"}
          >
            <Picture
              src={p.image}
              alt={`${p.title}, ${p.artist}, ${p.year}`}
              widths={[960, 1440, 1920, 2560, 3200]}
              sizes={`max(100vw, ${Math.ceil(aspect * 100)}vh)`}
              formats={["avif", "webp"]}
              quality={72}
              loading="eager"
              decoding="async"
              fetchpriority={i === 0 ? "high" : "low"}
            />
          </figure>
        )
      })
    }
  </main>

  <div class="veil" aria-hidden="true"></div>

  <aside class="info" aria-live="polite">
    <p class="mark">Artyom Kulimov <span>— paintings I keep returning to</span></p>
    {
      paintings.map((p, i) => (
        <div class:list={["caption", { "is-current": i === 0 }]} data-index={i}>
          <h1 class="title">{p.title}</h1>
          <p class="byline">
            {p.artist}, {p.year}
          </p>
          <p class="fine">
            <span>{p.medium}</span>
            <span>{p.location}</span>
          </p>
          <p class="credit">
            <span>{p.rights}</span>
            <span>{`via ${p.source}`}</span>
            <a href={p.original} target="_blank" rel="noopener">
              Full-resolution original<i aria-hidden="true">↗</i>
            </a>
          </p>
        </div>
      ))
    }
    <nav class="index" aria-label="Painting index">
      {
        paintings.map((p, i) => (
          <button type="button" class:list={{ "is-current": i === 0 }} data-go={i} aria-label={`Show ${p.title}`}>
            {pad(i + 1)}
          </button>
        ))
      }
    </nav>
  </aside>

  <style is:global>
    html,
    body {
      margin: 0;
      height: 100%;
      overflow: hidden;
      background: #000;
    }
    body {
      cursor: default;
      -webkit-font-smoothing: antialiased;
    }
    body.is-idle {
      cursor: none;
    }
  </style>

  <style>
    :root {
      --dissolve: 2600ms;
      --ease-dissolve: cubic-bezier(0.45, 0, 0.25, 1);
      --ink: #f1ece2;
    }

    .stage {
      position: fixed;
      inset: 0;
      overflow: hidden;
      background: #000;
    }

    .plate {
      position: absolute;
      inset: 0;
      margin: 0;
      opacity: 0;
      transition: opacity var(--dissolve) var(--ease-dissolve);
    }
    .plate.is-current {
      opacity: 1;
      z-index: 1;
    }
    /* The outgoing painting holds still underneath, so the dissolve never dips to black. */
    .plate.is-leaving {
      z-index: 0;
      opacity: 1;
      transition: none;
    }
    .plate.is-leaving :global(img) {
      transform: scale(1);
    }
    .plate :global(picture),
    .plate :global(img) {
      display: block;
      width: 100%;
      height: 100%;
    }
    .plate :global(img) {
      object-fit: cover;
      object-position: var(--fx) var(--fy);
      transform-origin: var(--fx) var(--fy);
      /* A breath, not a Ken Burns: the painting settles almost imperceptibly. */
      transform: scale(1.045);
      transition: transform 22s cubic-bezier(0.2, 0, 0.1, 1);
    }
    .plate.is-current :global(img) {
      transform: scale(1);
    }
    /* Too much would be cropped (very wide / tall screens): show it whole. */
    .plate.is-contained :global(img) {
      object-fit: contain;
      object-position: 50% 50%;
      transform-origin: 50% 50%;
    }

    /* Only a hint of shade, and only when the words are present. */
    .veil {
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background:
        linear-gradient(to top, rgb(0 0 0 / 0.62) 0%, rgb(0 0 0 / 0.28) 16%, transparent 34%),
        linear-gradient(to bottom, rgb(0 0 0 / 0.32) 0%, transparent 14%);
      opacity: 0;
      transition: opacity 1600ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .info {
      position: fixed;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      color: var(--ink);
      font-family: "Instrument Sans", system-ui, sans-serif;
      font-size: 12px;
      line-height: 1.5;
      letter-spacing: 0.01em;
      opacity: 0;
      transition: opacity 1600ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    body.is-awake .veil,
    body.is-awake .info {
      opacity: 1;
      transition-duration: 700ms;
    }
    body.is-awake .info {
      pointer-events: auto;
    }

    .mark {
      position: absolute;
      top: 28px;
      left: 36px;
      margin: 0;
      font-weight: 500;
      font-size: 11px;
      letter-spacing: 0.04em;
    }
    .mark span {
      font-weight: 400;
      opacity: 0.55;
    }

    .caption {
      position: absolute;
      left: 36px;
      bottom: 32px;
      max-width: min(560px, 70vw);
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 900ms cubic-bezier(0.4, 0, 0.2, 1),
        transform 1200ms cubic-bezier(0.2, 0.7, 0.1, 1);
      pointer-events: none;
    }
    .caption.is-current {
      opacity: 1;
      transform: none;
      transition-delay: 500ms;
      pointer-events: auto;
    }
    .title {
      margin: 0 0 6px;
      font-family: "Instrument Serif", Georgia, serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(28px, 2.9vw, 42px);
      line-height: 1;
      letter-spacing: -0.01em;
    }
    .byline {
      margin: 0 0 14px;
      font-size: 13px;
    }
    .fine,
    .credit {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0 14px;
      opacity: 0.62;
      font-size: 11px;
    }
    .credit {
      margin-top: 2px;
    }
    .credit a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid rgb(241 236 226 / 0.35);
      transition: border-color 300ms;
    }
    .credit a:hover,
    .credit a:focus-visible {
      border-color: var(--ink);
      outline: none;
    }
    .credit a i {
      font-style: normal;
      margin-left: 3px;
    }
    .caption:has(a:hover) .credit {
      opacity: 1;
    }

    .index {
      position: absolute;
      right: 30px;
      bottom: 28px;
      display: flex;
      gap: 2px;
    }
    .index button {
      appearance: none;
      background: none;
      border: 0;
      padding: 6px;
      color: var(--ink);
      font: inherit;
      font-size: 11px;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.06em;
      opacity: 0.38;
      cursor: pointer;
      transition: opacity 400ms;
    }
    .index button.is-current {
      opacity: 1;
    }
    .index button:hover,
    .index button:focus-visible {
      opacity: 1;
      outline: none;
    }
    .index button.is-current::after {
      content: "";
      display: block;
      height: 1px;
      margin-top: 4px;
      background: currentColor;
    }

    @media (max-width: 640px) {
      .mark span {
        display: none;
      }
      .mark {
        left: 20px;
        top: 20px;
      }
      .caption {
        left: 20px;
        bottom: 64px;
      }
      .index {
        right: 14px;
        bottom: 18px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :root {
        --dissolve: 400ms;
      }
      .plate :global(img),
      .plate.is-current :global(img) {
        transform: none;
        transition: none;
      }
      .caption {
        transform: none;
      }
    }
  </style>

  <script>
    const plates = [...document.querySelectorAll<HTMLElement>(".plate")];
    const captions = [...document.querySelectorAll<HTMLElement>(".caption")];
    const dots = [...document.querySelectorAll<HTMLButtonElement>(".index button")];
    const body = document.body;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const DISSOLVE = reduced ? 400 : 2600;

    let current = 0;
    let lockedUntil = 0;

    /* ---- cover vs. contain: crop only when little is lost ---- */
    const fit = () => {
      const va = innerWidth / innerHeight;
      for (const el of plates) {
        const a = Number(el.dataset.aspect);
        const kept = Math.min(va / a, a / va); // fraction of the painting that survives a cover crop
        el.classList.toggle("is-contained", kept < 0.78);
      }
    };
    fit();
    addEventListener("resize", fit);

    /* ---- the info layer breathes with the mouse ---- */
    let idleTimer = 0;
    let pinned = false;
    const wake = (ms = 2400) => {
      body.classList.add("is-awake");
      body.classList.remove("is-idle");
      clearTimeout(idleTimer);
      if (pinned) return;
      idleTimer = window.setTimeout(() => {
        if (document.querySelector(".info a:hover, .info button:hover, .info :focus-visible")) return wake(ms);
        body.classList.remove("is-awake");
        body.classList.add("is-idle");
      }, ms);
    };
    // Arrival is always the painting alone: the first known pointer position
    // (browsers report one on load) only sets a baseline; the words wait for
    // an actual movement. Sub-pixel jitter is ignored too.
    let lastMove: { x: number; y: number } | null = null;
    addEventListener("pointermove", (e) => {
      if (!lastMove) {
        lastMove = { x: e.clientX, y: e.clientY };
        return;
      }
      if (Math.abs(e.clientX - lastMove.x) + Math.abs(e.clientY - lastMove.y) < 3) return;
      lastMove = { x: e.clientX, y: e.clientY };
      wake();
    });
    addEventListener("focusin", () => wake(4000));

    /* ---- slow cross-dissolve ---- */
    const show = (next: number) => {
      const n = plates.length;
      next = ((next % n) + n) % n;
      if (next === current) return;
      const prev = current;
      current = next;
      lockedUntil = performance.now() + DISSOLVE * 0.8;

      plates.forEach((el, i) => {
        el.classList.toggle("is-leaving", i === prev);
        el.classList.toggle("is-current", i === next);
        el.setAttribute("aria-hidden", String(i !== next));
      });
      captions.forEach((el, i) => el.classList.toggle("is-current", i === next));
      dots.forEach((el, i) => el.classList.toggle("is-current", i === next));
      window.setTimeout(() => plates[prev].classList.remove("is-leaving"), DISSOLVE);
    };

    // One wheel gesture = one painting, however long the trackpad keeps coasting.
    let lastWheel = 0;
    let armed = true;
    let acc = 0;
    addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        const now = performance.now();
        if (now - lastWheel > 180) {
          armed = true;
          acc = 0;
        }
        lastWheel = now;
        if (now < lockedUntil) {
          armed = false;
          return;
        }
        if (!armed) return;
        acc += Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (Math.abs(acc) > 24) {
          armed = false;
          show(current + Math.sign(acc));
        }
      },
      { passive: false },
    );

    addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key;
      if (["ArrowRight", "ArrowDown", "PageDown", " ", "j"].includes(k)) show(current + 1);
      else if (["ArrowLeft", "ArrowUp", "PageUp", "k"].includes(k)) show(current - 1);
      else if (k === "Home") show(0);
      else if (k === "End") show(plates.length - 1);
      else if (k === "i") {
        pinned = !pinned;
        if (pinned) wake();
        else wake(600);
        return;
      } else return;
      e.preventDefault();
      // keyboard users get a brief glimpse of where they are
      wake(2600);
    });

    dots.forEach((b) => b.addEventListener("click", () => show(Number(b.dataset.go))));

    // touch: swipe
    let touchY: number | null = null;
    addEventListener("touchstart", (e) => (touchY = e.touches[0].clientY), { passive: true });
    addEventListener("touchend", (e) => {
      if (touchY === null) return;
      const dy = touchY - e.changedTouches[0].clientY;
      touchY = null;
      if (Math.abs(dy) > 40) show(current + Math.sign(dy));
      else wake(3000);
    });
  </script>
</Idea>
