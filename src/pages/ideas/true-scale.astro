---
/**
 * true-scale — the paintings hung along one wall at their true relative
 * size, drawn like an architect's elevation: floor ruler, dimension lines,
 * and a 170 cm figure walking with you. Scroll down to walk along the wall;
 * click a painting to bring it up to fill the screen.
 */
import { Picture } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();

const APPROX: Record<string, [number, number]> = { "fall-of-babylon": [59.5, 90] };
const sizeOf = (p: (typeof paintings)[number]) => {
  const m = p.medium.match(/(\d+(?:\.\d+)?)\s*[×x]\s*(\d+(?:\.\d+)?)\s*cm/);
  if (m) return { h: Number(m[1]), w: Number(m[2]), approx: false };
  const a = APPROX[p.id] ?? [60, (60 * p.image.width) / p.image.height];
  return { h: a[0], w: a[1], approx: true };
};
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));

// Hang every painting with its centre at 150 cm, 200 cm apart (all in cm).
const START = 0;
const GAP = 210;
let x = START;
const hung = paintings.map((p, i) => {
  const s = sizeOf(p);
  const out = { p, i, ...s, x, y: 150 + s.h / 2 }; // y = top edge height above floor
  x += s.w + GAP;
  return out;
});
const wallEnd = x - GAP; // cm, right edge of the last painting

// A standing figure, 170 cm, drawn as one smooth outline (cm units).
const right: [number, number][] = [
  [0, 19.8], [3.3, 20.2], [3.7, 23.4], [6.4, 25.4], [10.5, 26.6], [15, 27.6], [18.6, 29.6], [20.6, 33], [21.4, 38],
  [22.2, 48], [22.8, 60], [23.4, 72], [23.8, 79], [23.6, 84], [22.4, 87.5], [20.6, 88], [19.6, 85.5],
  [19.4, 80], [18.8, 70], [18.2, 58], [17.4, 47], [16.6, 43], [15.8, 52], [14.8, 62], [15.6, 74],
  [17.2, 84], [17.4, 92], [16.4, 108], [14.6, 124], [13.4, 140], [11.6, 156], [10.8, 163], [12.6, 167.6],
  [12.4, 170], [4.2, 170], [4.6, 166], [5.2, 160], [5.4, 144], [4.4, 126], [3.2, 108], [1.6, 97.5], [0, 95.5],
];
const outline = [...right, ...right.slice(1, -1).reverse().map(([a, b]) => [-a, b] as [number, number])];
const smooth = (pts: [number, number][]) => {
  const n = pts.length;
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < n; i++) {
    const p0 = pts[(i - 1 + n) % n];
    const p1 = pts[i];
    const p2 = pts[(i + 1) % n];
    const p3 = pts[(i + 2) % n];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1[0].toFixed(2)},${c1[1].toFixed(2)} ${c2[0].toFixed(2)},${c2[1].toFixed(2)} ${p2[0]},${p2[1]}`;
  }
  return `${d}Z`;
};
const figurePath = smooth(outline);
---

<Idea title="True scale" background="#e9e6df">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Martian+Mono:wght@300;400&display=swap"
  />

  <div class="track" id="track" data-end={wallEnd}>
    <div class="stage">
      <div class="world" id="world">
        <div class="intro">
          <p class="kicker">Artyom Kulimov · Paintings</p>
          <h1>Hung at<br /><em>true scale.</em></h1>
          <p class="how">Scroll to walk the wall. Click a painting to stand closer.</p>
        </div>

        <div class="floor" aria-hidden="true"></div>
        <div class="ruler" aria-hidden="true"></div>

        {
          hung.map((h) => (
            <div class="hang" data-i={h.i} data-x={h.x} data-y={h.y} data-w={h.w} data-h={h.h}>
              <span class="dim dw" aria-hidden="true">
                <b>
                  {h.approx ? "≈ " : ""}
                  {fmt(h.w)} cm
                </b>
              </span>
              <span class="dim dh" aria-hidden="true">
                <b>
                  {h.approx ? "≈ " : ""}
                  {fmt(h.h)} cm
                </b>
              </span>
              <button
                class="work"
                type="button"
                data-i={h.i}
                data-ar={h.p.image.width / h.p.image.height}
                aria-label={`${h.p.title}, ${h.p.artist}, ${h.p.year}. Open`}
                style={`background:${h.p.palette[0]}`}
              >
                <Picture
                  src={h.p.image}
                  formats={["avif", "webp"]}
                  widths={[480, 720, 1000, 1400, 1800, 2400, 3200]}
                  sizes="600px"
                  alt={`${h.p.title} by ${h.p.artist}`}
                  loading={h.i < 2 ? "eager" : "lazy"}
                  decoding="auto"
                  draggable="false"
                />
              </button>
              <p class="tag">
                <span class="tt">{h.p.title}</span>
                <span class="ta">
                  {h.p.artist}, {h.p.year}
                </span>
              </p>
            </div>
          ))
        }

        <div class="veil" aria-hidden="true"></div>

        <p class="end">
          End of the wall.<br />
          <span>{paintings.length} works across {(wallEnd / 100).toFixed(1)} m of wall.</span>
        </p>
      </div>

      <div class="walker" aria-hidden="true">
        <svg class="fig" viewBox="-26 0 52 172" preserveAspectRatio="xMidYMax meet">
          <ellipse cx="0" cy="10.6" rx="7.1" ry="9.8"></ellipse>
          <path d={figurePath}></path>
        </svg>
        <span class="dim dfig"><b>170 cm</b></span>
      </div>

    </div>
  </div>

  {
    hung.map((h) => (
      <section class="info" data-i={h.i} aria-hidden="true">
        <h2>{h.p.title}</h2>
        <p class="ia">
          {h.p.artist}, {h.p.year}
        </p>
        <p class="im">
          {h.p.medium}
          {h.approx ? ` — shown at about ${fmt(h.h)} × ${fmt(h.w)} cm` : ""}
          <br />
          {h.p.location}
        </p>
        <p class="ir">
          {h.p.rights} · {h.p.source} ·{" "}
          <a href={h.p.original} target="_blank" rel="noopener">
            Full-resolution original ↗
          </a>
        </p>
        <button class="close" type="button">Back to the wall <span>Esc</span></button>
      </section>
    ))
  }

  <header class="hud">
    <span class="odo"><b id="odo">0.0</b> m along the wall</span>
  </header>
</Idea>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    background: #e9e6df;
    color: #26241f;
  }
  body {
    --k: 3px; /* px per cm, set from the viewport height */
    --floor: 86vh;
    --ink: #26241f;
    --line: rgb(38 36 31 / 0.55);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: "Martian Mono", ui-monospace, monospace;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }
  body.is-open {
    overflow: hidden;
  }

  .track {
    position: relative;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .world {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    will-change: transform;
  }

  /* ---- intro wall text ---- */
  .intro {
    position: absolute;
    left: calc(var(--k) * 70 + 22vw);
    top: calc(var(--floor) - var(--k) * 205);
    width: 30em;
  }
  .kicker,
  .how {
    font-size: 10px;
    letter-spacing: 0.06em;
    margin: 0;
    color: #6f6a5f;
  }
  .intro h1 {
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: clamp(44px, 6vw, 92px);
    line-height: 0.92;
    letter-spacing: -0.01em;
    margin: 0.35em 0 0.45em;
  }
  .intro em {
    font-style: italic;
  }

  /* ---- floor + metre ruler ---- */
  .floor {
    position: absolute;
    left: -100vw;
    right: -100vw;
    top: var(--floor);
    height: 1px;
    background: var(--ink);
  }
  .ruler {
    position: absolute;
    top: calc(var(--floor) + 1px);
    left: 0;
    height: 10px;
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to right, var(--line) 1px, transparent 1px);
    background-size:
      calc(var(--k) * 100) 10px,
      calc(var(--k) * 50) 5px;
    background-repeat: repeat-x;
  }
  .mark {
    position: absolute;
    top: calc(var(--floor) + 16px);
    font-size: 9px;
    letter-spacing: 0.04em;
    color: #8a8478;
    transform: translateX(-50%);
  }

  /* ---- paintings ---- */
  .hang {
    position: absolute;
  }
  .work {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: zoom-in;
    position: relative;
    z-index: 2;
    transform-origin: 0 0;
    box-shadow:
      0 1px 1px rgb(30 24 14 / 0.18),
      0 10px 24px -14px rgb(30 24 14 / 0.5);
  }
  .work picture,
  .work img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .work:focus-visible {
    outline: 1px solid rgb(38 36 31 / 0.4);
    outline-offset: 10px;
  }

  .dim {
    position: absolute;
    font-size: 9px;
    letter-spacing: 0.03em;
    color: #6f6a5f;
    white-space: nowrap;
    transition: opacity 0.4s linear;
  }
  .dim b {
    font-weight: 300;
    background: #e9e6df;
    padding: 0 0.6em;
  }
  .dw {
    left: 0;
    right: 0;
    top: -26px;
    height: 9px;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .dw::before,
  .dh::before,
  .dfig::before {
    content: "";
    position: absolute;
    background: var(--line);
    z-index: -1;
  }
  .dw::before {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }
  .dh {
    top: 0;
    bottom: 0;
    right: -26px;
    width: 9px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dh::before,
  .dfig::before {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }
  .dh b,
  .dfig b {
    writing-mode: vertical-rl;
    padding: 0.6em 0;
  }
  .dh,
  .dw,
  .dfig {
    isolation: isolate;
  }

  .tag {
    position: absolute;
    left: 0;
    top: calc(100% + 18px);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    white-space: nowrap;
  }
  .tt {
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 19px;
    line-height: 1;
  }
  .ta {
    font-size: 9px;
    letter-spacing: 0.04em;
    color: #6f6a5f;
  }

  .end {
    position: absolute;
    top: calc(var(--floor) - var(--k) * 160);
    font-family: "Instrument Serif", serif;
    font-size: 30px;
    line-height: 1.1;
    margin: 0;
  }
  .end span {
    font-family: "Martian Mono", monospace;
    font-size: 10px;
    color: #6f6a5f;
  }

  /* ---- the 170 cm figure, walking with you ---- */
  .walker {
    position: absolute;
    left: 7vw;
    top: calc(var(--floor) - var(--k) * 172);
    height: calc(var(--k) * 172);
    width: calc(var(--k) * 52);
    z-index: 3;
    pointer-events: none;
    transition: opacity 0.25s linear;
  }
  .fig {
    display: block;
    width: 100%;
    height: 100%;
    fill: #bdb7ab;
    stroke: #e9e6df;
    stroke-width: 0.9;
    paint-order: stroke;
  }
  .dfig {
    left: -22px;
    top: calc(var(--k) * 2);
    bottom: 0;
    width: 9px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hud {
    position: fixed;
    top: 22px;
    right: 28px;
    font-size: 10px;
    letter-spacing: 0.05em;
    color: #6f6a5f;
    z-index: 5;
    transition: color 0.5s linear;
  }
  .odo b {
    font-weight: 400;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    transition: color 0.5s linear;
  }

  /* ---- opened painting ---- */
  .veil {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100%;
    background: #171613;
    opacity: 0;
    pointer-events: none;
    z-index: 4;
    transition: opacity 0.7s var(--ease);
  }
  body.is-open .veil {
    opacity: 1;
    pointer-events: auto;
    cursor: zoom-out;
  }
  .hang.lifted {
    z-index: 6;
  }
  .hang.lifted .work {
    cursor: zoom-out;
    box-shadow: none;
  }
  body.is-open .walker,
  body.is-open .hang .dim {
    opacity: 0;
  }
  body.is-open .hud {
    color: #77715f;
  }
  body.is-open .odo b {
    color: #d8d2c4;
  }

  .info {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 7;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "t m c" "a r c";
    column-gap: 40px;
    row-gap: 6px;
    align-items: baseline;
    padding: 0 4vw 26px;
    color: #e2dccd;
    visibility: hidden;
    pointer-events: none;
  }
  .info > * {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.25s linear,
      transform 0.4s var(--ease);
  }
  .info.show {
    visibility: visible;
    pointer-events: auto;
  }
  .info.show > * {
    opacity: 1;
    transform: none;
    transition-duration: 0.6s, 0.9s;
    transition-delay: 0.35s;
  }
  .info h2 {
    grid-area: t;
    margin: 0;
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: 34px;
    line-height: 1;
  }
  .ia {
    grid-area: a;
    margin: 0;
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 18px;
    color: #b9b2a2;
  }
  .im,
  .ir {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.02em;
    line-height: 1.6;
    color: #9d9686;
  }
  .im {
    grid-area: m;
  }
  .ir {
    grid-area: r;
  }
  .ir a {
    color: #e2dccd;
    text-decoration: none;
    border-bottom: 1px solid rgb(226 220 205 / 0.35);
  }
  .close {
    grid-area: c;
    align-self: end;
    background: none;
    border: 0;
    color: #e2dccd;
    font: inherit;
    font-size: 10px;
    letter-spacing: 0.04em;
    cursor: pointer;
    padding: 0;
  }
  .close span {
    margin-left: 0.8em;
    color: #77715f;
  }
  .close:focus-visible,
  .ir a:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .info {
      grid-template-columns: 1fr;
      grid-template-areas: "t" "a" "m" "r" "c";
    }
    .walker {
      left: 3vw;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .veil,
    .info > *,
    .walker,
    .dim {
      transition: none !important;
    }
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
  const body = document.body;
  const track = document.getElementById("track")!;
  const world = document.getElementById("world")!;
  const ruler = world.querySelector<HTMLElement>(".ruler")!;
  const end = world.querySelector<HTMLElement>(".end")!;
  const odo = document.getElementById("odo")!;
  const veil = world.querySelector<HTMLElement>(".veil")!;
  const wallEnd = Number(track.dataset.end);
  const hangs = [...document.querySelectorAll<HTMLElement>(".hang")];
  const works = hangs.map((h) => h.querySelector<HTMLButtonElement>(".work")!);
  const infos = [...document.querySelectorAll<HTMLElement>(".info")];

  let k = 3; // px per cm
  let floor = 0;
  let x0 = 0; // screen px where the wall's 0 cm sits at scroll 0
  let span = 0; // horizontal travel in px
  let walkerX = 0;

  const marks: HTMLElement[] = [];
  const layout = () => {
    const vw = innerWidth;
    const vh = innerHeight;
    // fit 230 cm (tallest top edge + dimension line) between floor and the top margin
    floor = vh * 0.84;
    k = Math.max(1.6, (floor - Math.max(70, vh * 0.1)) / 230);
    body.style.setProperty("--k", `${k}px`);
    body.style.setProperty("--floor", `${floor}px`);
    x0 = vw * 0.62 + 70 * k;
    walkerX = vw * (vw < 760 ? 0.03 : 0.07) + 26 * k;
    hangs.forEach((h) => {
      const d = h.dataset;
      h.style.left = `${x0 + Number(d.x) * k}px`;
      h.style.top = `${floor - Number(d.y) * k}px`;
      h.style.width = `${Number(d.w) * k}px`;
      h.style.height = `${Number(d.h) * k}px`;
    });
    const worldW = x0 + wallEnd * k + vw * 0.75;
    world.style.width = `${worldW}px`;
    end.style.left = `${x0 + wallEnd * k + 120 * k}px`;
    // the ruler starts where the paintings' 0 cm is, runs to the end
    // distances are measured from where the figure stands when you arrive
    const metres = Math.ceil((x0 + wallEnd * k + 200 * k - walkerX) / (100 * k));
    ruler.style.left = `${walkerX}px`;
    ruler.style.width = `${metres * 100 * k + 1}px`;
    marks.forEach((m) => m.remove());
    marks.length = 0;
    for (let m = 0; m <= metres; m++) {
      const el = document.createElement("span");
      el.className = "mark";
      el.textContent = `${m} m`;
      el.style.left = `${walkerX + m * 100 * k}px`;
      world.appendChild(el);
      marks.push(el);
    }
    span = worldW - vw;
    track.style.height = `${span + vh}px`;
    // ask for enough pixels for each painting at wall size
    works.forEach((w) => setSizes(w, Math.ceil(w.getBoundingClientRect().width || 400)));
    target = cur = clampScroll(scrollY);
    paint();
  };

  const asked = new WeakMap<HTMLElement, number>();
  const setSizes = (w: HTMLElement, px: number) => {
    if ((asked.get(w) ?? 0) >= px) return;
    asked.set(w, px);
    w.querySelectorAll("source, img").forEach((s) => s.setAttribute("sizes", `${px}px`));
  };
  const clampScroll = (y: number) => Math.max(0, Math.min(span, y));

  // ---- walking: vertical scroll drives a smoothed horizontal camera ----
  let target = 0;
  let cur = 0;
  let raf = 0;
  let last = performance.now();
  const paint = () => {
    world.style.transform = `translate3d(${-cur}px, 0, 0)`;
    veil.style.left = `${cur}px`;
    // distance walked = where the figure stands along the wall
    const cm = cur / k;
    odo.textContent = (cm / 100).toFixed(1);
  };
  const tick = (now: number) => {
    const dt = Math.min(50, now - last);
    last = now;
    cur += (target - cur) * (reduce ? 1 : 1 - Math.exp(-dt / 110));
    if (Math.abs(target - cur) < 0.2) cur = target;
    paint();
    raf = cur !== target ? requestAnimationFrame(tick) : 0;
  };
  addEventListener(
    "scroll",
    () => {
      if (opened >= 0) return;
      // walking away from a painting lets go of it (no focus ring trailing along the wall)
      const a = document.activeElement as HTMLElement | null;
      if (a?.classList.contains("work")) a.blur();
      target = clampScroll(scrollY);
      if (!raf) {
        last = performance.now();
        raf = requestAnimationFrame(tick);
      }
    },
    { passive: true },
  );
  // sideways trackpad swipes walk too
  addEventListener(
    "wheel",
    (e) => {
      if (opened >= 0) {
        if (Math.abs(e.deltaY) + Math.abs(e.deltaX) > 4) close();
        return;
      }
      // there is no horizontal overflow, so sideways swipes can simply be re-routed
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) scrollBy(0, e.deltaX);
    },
    { passive: true },
  );

  // ---- open: lift the painting off the wall to fill the screen ----
  let opened = -1;
  const fit = (i: number) => {
    const vw = innerWidth;
    const vh = innerHeight;
    const ar = Number(works[i].dataset.ar);
    const infoH = vw < 760 ? 220 : 110;
    const mw = vw * 0.92;
    const mh = vh - infoH - vh * 0.07;
    let w = mw;
    let h = w / ar;
    if (h > mh) {
      h = mh;
      w = h * ar;
    }
    return { x: (vw - w) / 2, y: vh * 0.05 + (mh - h) / 2, w, h };
  };
  const open = (i: number) => {
    if (opened >= 0) return;
    opened = i;
    const w = works[i];
    const from = w.getBoundingClientRect();
    const to = fit(i);
    setSizes(w, Math.ceil(to.w));
    const s = to.w / from.width;
    const t = `translate(${to.x - from.left}px, ${to.y - from.top}px) scale(${s})`;
    hangs[i].classList.add("lifted");
    body.classList.add("is-open");
    w.style.transform = t;
    if (!reduce) w.animate([{ transform: "none" }, { transform: t }], { duration: 950, easing: EASE });
    infos[i].classList.add("show");
    infos[i].setAttribute("aria-hidden", "false");
    infos[i].querySelector<HTMLElement>(".close")?.focus({ preventScroll: true });
  };
  const close = () => {
    if (opened < 0) return;
    const i = opened;
    opened = -1;
    const w = works[i];
    const t = w.style.transform;
    w.style.transform = "";
    body.classList.remove("is-open");
    infos[i].classList.remove("show");
    infos[i].setAttribute("aria-hidden", "true");
    const done = () => hangs[i].classList.remove("lifted");
    if (reduce) done();
    else w.animate([{ transform: t }, { transform: "none" }], { duration: 750, easing: EASE }).finished.then(done);
    w.focus({ preventScroll: true });
  };

  works.forEach((w, i) => {
    w.addEventListener("click", (e) => {
      if (e.detail > 0) w.blur();
      opened === i ? close() : open(i);
    });
    // pre-fetch the big version when someone shows intent
    w.addEventListener("pointerenter", () => setSizes(w, Math.ceil(fit(i).w)), { once: true });
    w.addEventListener("focus", () => setSizes(w, Math.ceil(fit(i).w)), { once: true });
  });
  veil.addEventListener("click", close);
  document.querySelectorAll(".close").forEach((b) => b.addEventListener("click", close));

  addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
    else if (opened >= 0 && (e.key === "ArrowRight" || e.key === "ArrowLeft")) {
      // step along the wall while standing close
      const n = (opened + (e.key === "ArrowRight" ? 1 : -1) + works.length) % works.length;
      close();
      const r = hangs[n];
      const want = clampScroll(parseFloat(r.style.left) + parseFloat(r.style.width) / 2 - innerWidth / 2);
      scrollTo({ top: want, behavior: reduce ? "auto" : "smooth" });
    }
  });

  addEventListener("resize", layout);
  document.fonts.ready.then(layout);
  // decode ahead so paintings never flash in empty as they slide on screen
  addEventListener("load", () =>
    works.forEach((w) => w.querySelector("img")?.decode().catch(() => {})),
  );
  layout();
</script>
