---
/**
 * Viewer for the design explorations: a list of every idea on the left and
 * the selected one running live in a frame on the right. Selection lives in
 * the URL hash (/#loupe) so links can point straight at an idea.
 */
import { Image } from "astro:assets";
import { ideaGroups } from "@/data/ideas";

const thumbs = import.meta.glob<{ default: ImageMetadata }>("../../assets/hub/*.jpg", { eager: true });
const thumbFor = (slug: string) => thumbs[`../../assets/hub/${slug}.jpg`]?.default;

const all = ideaGroups.flatMap((g) => g.ideas);
let n = 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ideas — art.artyomkulimov.com</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <aside id="side">
      <header>
        <h1>Sixteen ways<br /><i>to hang a painting</i></h1>
        <p class="mono">Pick one. It runs live on the right.<br />J / K or [ ] to step through · \ to hide this list</p>
      </header>
      <nav>
        {
          ideaGroups.map((g) => (
            <section>
              <h2 class="mono">{g.theme}</h2>
              <ol>
                {g.ideas.map((idea) => {
                  n += 1;
                  const thumb = thumbFor(idea.slug);
                  return (
                    <li>
                      <a href={`#${idea.slug}`} data-slug={idea.slug}>
                        {thumb && <Image src={thumb} alt="" width={240} widths={[120, 240]} sizes="120px" loading="lazy" />}
                        <span class="txt">
                          <span class="name">
                            <span class="mono num">{String(n).padStart(2, "0")}</span>
                            {idea.name}
                          </span>
                          <span class="pitch">{idea.pitch}</span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </section>
          ))
        }
      </nav>
    </aside>

    <main>
      <div class="bar mono">
        <button id="toggle" type="button" aria-label="Show or hide the list">☰</button>
        <span id="cur-name"></span>
        <span id="cur-how" class="how"></span>
        <span class="spacer"></span>
        <button id="prev" type="button" aria-label="Previous idea">←</button>
        <span id="cur-num"></span>
        <button id="next" type="button" aria-label="Next idea">→</button>
        <a id="open" href="#" target="_blank" rel="noopener">Open full screen ↗</a>
      </div>
      <iframe id="frame" title="Idea preview"></iframe>
    </main>

    <script is:inline type="application/json" id="ideas-data" set:html={JSON.stringify(all)} />

    <style>
      * { margin: 0; box-sizing: border-box; }
      :root { --bg: #0d0d0c; --panel: #121211; --line: #262522; --dim: #8b8880; --hi: #f0c27a; }
      html, body { height: 100%; background: var(--bg); }
      body { display: flex; overflow: hidden; font-family: "Instrument Serif", serif; color: #ecebe6; -webkit-font-smoothing: antialiased; }
      .mono { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 0.04em; }
      a { color: inherit; text-decoration: none; }
      button { all: unset; cursor: pointer; padding: 4px 8px; border-radius: 4px; color: var(--dim); }
      button:hover, button:focus-visible { color: #ecebe6; background: #ffffff10; }

      aside { width: 340px; flex: none; height: 100%; overflow-y: auto; background: var(--panel); border-right: 1px solid var(--line); transition: margin-left 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); scrollbar-width: thin; scrollbar-color: #333 transparent; }
      body.hidden aside { margin-left: -340px; }
      header { padding: 28px 24px 20px; border-bottom: 1px solid var(--line); }
      h1 { font-weight: 400; font-size: 34px; line-height: 0.98; letter-spacing: -0.01em; }
      h1 i { color: var(--hi); }
      header p { color: var(--dim); margin-top: 14px; line-height: 1.6; }
      section { padding: 18px 12px 6px; }
      h2 { color: var(--dim); font-weight: 400; text-transform: uppercase; letter-spacing: 0.14em; padding: 0 12px 8px; }
      ol { list-style: none; padding: 0; }
      li a { display: grid; grid-template-columns: 96px 1fr; gap: 12px; align-items: center; padding: 8px 12px; border-radius: 6px; transition: background 0.15s; }
      li a:hover { background: #ffffff08; }
      li a.on { background: #f0c27a14; }
      li a.on .name { color: var(--hi); }
      li img { width: 96px; height: 60px; object-fit: cover; border-radius: 3px; display: block; opacity: 0.85; }
      li a.on img, li a:hover img { opacity: 1; }
      .txt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
      .name { font-size: 21px; line-height: 1.05; display: flex; align-items: baseline; gap: 8px; }
      .num { color: var(--dim); font-size: 10px; }
      .pitch { font-family: "JetBrains Mono", monospace; font-size: 10.5px; line-height: 1.45; color: var(--dim); }

      main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
      .bar { height: 42px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-bottom: 1px solid var(--line); color: var(--dim); }
      #cur-name { color: #ecebe6; font-family: "Instrument Serif", serif; font-size: 19px; letter-spacing: 0; }
      .how { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .spacer { flex: 1; }
      #open { color: var(--hi); padding: 4px 8px; margin-left: 6px; }
      #open:hover { text-decoration: underline; }
      iframe { flex: 1; width: 100%; border: 0; background: #000; }
    </style>

    <script>
      type Idea = { slug: string; name: string; how: string };
      const ideas: Idea[] = JSON.parse(document.getElementById("ideas-data")?.textContent ?? "[]");
      const frame = document.getElementById("frame") as HTMLIFrameElement;
      const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-slug]")];
      const el = (id: string) => document.getElementById(id) as HTMLElement;

      const indexOf = (slug: string) => Math.max(0, ideas.findIndex((i) => i.slug === slug));

      const show = (slug: string) => {
        const i = indexOf(slug);
        const idea = ideas[i];
        const src = `/ideas/${idea.slug}/`;
        if (frame.getAttribute("src") !== src) frame.setAttribute("src", src);
        el("cur-name").textContent = idea.name;
        el("cur-how").textContent = `· ${idea.how}`;
        el("cur-num").textContent = `${String(i + 1).padStart(2, "0")} / ${ideas.length}`;
        (el("open") as HTMLAnchorElement).href = src;
        for (const a of links) a.classList.toggle("on", a.dataset.slug === idea.slug);
        links[i]?.scrollIntoView({ block: "nearest" });
        document.title = `${idea.name} — Ideas`;
      };

      const step = (d: number) => {
        const cur = indexOf(location.hash.slice(1));
        location.hash = ideas[(cur + d + ideas.length) % ideas.length].slug;
      };

      addEventListener("hashchange", () => show(location.hash.slice(1)));
      el("prev").addEventListener("click", () => step(-1));
      el("next").addEventListener("click", () => step(1));
      el("toggle").addEventListener("click", () => document.body.classList.toggle("hidden"));
      addEventListener("keydown", (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === "j" || e.key === "]") step(1);
        else if (e.key === "k" || e.key === "[") step(-1);
        else if (e.key === "\\") document.body.classList.toggle("hidden");
      });
      // Give keyboard focus to the idea once it loads, so its own arrow keys work.
      frame.addEventListener("load", () => frame.contentWindow?.focus());

      show(location.hash.slice(1) || ideas[0].slug);
    </script>
  </body>
</html>
