---
/**
 * title-sequence — the site opens like a film's opening titles.
 * Black, a line of credits, then each painting is shot in a slow Ken Burns
 * move across its details before the camera pulls back and the letterbox
 * opens onto the whole canvas. Everything is driven by one seekable timeline;
 * the camera is drawn into a <canvas> so the drift stays sub-pixel smooth.
 */
import { getImage } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();
const reel = await Promise.all(
  paintings.map(async (p) => {
    const sizes = await Promise.all(
      [1600, 2400, 3200].map(async (w) => {
        const img = await getImage({ src: p.image, width: Math.min(w, p.image.width), format: "webp", quality: 84 });
        return { w: Math.min(w, p.image.width), src: img.src };
      }),
    );
    return {
      id: p.id,
      w: p.image.width,
      h: p.image.height,
      sizes,
      details: p.details.slice(0, 2).map((d) => ({ x: d.x, y: d.y, z: d.zoom, note: d.note })),
    };
  }),
);
const pad = (n: number) => String(n).padStart(2, "0");
---
<Idea title="Title sequence" background="#000">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Jost:wght@300;400&display=swap" rel="stylesheet" />

  <div class="stage" data-stage data-reel={JSON.stringify(reel)}>
    <canvas class="film" data-film aria-hidden="true"></canvas>
    <div class="grade" aria-hidden="true"></div>

    <div class="bar top" data-bar="top"></div>
    <div class="bar bottom" data-bar="bottom">
      <p class="subtitle" data-subtitle aria-live="off"></p>
    </div>

    <!-- opening credit -->
    <div class="card opening" data-card="opening">
      <p class="small" data-line>A collection kept by</p>
      <p class="name" data-line>Artyom Kulimov</p>
    </div>

    {paintings.map((p, i) => (
      <div class="card painting" data-card={i}>
        <p class="small" data-line>{p.artist}</p>
        <h2 class="name" data-line>{p.title}</h2>
        <p class="small year" data-line>{p.year}</p>
      </div>
    ))}

    <!-- end credits for the open frame -->
    {paintings.map((p, i) => (
      <p class="credit" data-credit={i}>
        <span>{p.title}</span> · {p.artist}, {p.year} · {p.medium} · {p.rights} · via {p.source} ·
        <a href={p.original} target="_blank" rel="noopener">original&nbsp;↗</a>
      </p>
    ))}

    <nav class="reelctl" aria-label="Reel">
      <button class="playpause" type="button" data-play aria-label="Pause">
        <span class="i-pause" aria-hidden="true"></span>
      </button>
      <ol class="marks">
        {paintings.map((p, i) => (
          <li>
            <button type="button" data-goto={i} aria-label={`Go to ${p.title}`}>
              <span class="track"><span class="fill" data-fill={i}></span></span>
            </button>
          </li>
        ))}
      </ol>
      <span class="count" data-count>{pad(1)} / {pad(paintings.length)}</span>
    </nav>
  </div>

  <noscript>
    <ul class="fallback">
      {paintings.map((p) => <li><a href={p.original}>{p.title}</a> — {p.artist}, {p.year} · {p.rights}</li>)}
    </ul>
  </noscript>
</Idea>

<style is:global>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #000; }
  body { color: #e8e1d3; font-family: "Jost", sans-serif; font-weight: 300; -webkit-font-smoothing: antialiased; }
</style>

<style>
  .stage { position: fixed; inset: 0; overflow: hidden; cursor: default; }
  .film { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .grade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.42) 100%);
  }

  /* Letterbox: sized to frame a 2.39:1 picture; slides away when the gate opens. */
  .bar {
    --h: max(0px, calc((100vh - 100vw / 2.39) / 2));
    position: absolute;
    left: 0;
    right: 0;
    height: var(--h);
    background: #000;
    will-change: transform;
  }
  .bar.top { top: 0; }
  .bar.bottom { bottom: 0; display: grid; place-items: center; }
  .subtitle {
    margin: 0;
    padding: 0 18vw;
    font-family: "Bodoni Moda", serif;
    font-style: italic;
    font-size: 18px;
    letter-spacing: 0.01em;
    color: #ddd3bf;
    text-align: center;
    opacity: 0;
  }

  .card {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    pointer-events: none;
  }
  .card [data-line] { margin: 0; opacity: 0; will-change: opacity, letter-spacing; }
  .small {
    font-family: "Jost", sans-serif;
    font-weight: 300;
    font-size: 11.5px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: #b8af9c;
    padding-left: 0.5em; /* optically re-centre tracked caps */
  }
  .name {
    font-family: "Bodoni Moda", serif;
    font-weight: 400;
    font-size: clamp(40px, 5.2vw, 78px);
    line-height: 1.05;
    letter-spacing: 0.02em;
    color: #f2ebdd;
    margin: 22px 0 !important;
  }
  .opening .name { font-style: italic; }
  .year { font-size: 11px; }

  .credit {
    position: absolute;
    left: 40px;
    bottom: 30px;
    margin: 0;
    max-width: min(760px, 62vw);
    font-size: 11px;
    line-height: 1.7;
    letter-spacing: 0.08em;
    color: #d9d0bf;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.9), 0 0 2px rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
  }
  .credit span { font-family: "Bodoni Moda", serif; font-style: italic; font-size: 14px; letter-spacing: 0.01em; color: #f2ebdd; }
  .credit a { color: #f2ebdd; text-decoration: none; border-bottom: 1px solid #f2ebdd66; pointer-events: auto; }
  .credit a:hover, .credit a:focus-visible { border-color: #f2ebdd; outline: none; }
  .credit.live { pointer-events: auto; }

  .reelctl {
    position: absolute;
    right: 40px;
    bottom: 30px;
    display: flex;
    align-items: center;
    gap: 16px;
    opacity: 0.55;
    transition: opacity 0.6s;
    text-shadow: 0 1px 10px #000;
  }
  .reelctl:hover, .reelctl:focus-within { opacity: 1; }
  .reelctl button { all: unset; cursor: pointer; display: grid; place-items: center; }
  .reelctl button:focus-visible { outline: 1px solid #e8e1d3; outline-offset: 4px; }
  .playpause { width: 14px; height: 14px; }
  .i-pause { width: 7px; height: 9px; border-left: 1.5px solid #e8e1d3; border-right: 1.5px solid #e8e1d3; box-sizing: border-box; }
  .paused .i-pause { width: 0; height: 0; border: 0; border-left: 8px solid #e8e1d3; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .marks { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .marks button { padding: 8px 0; }
  .track { display: block; width: 34px; height: 1px; background: rgba(232, 225, 211, 0.28); overflow: hidden; }
  .fill { display: block; height: 100%; width: 100%; background: #e8e1d3; transform-origin: 0 50%; transform: scaleX(0); }
  .count { font-size: 10.5px; letter-spacing: 0.24em; color: #d9d0bf; font-variant-numeric: tabular-nums; min-width: 5.4em; text-align: right; }

  .fallback { position: fixed; inset: auto 40px 40px; color: #ccc; font: 14px/1.8 sans-serif; }
  .fallback a { color: #fff; }

  @media (max-width: 700px) {
    .credit { left: 20px; right: 20px; bottom: 64px; max-width: none; }
    .reelctl { right: 20px; bottom: 22px; }
    .subtitle { padding: 0 8vw; font-size: 15px; }
  }
</style>

<script>
  type Detail = { x: number; y: number; z: number; note: string };
  type Reel = { id: string; w: number; h: number; sizes: { w: number; src: string }[]; details: Detail[] };

  const stage = document.querySelector<HTMLElement>("[data-stage]")!;
  const reel: Reel[] = JSON.parse(stage.dataset.reel ?? "[]");
  const canvas = stage.querySelector<HTMLCanvasElement>("[data-film]")!;
  const ctx = canvas.getContext("2d", { alpha: false })!;
  const barTop = stage.querySelector<HTMLElement>('[data-bar="top"]')!;
  const barBottom = stage.querySelector<HTMLElement>('[data-bar="bottom"]')!;
  const subtitle = stage.querySelector<HTMLElement>("[data-subtitle]")!;
  const opening = stage.querySelector<HTMLElement>('[data-card="opening"]')!;
  const cards = reel.map((_, i) => stage.querySelector<HTMLElement>(`[data-card="${i}"]`)!);
  const credits = reel.map((_, i) => stage.querySelector<HTMLElement>(`[data-credit="${i}"]`)!);
  const fills = reel.map((_, i) => stage.querySelector<HTMLElement>(`[data-fill="${i}"]`)!);
  const count = stage.querySelector<HTMLElement>("[data-count]")!;
  const playBtn = stage.querySelector<HTMLButtonElement>("[data-play]")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ------------------------------------------------------------------ timing
  // One painting = one "shot list". Times in seconds from the shot's start.
  const T = {
    cardIn: 0.4, cardOut: 3.9,
    imgIn: 3.3, imgFull: 5.4,
    a0: 3.3, a1: 7.2, b0: 9.5, b1: 12.2, wide: 15.4, end: 18.2,
    subA: [5.0, 7.6], subB: [9.7, 12.5],
    gateOpen: [13.0, 15.6],
    credit: [15.6, 17.8],
    fadeOut: [17.2, 18.2],
  };
  const SHOT = T.end;
  const INTRO = 4.6; // opening credit before the first painting

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const lin = (a: number, b: number, v: number) => clamp((v - a) / (b - a));
  const ease = (t: number) => t * t * (3 - 2 * t);
  const easeIO = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
  /** fade in over [a, a+fi], hold, fade out over [b-fo, b] */
  const window_ = (t: number, a: number, b: number, fi = 0.9, fo = 0.9) =>
    ease(lin(a, a + fi, t)) * (1 - ease(lin(b - fo, b, t)));

  // ------------------------------------------------------------------ camera
  type Key = { t: number; x: number; y: number; lz: number };
  const zoomFor = (d: Detail) => 1 + (d.z - 1) * 0.48; // detail zoom relative to a cover fit

  const pathFor = (r: Reel): Key[] => {
    const [a, b] = [r.details[0] ?? { x: 0.5, y: 0.5, z: 2, note: "" }, r.details[1] ?? r.details[0] ?? { x: 0.5, y: 0.5, z: 2, note: "" }];
    const dirX = Math.sign(b.x - a.x) || 1;
    const za = zoomFor(a);
    const zb = zoomFor(b);
    if (reduced) return [{ t: 0, x: 0.5, y: 0.5, lz: 0 }, { t: SHOT, x: 0.5, y: 0.5, lz: 0 }];
    return [
      { t: T.a0, x: a.x - 0.018 * dirX, y: a.y + 0.01, lz: Math.log(za * 1.06) },
      { t: T.a1, x: a.x + 0.012 * dirX, y: a.y - 0.004, lz: Math.log(za) },
      { t: T.b0, x: b.x - 0.012 * dirX, y: b.y + 0.006, lz: Math.log(zb * 1.04) },
      { t: T.b1, x: b.x + 0.01 * dirX, y: b.y, lz: Math.log(zb) },
      { t: T.wide, x: 0.5, y: 0.5, lz: Math.log(1.0) },
      { t: T.end + 1, x: 0.5, y: 0.5, lz: Math.log(1.04) },
    ];
  };

  /** Cubic Hermite through keys with Catmull-Rom tangents: C1-smooth, seekable. */
  const sample = (keys: Key[], t: number) => {
    if (t <= keys[0].t) return keys[0];
    const last = keys[keys.length - 1];
    if (t >= last.t) return last;
    let i = 0;
    while (keys[i + 1].t < t) i++;
    const k0 = keys[Math.max(0, i - 1)], k1 = keys[i], k2 = keys[i + 1], k3 = keys[Math.min(keys.length - 1, i + 2)];
    const dt = k2.t - k1.t;
    const u = (t - k1.t) / dt;
    // Catmull-Rom tangent, flattened at local extrema so the move never
    // overshoots a mark (an overshoot in zoom would show past the canvas edge).
    const tan = (p: Key, mid: Key, n: Key, f: "x" | "y" | "lz") => {
      if ((mid[f] - p[f]) * (n[f] - mid[f]) <= 0) return 0;
      return ((n[f] - p[f]) / Math.max(1e-6, n.t - p.t)) * dt;
    };
    const h = (f: "x" | "y" | "lz") => {
      // Start the first move from rest so the opening drift eases in.
      const m1 = i === 0 ? 0 : tan(k0, k1, k2, f);
      const m2 = i + 2 >= keys.length ? 0 : tan(k1, k2, k3, f);
      const u2 = u * u, u3 = u2 * u;
      return (2 * u3 - 3 * u2 + 1) * k1[f] + (u3 - 2 * u2 + u) * m1 + (-2 * u3 + 3 * u2) * k2[f] + (u3 - u2) * m2;
    };
    return { t, x: h("x"), y: h("y"), lz: h("lz") };
  };
  const paths = reel.map(pathFor);

  // ------------------------------------------------------------------ images
  const dpr = Math.min(2, devicePixelRatio || 1);
  const bitmaps: (ImageBitmap | HTMLImageElement | null)[] = reel.map(() => null);
  const pickSize = (r: Reel) => {
    const need = innerWidth * dpr * 2.3;
    return r.sizes.find((s) => s.w >= need) ?? r.sizes[r.sizes.length - 1];
  };
  const load = async (i: number) => {
    if (bitmaps[i]) return;
    const img = new Image();
    img.decoding = "async";
    img.src = pickSize(reel[i]).src;
    try {
      await img.decode();
      bitmaps[i] = "createImageBitmap" in window ? await createImageBitmap(img) : img;
    } catch {
      bitmaps[i] = img;
    }
  };
  // First painting first, the rest in order behind it.
  let started = false;
  const first = load(0);
  Promise.all([first, document.fonts.ready]).then(() => setTimeout(() => { started = true; }, 400));
  first.then(() => Promise.all(reel.slice(1).map((_, i) => load(i + 1))));

  // ------------------------------------------------------------------ canvas
  let W = 0, H = 0;
  const resize = () => {
    W = innerWidth;
    H = innerHeight;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
  };
  resize();
  addEventListener("resize", () => { resize(); draw(true); });

  const drawShot = (i: number, local: number, alpha: number) => {
    const bm = bitmaps[i];
    if (!bm || alpha <= 0.001) return;
    const r = reel[i];
    const k = sample(paths[i], local);
    const cover = Math.max(W / r.w, H / r.h);
    const s = cover * Math.exp(Math.max(0, k.lz));
    const vw = W / s, vh = H / s;
    // Keep the frame inside the canvas.
    const cx = clamp(k.x * r.w, vw / 2, r.w - vw / 2);
    const cy = clamp(k.y * r.h, vh / 2, r.h - vh / 2);
    // Source coordinates are in master pixels; scale to the loaded bitmap.
    const bw = "naturalWidth" in bm ? bm.naturalWidth : bm.width;
    const f = bw / r.w;
    ctx.globalAlpha = alpha;
    ctx.drawImage(bm, (cx - vw / 2) * f, (cy - vh / 2) * f, vw * f, vh * f, 0, 0, canvas.width, canvas.height);
    ctx.globalAlpha = 1;
  };

  // ------------------------------------------------------------------ timeline
  // Global time: [0, INTRO) opening credit, then shots back to back, looping.
  const total = INTRO + SHOT * reel.length;
  let t = 0;
  let playing = true;
  let last = performance.now();
  let lastShot = -1;

  const shotAt = (tt: number) => {
    if (tt < INTRO) return { i: -1, local: tt };
    const i = Math.min(reel.length - 1, Math.floor((tt - INTRO) / SHOT));
    return { i, local: tt - INTRO - i * SHOT };
  };

  const setLine = (el: HTMLElement, o: number, spread: number) => {
    el.style.opacity = o.toFixed(3);
    if (el.classList.contains("small")) el.style.letterSpacing = `${(0.46 + spread * 0.08).toFixed(4)}em`;
  };

  const draw = (force = false) => {
    const { i, local } = shotAt(t);

    // opening credit
    const oLines = opening.querySelectorAll<HTMLElement>("[data-line]");
    const op = i === -1 ? local : -1;
    oLines.forEach((el, n) => setLine(el, op < 0 ? 0 : window_(op, 0.5 + n * 0.55, INTRO - 0.2, 1.2, 1.1), clamp(op / INTRO)));

    ctx.fillStyle = "#000";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    if (i >= 0) {
      const fadeIn = ease(lin(T.imgIn, T.imgFull, local));
      const fadeOut = 1 - ease(lin(T.fadeOut[0], T.fadeOut[1], local));
      drawShot(i, local, fadeIn * fadeOut);
    }

    // painting title cards: set on black, the image rises underneath them
    cards.forEach((card, n) => {
      const lines = card.querySelectorAll<HTMLElement>("[data-line]");
      lines.forEach((el, m) => {
        const o = n === i ? window_(local, T.cardIn + m * 0.35, T.cardOut - (2 - m) * 0.12, 1.1, 0.9) : 0;
        setLine(el, o, clamp(local / T.cardOut));
      });
    });

    // subtitles in the letterbox
    if (i >= 0) {
      const d = reel[i].details;
      const sa = window_(local, T.subA[0], T.subA[1], 0.7, 0.7);
      const sb = window_(local, T.subB[0], T.subB[1], 0.7, 0.7);
      const text = sb > 0 ? d[1]?.note ?? "" : d[0]?.note ?? "";
      if (subtitle.textContent !== text) subtitle.textContent = text;
      subtitle.style.opacity = String(Math.max(sa, sb));
    } else {
      subtitle.style.opacity = "0";
    }

    // the gate: letterbox opens with the pull-back, closes again on the cut
    let open = 0;
    if (i >= 0) {
      open = easeIO(lin(T.gateOpen[0], T.gateOpen[1], local)) * (1 - easeIO(lin(T.fadeOut[0] + 0.2, T.end, local)));
    }
    const bh = barTop.offsetHeight;
    barTop.style.transform = `translate3d(0, ${(-open * bh).toFixed(2)}px, 0)`;
    barBottom.style.transform = `translate3d(0, ${(open * bh).toFixed(2)}px, 0)`;

    // end credit for the open frame
    credits.forEach((c, n) => {
      const o = n === i ? window_(local, T.credit[0], T.credit[1], 1.0, 0.8) : 0;
      c.style.opacity = o.toFixed(3);
      c.classList.toggle("live", o > 0.5);
    });

    // reel control
    fills.forEach((f, n) => {
      const p = n < i ? 1 : n === i ? clamp(local / SHOT) : 0;
      f.style.transform = `scaleX(${p.toFixed(4)})`;
    });
    if (i !== lastShot || force) {
      lastShot = i;
      count.textContent = `${String(Math.max(0, i) + 1).padStart(2, "0")} / ${String(reel.length).padStart(2, "0")}`;
    }
  };

  const frame = (now: number) => {
    const dt = Math.min(0.1, (now - last) / 1000);
    last = now;
    if (playing) {
      const { i, local } = shotAt(t);
      // Hold on black until the next painting is decoded (never show a blank fade).
      // The opening credit waits for the type and the first painting, so the
      // whole sequence plays as one piece from black.
      const nextReady = i < 0 ? started && (!!bitmaps[0] || t < INTRO - 0.05) : !!bitmaps[i] || local < T.imgIn - 0.05;
      if (nextReady) t += dt;
      if (t >= total) t = INTRO; // loop the reel, skip the opening credit
    }
    draw();
    requestAnimationFrame(frame);
  };
  requestAnimationFrame((now) => { last = now; frame(now); });

  // ------------------------------------------------------------------ control
  const go = (i: number) => {
    const n = (i + reel.length) % reel.length;
    load(n);
    t = INTRO + n * SHOT; // start of that shot (on black, its title card)
    draw(true);
  };
  const current = () => Math.max(0, shotAt(t).i);
  const setPlaying = (p: boolean) => {
    playing = p;
    stage.querySelector(".reelctl")!.classList.toggle("paused", !p);
    playBtn.setAttribute("aria-label", p ? "Pause" : "Play");
  };

  playBtn.addEventListener("click", (e) => { e.stopPropagation(); setPlaying(!playing); });
  stage.querySelectorAll<HTMLButtonElement>("[data-goto]").forEach((b) =>
    b.addEventListener("click", (e) => { e.stopPropagation(); go(Number(b.dataset.goto)); }),
  );
  stage.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a, button")) return;
    if (shotAt(t).i === -1) go(0);
    else go(current() + 1);
  });
  addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === "ArrowRight" || e.key === "ArrowDown" || e.key === "PageDown") { e.preventDefault(); go(shotAt(t).i === -1 ? 0 : current() + 1); }
    else if (e.key === "ArrowLeft" || e.key === "ArrowUp" || e.key === "PageUp") { e.preventDefault(); go(current() - 1); }
    else if (e.key === " " || e.key === "k") { e.preventDefault(); setPlaying(!playing); }
    else if (e.key === "Home") { e.preventDefault(); t = 0; draw(true); } // from the top: opening credit
  });
  let wheelAcc = 0;
  let wheelLock = 0;
  addEventListener("wheel", (e) => {
    const now = performance.now();
    if (now < wheelLock) return;
    wheelAcc += e.deltaY;
    if (Math.abs(wheelAcc) > 80) {
      go(shotAt(t).i === -1 ? 0 : current() + Math.sign(wheelAcc));
      wheelAcc = 0;
      wheelLock = now + 1100;
    }
  }, { passive: true });
</script>
