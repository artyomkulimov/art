---
/**
 * focus-pull — a vertical reel of paintings shot through a lens.
 * Each painting is out of focus as it approaches, racks sharp at the centre of
 * the frame and drifts soft again as it leaves. The blur is never animated
 * live: two pre-blurred canvases (made once from a small image) are
 * cross-faded under the sharp <picture>, with a little focus breathing.
 */
import { Picture, getImage } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();
const items = await Promise.all(
  paintings.map(async (p) => {
    const small = await getImage({ src: p.image, width: 640, format: "webp", quality: 72 });
    return { p, small: small.src, aspect: p.image.width / p.image.height };
  }),
);
const pad = (n: number) => String(n).padStart(2, "0");
---
<Idea title="Focus pull" background="#0a0908">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />

  <main class="reel" data-reel>
    <section class="shot intro" data-shot data-kind="text">
      <div class="lens-target" data-target>
        <p class="kicker">A collection kept by Artyom Kulimov</p>
        <h1>Paintings, <em>held in focus</em></h1>
        <p class="hint" aria-hidden="true">scroll to pull focus</p>
      </div>
    </section>

    {items.map(({ p, small, aspect }, i) => (
      <section class="shot" data-shot data-kind="painting" style={`--ar:${aspect}`} aria-label={`${p.title}, ${p.artist}, ${p.year}`}>
        <figure class="frame" data-target>
          <div class="plate" data-plate>
            <canvas class="soft soft-far" data-soft="far" aria-hidden="true"></canvas>
            <canvas class="soft soft-near" data-soft="near" aria-hidden="true"></canvas>
            <Picture
              class="sharp"
              src={p.image}
              widths={[960, 1400, 1920, 2560]}
              sizes={`min(78vw, calc(70vh * ${aspect.toFixed(3)}))`}
              formats={["avif", "webp"]}
              alt={`${p.title} by ${p.artist} (${p.year})`}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              decoding="async"
              data-small={small}
            />
          </div>
          <figcaption class="caption" data-caption>
            <span class="num">{pad(i + 1)}</span>
            <span class="title">{p.title}</span>
            <span class="by">{p.artist}, {p.year}</span>
            <span class="meta">
              <span>{p.medium}</span>
              <span>{p.location}</span>
              <span>{p.rights}</span>
              <span>via {p.source} · <a href={p.original} target="_blank" rel="noopener">full resolution&nbsp;↗</a></span>
            </span>
          </figcaption>
        </figure>
      </section>
    ))}

    <section class="shot outro" data-shot data-kind="text">
      <div class="lens-target" data-target>
        <p class="kicker">End of reel</p>
        <p class="closing">{paintings.length} paintings, chosen for no reason<br />other than that they are <em>beautiful</em>.</p>
        <a class="again" href="#top" data-top>back to the first frame ↑</a>
      </div>
    </section>
  </main>

  <aside class="ring" aria-hidden="true">
    <div class="ring-track" data-ring></div>
    <span class="ring-index"></span>
  </aside>
</Idea>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { scrollbar-width: none; }
  html::-webkit-scrollbar { display: none; }
  body {
    margin: 0;
    background: #0a0908;
    color: #e9e2d4;
    font-family: "DM Mono", ui-monospace, monospace;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: #e9e2d4; color: #0a0908; }
</style>

<style>
  .reel { position: relative; }

  .shot {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 6vh 0;
  }
  .shot + .shot { margin-top: -4vh; }

  /* ---------- text shots ---------- */
  .lens-target { text-align: center; will-change: filter, opacity; }
  .kicker, .hint, .again {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #a59c8b;
  }
  .kicker { margin: 0 0 30px; }
  h1, .closing {
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    margin: 0;
    color: #efe8da;
  }
  h1 { font-size: clamp(56px, 8.4vw, 132px); line-height: 0.92; letter-spacing: -0.02em; }
  h1 em, .closing em { font-style: italic; color: #d9b98c; }
  .hint { margin: 46px 0 0; color: #6d665a; }
  .closing { font-size: clamp(30px, 3.4vw, 50px); line-height: 1.12; }
  .again { display: inline-block; margin-top: 40px; color: #8d8574; text-decoration: none; border-bottom: 1px solid #3a352d; padding-bottom: 6px; }
  .again:hover, .again:focus-visible { color: #efe8da; border-color: #efe8da; outline: none; }

  /* ---------- painting shots ---------- */
  .frame {
    --w: min(78vw, calc(70vh * var(--ar)));
    width: var(--w);
    margin: 0;
  }
  .plate {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ar);
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .plate :global(picture), .plate :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .plate :global(img) { object-fit: cover; }
  .plate :global(picture) { will-change: opacity; }
  .soft {
    position: absolute;
    /* canvases carry a margin so the blur can bleed past the frame edge */
    inset: -14% -14%;
    width: 128%;
    height: 128%;
    opacity: 0;
    will-change: opacity;
    pointer-events: none;
  }

  .caption {
    display: grid;
    grid-template-columns: 54px 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 0;
    align-items: baseline;
    margin-top: 26px;
    will-change: filter, opacity;
  }
  .num { grid-row: 1 / 3; font-size: 11px; letter-spacing: 0.12em; color: #7c7466; padding-top: 4px; }
  .title {
    font-family: "Instrument Serif", serif;
    font-size: clamp(30px, 2.7vw, 42px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: #f1eadc;
    white-space: nowrap;
  }
  .by {
    grid-column: 2;
    font-family: "Instrument Serif", serif;
    font-style: italic;
    font-size: 19px;
    color: #b9ae99;
    margin-top: 8px;
  }
  .meta {
    grid-column: 3;
    grid-row: 1 / 3;
    align-self: end;
    text-align: right;
    justify-self: end;
    display: flex;
    flex-direction: column;
    padding-left: 24px;
    font-size: 10.5px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: #7f776a;
  }
  .meta > span { white-space: nowrap; }
  .meta a { color: #c9b48f; text-decoration: none; border-bottom: 1px solid #c9b48f55; }
  .meta a:hover, .meta a:focus-visible { color: #f1eadc; border-color: #f1eadc; outline: none; }

  /* ---------- focus ring (a lens distance scale) ---------- */
  .ring {
    position: fixed;
    right: 26px;
    top: 0;
    bottom: 0;
    width: 52px;
    pointer-events: none;
    overflow: hidden;
    mask-image: linear-gradient(transparent, #000 30%, #000 70%, transparent);
  }
  .ring-track { position: absolute; left: 0; right: 0; top: 50%; will-change: transform; }
  .ring :global(.tick) {
    position: absolute;
    right: 0;
    height: 1px;
    width: 7px;
    background: #4d473e;
  }
  .ring :global(.tick.major) { width: 14px; background: #8b8272; }
  .ring :global(.tick b) {
    position: absolute;
    right: 22px;
    top: -6px;
    font: 400 9.5px/1 "DM Mono", monospace;
    letter-spacing: 0.06em;
    color: #8b8272;
    white-space: nowrap;
  }
  .ring-index {
    position: absolute;
    right: 0;
    top: 50%;
    width: 20px;
    height: 1px;
    background: #d9b98c;
    box-shadow: 0 0 6px #d9b98c88;
  }

  @media (max-width: 760px) {
    .frame { --w: 92vw; }
    .caption { grid-template-columns: 36px 1fr; }
    .meta { grid-column: 2; grid-row: 3; text-align: left; margin-top: 14px; }
    .meta > span { white-space: normal; }
    .ring { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .soft { display: none; }
    .plate, .caption, .lens-target { will-change: auto; }
  }
</style>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const shots = [...document.querySelectorAll<HTMLElement>("[data-shot]")];

  type Shot = {
    el: HTMLElement;
    kind: string;
    target: HTMLElement;
    plate?: HTMLElement;
    sharp?: HTMLElement;
    far?: HTMLCanvasElement;
    near?: HTMLCanvasElement;
    caption?: HTMLElement;
    focus: number;
    ready: boolean;
  };

  const state: Shot[] = shots.map((el) => ({
    el,
    kind: el.dataset.kind ?? "text",
    target: el.querySelector<HTMLElement>("[data-target]")!,
    plate: el.querySelector<HTMLElement>("[data-plate]") ?? undefined,
    sharp: el.querySelector<HTMLElement>("picture") ?? undefined,
    far: el.querySelector<HTMLCanvasElement>('[data-soft="far"]') ?? undefined,
    near: el.querySelector<HTMLCanvasElement>('[data-soft="near"]') ?? undefined,
    caption: el.querySelector<HTMLElement>("[data-caption]") ?? undefined,
    focus: 1,
    ready: false,
  }));

  // ---- Pre-blur: paint two soft versions of each painting once, from a small image.
  const MARGIN = 0.14 / 1.28; // canvas inset as a fraction of canvas size (see CSS)
  const paintSoft = (canvas: HTMLCanvasElement, img: HTMLImageElement, width: number, blurFrac: number) => {
    const ar = img.naturalWidth / img.naturalHeight;
    const cw = Math.round(width * 1.28);
    const ch = Math.round((width / ar) * 1.28);
    canvas.width = cw;
    canvas.height = ch;
    const ctx = canvas.getContext("2d");
    if (!ctx) return false;
    const blur = Math.max(1, width * blurFrac);
    ctx.filter = `blur(${blur}px)`;
    const x = cw * MARGIN;
    const y = ch * MARGIN;
    ctx.drawImage(img, x, y, cw - 2 * x, ch - 2 * y);
    // A second, softer pass: out-of-focus highlights spread more than shadows.
    ctx.globalAlpha = 0.35;
    ctx.globalCompositeOperation = "lighter";
    ctx.filter = `blur(${blur * 2.2}px) brightness(0.55)`;
    ctx.drawImage(img, x, y, cw - 2 * x, ch - 2 * y);
    return true;
  };

  if (!reduced) {
    for (const s of state) {
      if (s.kind !== "painting" || !s.sharp) continue;
      const src = s.sharp.querySelector("img")?.dataset.small;
      if (!src) continue;
      const img = new Image();
      img.decoding = "async";
      img.src = src;
      img.decode().then(() => {
        paintSoft(s.far!, img, 220, 0.03);
        paintSoft(s.near!, img, 560, 0.0055);
        s.ready = true;
        tick(true);
      }).catch(() => {});
    }
  }

  // ---- Focus ring: a lens distance scale that turns as you scroll.
  const ring = document.querySelector<HTMLElement>("[data-ring]")!;
  const distances = ["∞", "30", "15", "10", "7", "5", "4", "3", "2.5", "2", "1.7", "1.5", "1.3", "1.2", "1.1", "1 m"];
  const STEP = 64;
  for (let i = 0; i < distances.length * 4; i++) {
    const major = i % 4 === 0;
    const t = document.createElement("i");
    t.className = major ? "tick major" : "tick";
    t.style.top = `${(i * STEP) / 4}px`;
    if (major) {
      const b = document.createElement("b");
      b.textContent = distances[i / 4];
      t.appendChild(b);
    }
    ring.appendChild(t);
  }

  // ---- Focus model.
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const smooth = (a: number, b: number, v: number) => {
    const t = clamp((v - a) / (b - a));
    return t * t * (3 - 2 * t);
  };

  let last = performance.now();
  let running = false;

  function tick(force = false) {
    const now = performance.now();
    const dt = Math.min(64, now - last);
    last = now;
    const vh = innerHeight;
    let moving = false;

    for (const s of state) {
      const r = s.target.getBoundingClientRect();
      const d = Math.abs(r.top + r.height / 2 - vh / 2) / vh;
      // Sharp plateau around the centre, a quick rack, then a long soft tail.
      const want = 1 - smooth(0.075, 0.4, d);
      // The focus puller follows a beat behind the camera.
      const k = 1 - Math.exp(-dt / 110);
      s.focus += (want - s.focus) * k;
      if (Math.abs(want - s.focus) > 0.002) moving = true;
      else s.focus = want;
      if (r.bottom < -vh * 0.5 || r.top > vh * 1.5) continue;
      apply(s);
    }

    // Ring turns with the scroll, slowed so it reads as a mechanical scale.
    ring.style.transform = `translate3d(0, ${-(scrollY * 0.22) % (STEP * distances.length * 2)}px, 0)`;

    if (moving || force) {
      if (!running) {
        running = true;
        requestAnimationFrame(loop);
      }
    }
  }

  function loop() {
    running = false;
    tick();
  }

  function apply(s: Shot) {
    const f = reduced ? 1 : s.focus;
    const blurPx = (1 - f) * 7;
    if (s.kind === "text") {
      s.target.style.filter = blurPx > 0.05 ? `blur(${blurPx.toFixed(2)}px)` : "";
      s.target.style.opacity = String(0.22 + 0.78 * f);
      return;
    }
    if (!s.plate) return;
    // Focus breathing: the image grows a touch as it goes soft.
    s.plate.style.transform = `scale(${(1 + (1 - f) * 0.045).toFixed(4)})`;
    if (s.ready && s.far && s.near && s.sharp) {
      const near = smooth(0.15, 0.55, f) * (1 - smooth(0.8, 0.96, f));
      const sharp = smooth(0.45, 0.88, f);
      const far = 1 - smooth(0.55, 0.85, f);
      s.far.style.opacity = far.toFixed(3);
      s.near.style.opacity = near.toFixed(3);
      s.sharp.style.opacity = sharp.toFixed(3);
    }
    // Out of focus also means out of the light: fade towards the dark ground.
    s.plate.style.opacity = (0.5 + 0.5 * smooth(0, 0.9, f)).toFixed(3);
    if (s.caption) {
      const cb = (1 - f) * 5;
      s.caption.style.filter = cb > 0.05 ? `blur(${cb.toFixed(2)}px)` : "";
      s.caption.style.opacity = (0.12 + 0.88 * smooth(0.25, 0.95, f)).toFixed(3);
    }
  }

  // Start everything at its resting focus so nothing animates in on load.
  {
    const vh = innerHeight;
    for (const s of state) {
      const r = s.target.getBoundingClientRect();
      const d = Math.abs(r.top + r.height / 2 - vh / 2) / vh;
      s.focus = 1 - smooth(0.075, 0.4, d);
      apply(s);
    }
  }

  // When the hand leaves the wheel near a mark, ease the last few pixels onto it,
  // so a painting at rest is always pin-sharp.
  let settleTimer = 0;
  let settling = false;
  const settle = () => {
    const i = nearestIndex();
    const y = centreOf(shots[i]);
    const off = Math.abs(y - scrollY);
    if (off > 2 && off < innerHeight * 0.16 && y >= 0 && y <= document.documentElement.scrollHeight - innerHeight) {
      settling = true;
      scrollTo({ top: y, behavior: reduced ? "auto" : "smooth" });
    }
  };
  addEventListener("scroll", () => {
    tick(true);
    clearTimeout(settleTimer);
    if (!settling) settleTimer = window.setTimeout(settle, 260);
  }, { passive: true });
  addEventListener("scrollend", () => { settling = false; });
  addEventListener("wheel", () => { settling = false; }, { passive: true });
  addEventListener("resize", () => tick(true));

  // Keyboard: J/K or arrows step shot to shot, like a focus puller hitting marks.
  const centreOf = (el: HTMLElement) => {
    const r = el.querySelector<HTMLElement>("[data-target]")!.getBoundingClientRect();
    return scrollY + r.top + r.height / 2 - innerHeight / 2;
  };
  const nearestIndex = () => {
    let best = 0;
    let bestD = Infinity;
    shots.forEach((el, i) => {
      const d = Math.abs(centreOf(el) - scrollY);
      if (d < bestD) { bestD = d; best = i; }
    });
    return best;
  };
  addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    let dir = 0;
    if (e.key === "ArrowDown" || e.key === "j" || e.key === "PageDown" || (e.key === " " && !e.shiftKey)) dir = 1;
    if (e.key === "ArrowUp" || e.key === "k" || e.key === "PageUp" || (e.key === " " && e.shiftKey)) dir = -1;
    if (!dir) return;
    e.preventDefault();
    const i = clamp(nearestIndex() + dir, 0, shots.length - 1);
    scrollTo({ top: centreOf(shots[i]), behavior: reduced ? "auto" : "smooth" });
  });
  document.querySelector("[data-top]")?.addEventListener("click", (e) => {
    e.preventDefault();
    scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
  });

  tick(true);
</script>
