---
/**
 * palette-strips — the collection as a fan of paint chips.
 * Each painting is a vertical band of its own colour: the painting averaged
 * row by row, so the band is literally the picture with its shapes taken out.
 * Hover and the band opens like an accordion while the picture resolves out
 * of its colour through progressively finer smears (1 → 5 → 28 columns → the
 * painting). Click and it opens edge to edge, the chip's label carrying the
 * credits.
 */
import { Picture, getImage } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();
const items = await Promise.all(
  paintings.map(async (p) => {
    const sample = await getImage({ src: p.image, width: 192, format: "webp", quality: 80 });
    const ar = p.image.width / p.image.height;
    // Server-side first paint: the palette as a soft vertical gradient.
    const stops = p.palette.map((c, i) => `${c} ${Math.round((i / Math.max(1, p.palette.length - 1)) * 100)}%`).join(", ");
    return { p, ar, sample: sample.src, gradient: `linear-gradient(180deg, ${stops})` };
  }),
);
const pad = (n: number) => String(n).padStart(2, "0");
---
<Idea title="Palette strips" background="#0d0c0b">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet" />

  <main class="fan" data-fan>
    {items.map(({ p, ar, sample, gradient }, i) => (
      <article class="band" data-band data-id={p.id} style={`--ar:${ar.toFixed(4)}; --ground:${p.palette[0]}; --ssr:${gradient}`}>
        <button class="field" type="button" data-open aria-label={`Open ${p.title}`}>
          <span class="stack" data-stack>
            <Picture
              class="paint"
              src={p.image}
              widths={[800, 1200, 1600, 2000, 2600]}
              sizes="100vw"
              formats={["avif", "webp"]}
              alt={`${p.title} by ${p.artist} (${p.year})`}
              loading="eager"
              decoding="async"
              data-sample={sample}
            />
            <canvas class="lvl lvl-3" data-cols="28" aria-hidden="true"></canvas>
            <canvas class="lvl lvl-2" data-cols="5" aria-hidden="true"></canvas>
            <canvas class="lvl lvl-1" data-cols="1" aria-hidden="true"></canvas>
          </span>
        </button>

        <footer class="label">
          <div class="id">
            <span class="no">{pad(i + 1)}</span>
            <h2 class="title">{p.title}</h2>
            <p class="by">{p.artist}, {p.year}</p>
          </div>
          <dl class="facts">
            <div><dt>Medium</dt><dd>{p.medium}</dd></div>
            <div><dt>Held</dt><dd>{p.location}</dd></div>
            <div><dt>Rights</dt><dd>{p.rights}</dd></div>
            <div><dt>Source</dt><dd>{p.source} · <a href={p.original} target="_blank" rel="noopener">full resolution ↗</a></dd></div>
          </dl>
          <ul class="swatches" aria-label="Palette">
            {p.palette.map((c) => (
              <li><i style={`background:${c}`}></i><code>{c.replace("#", "").toUpperCase()}</code></li>
            ))}
          </ul>
        </footer>
      </article>
    ))}

    <p class="mast" aria-hidden="false">Artyom Kulimov <span>— paintings, by their colour</span></p>
    <button class="close" type="button" data-close aria-label="Close painting">
      <span>Close</span> <kbd>esc</kbd>
    </button>
  </main>
</Idea>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: #0d0c0b; }
  body { overflow: hidden; font-family: "Schibsted Grotesk", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
</style>

<style>
  .fan {
    --label: 118px;
    --paper: #eeeae1;
    --ink: #1b1916;
    --ease: cubic-bezier(0.77, 0, 0.18, 1);
    position: fixed;
    inset: 0;
    display: flex;
    background: var(--paper);
  }

  .band {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* a collapsed chip must vanish completely, labels and all */
    transition: flex-grow 1.05s var(--ease);
  }
  .band + .band { border-left: 1px solid rgba(27, 25, 22, 0.14); }
  .band.hot { flex-grow: 2.5; }
  .fan.has-open .band:not(.open) {
    flex-grow: 0;
    border-left-width: 0;
    visibility: hidden;
    /* hide only once fully folded, so no 1px sliver of chip survives at the edge */
    transition: flex-grow 1.05s var(--ease), border-left-width 0s 1.05s, visibility 0s 1.05s;
  }
  .fan.has-open .band.open { flex-grow: 1; border-left-color: transparent; }

  /* ---------- the colour field / window onto the painting ---------- */
  .field {
    all: unset;
    position: relative;
    flex: 1;
    overflow: hidden;
    cursor: pointer;
    background: var(--ground);
  }
  .field:focus-visible { outline: 2px solid var(--paper); outline-offset: -6px; }
  .fan.has-open .field { cursor: default; }

  /* The painting is always sized to cover the full-width field, so the band
     opening is a window widening, never the picture rescaling. */
  .stack {
    --fh: calc(100vh - var(--label));
    --sw: max(100vw, calc(var(--fh) * var(--ar)));
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--sw);
    height: calc(var(--sw) / var(--ar));
    transform: translate(-50%, -50%);
    background: var(--ssr);
  }
  .stack :global(picture), .stack :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .stack :global(img.paint) {
    object-fit: cover;
    opacity: 0;
    transform: scale(1.035);
    transition: transform 2.2s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s;
  }
  .band.ready :global(img.paint) { opacity: 1; }
  .band.hot :global(img.paint), .band.open :global(img.paint) { transform: scale(1); }

  .lvl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    will-change: opacity, transform;
  }
  .band.ready .lvl { opacity: 1; }
  /* Returning to colour: quick, finest smear first. */
  .lvl-3 { transition: opacity 0.5s ease 0s, transform 0.9s var(--ease); }
  .lvl-2 { transition: opacity 0.55s ease 0.12s, transform 0.9s var(--ease); }
  .lvl-1 { transition: opacity 0.6s ease 0.26s, transform 0.9s var(--ease); }
  /* Blooming out of colour: field → wide smear → fine smear → paint. */
  .band.hot .lvl-1, .band.open .lvl-1 { opacity: 0; transition: opacity 0.75s ease 0.12s; }
  .band.hot .lvl-2, .band.open .lvl-2 { opacity: 0; transform: scaleX(1.18); transition: opacity 0.85s ease 0.5s, transform 1.4s var(--ease) 0.1s; }
  .band.hot .lvl-3, .band.open .lvl-3 { opacity: 0; transform: scaleX(1.06); transition: opacity 0.95s ease 0.92s, transform 1.6s var(--ease) 0.3s; }

  /* ---------- the chip label ---------- */
  .label {
    position: relative;
    height: var(--label);
    flex: none;
    padding: 18px 22px 0;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }
  .id { min-width: 0; }
  .no { font: 400 10.5px/1 "IBM Plex Mono", monospace; letter-spacing: 0.08em; color: #8a8478; }
  .title {
    margin: 9px 0 0;
    font-weight: 600;
    font-size: 23px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    /* a narrow chip lets the name run out like paint off a card, not "…" */
    mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent);
  }
  .by { margin: 5px 0 0; font-size: 13px; color: #5d5850; white-space: nowrap; overflow: hidden; mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent); }

  .swatches { position: absolute; right: 22px; top: 16px; display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .swatches li { position: relative; }
  .swatches i { display: block; width: 13px; height: 13px; }
  .band.hot .swatches { gap: 8px; }
  .band.hot .swatches i { width: 30px; height: 18px; }
  .swatches code { position: absolute; left: 0; top: calc(100% + 6px); font: 400 8.5px/1 "IBM Plex Mono", monospace; letter-spacing: 0.04em; color: #8a8478; white-space: nowrap; }
  .band:not(.hot):not(.open) .swatches code { opacity: 0; }
  .swatches code { transition: opacity 0.5s; }

  .facts {
    position: absolute;
    left: 34%;
    right: 300px;
    top: 18px;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 34px;
    font-size: 12px;
    line-height: 1.35;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.4s, transform 0.4s;
  }
  .facts dt { font: 400 9.5px/1 "IBM Plex Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; color: #8a8478; margin-bottom: 4px; }
  .facts dd { margin: 0; color: #2c2925; }
  .facts a { color: var(--ink); text-decoration: none; border-bottom: 1px solid currentColor; }
  .facts a:hover, .facts a:focus-visible { color: #8a4a1c; outline: none; }
  .band.open .facts { opacity: 1; transform: none; pointer-events: auto; transition: opacity 0.6s 0.7s, transform 0.8s var(--ease) 0.6s; }
  .band.open .title { font-size: 30px; transition: font-size 0.6s var(--ease) 0.4s; }
  .title { transition: font-size 0.4s var(--ease); }
  .band.open .swatches { gap: 8px; }
  .band.open .swatches i { width: 44px; height: 40px; transition: width 0.6s var(--ease) 0.5s, height 0.6s var(--ease) 0.5s; }
  .swatches i { transition: width 0.6s var(--ease), height 0.6s var(--ease); }
  .swatches { transition: gap 0.6s var(--ease); }

  /* ---------- chrome ---------- */
  .mast {
    position: absolute;
    left: 22px;
    top: 18px;
    margin: 0;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: #f1ede5;
    mix-blend-mode: difference;
    pointer-events: none;
    transition: opacity 0.6s;
  }
  .mast span { font-weight: 400; font-style: italic; opacity: 0.75; }
  .fan.has-open .mast { opacity: 0; }

  .close {
    all: unset;
    position: absolute;
    right: 22px;
    top: 16px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    background: var(--paper);
    cursor: pointer;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.4s, transform 0.4s;
  }
  .close kbd { font: 400 9.5px/1 "IBM Plex Mono", monospace; color: #8a8478; margin-left: 6px; }
  .close:focus-visible { outline: 1px solid rgba(238, 234, 225, 0.55); outline-offset: 3px; }
  .fan.has-open .close { opacity: 1; transform: none; pointer-events: auto; transition-delay: 0.8s; }

  @media (max-width: 760px) {
    .fan { --label: 96px; }
    .swatches { display: none; }
    .facts { left: 22px; right: 22px; top: auto; bottom: 10px; grid-template-columns: 1fr; }
    .band.open .label { height: 240px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .band, .lvl, .stack :global(img.paint), .facts, .title, .swatches i { transition-duration: 0.01s !important; transition-delay: 0s !important; }
  }
</style>

<script>
  const fan = document.querySelector<HTMLElement>("[data-fan]")!;
  const bands = [...fan.querySelectorAll<HTMLElement>("[data-band]")];
  const closeBtn = fan.querySelector<HTMLButtonElement>("[data-close]")!;

  // ---- Build the colour layers from a small sample of each painting.
  // A layer with C columns holds the average colour of every (column, row)
  // cell; stretched to the band, 1 column is a pure vertical gradient and 28
  // columns is a horizontal smear the eye can almost read.
  const buildLayers = async (band: HTMLElement) => {
    const img = band.querySelector<HTMLImageElement>("img.paint");
    const src = img?.dataset.sample;
    if (!src) return;
    const sample = new Image();
    sample.src = src;
    await sample.decode();
    const w = sample.naturalWidth;
    const h = sample.naturalHeight;
    const scratch = document.createElement("canvas");
    scratch.width = w;
    scratch.height = h;
    const sctx = scratch.getContext("2d", { willReadFrequently: true })!;
    sctx.drawImage(sample, 0, 0);
    const px = sctx.getImageData(0, 0, w, h).data;

    for (const canvas of band.querySelectorAll<HTMLCanvasElement>("canvas[data-cols]")) {
      const cols = Number(canvas.dataset.cols);
      const rows = h;
      canvas.width = cols;
      canvas.height = rows;
      const ctx = canvas.getContext("2d")!;
      const out = ctx.createImageData(cols, rows);
      // Pure averages go muddy; give the coarsest layers a little of the
      // saturation they lose in the mix, so the field reads as pigment.
      const boost = cols === 1 ? 1.45 : cols < 10 ? 1.25 : 1.08;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x0 = Math.floor((c * w) / cols);
          const x1 = Math.max(x0 + 1, Math.floor(((c + 1) * w) / cols));
          let R = 0, G = 0, B = 0, n = 0;
          // average over a few rows too, to keep the gradient silky
          for (let rr = Math.max(0, r - 1); rr <= Math.min(h - 1, r + 1); rr++) {
            for (let x = x0; x < x1; x++) {
              const k = (rr * w + x) * 4;
              // average in linear-ish light so highlights aren't swallowed
              R += px[k] * px[k]; G += px[k + 1] * px[k + 1]; B += px[k + 2] * px[k + 2];
              n++;
            }
          }
          let r_ = Math.sqrt(R / n), g_ = Math.sqrt(G / n), b_ = Math.sqrt(B / n);
          const l = 0.299 * r_ + 0.587 * g_ + 0.114 * b_;
          r_ = l + (r_ - l) * boost; g_ = l + (g_ - l) * boost; b_ = l + (b_ - l) * boost;
          const o = (r * cols + c) * 4;
          out.data[o] = r_; out.data[o + 1] = g_; out.data[o + 2] = b_; out.data[o + 3] = 255;
        }
      }
      ctx.putImageData(out, 0, 0);
    }
  };

  // Don't reveal anything until both the colour and the picture are ready, so
  // the first hover always blooms into a fully loaded painting.
  bands.forEach((band) => {
    const img = band.querySelector<HTMLImageElement>("img.paint");
    const picture = img ? (img.complete ? Promise.resolve() : img.decode().catch(() => {})) : Promise.resolve();
    Promise.all([buildLayers(band).catch(() => {}), picture]).then(() => band.classList.add("ready"));
  });

  // ---- Accordion + open.
  let open: HTMLElement | null = null;
  const setHot = (band: HTMLElement | null) => {
    if (open) return;
    bands.forEach((b) => b.classList.toggle("hot", b === band));
  };
  const openBand = (band: HTMLElement) => {
    open = band;
    bands.forEach((b) => {
      b.classList.toggle("open", b === band);
      b.classList.toggle("hot", false);
      b.querySelector<HTMLButtonElement>("[data-open]")!.tabIndex = b === band ? -1 : 0;
    });
    fan.classList.add("has-open");
    history.replaceState(null, "", `#${band.dataset.id}`);
    closeBtn.focus({ preventScroll: true });
  };
  const closeBand = () => {
    if (!open) return;
    const was = open;
    open = null;
    fan.classList.remove("has-open");
    bands.forEach((b) => {
      b.classList.remove("open");
      b.querySelector<HTMLButtonElement>("[data-open]")!.tabIndex = 0;
    });
    history.replaceState(null, "", location.pathname);
    // keep the one you were looking at warm, so it settles back gently
    setHot(was);
    was.querySelector<HTMLButtonElement>("[data-open]")!.focus({ preventScroll: true });
  };

  bands.forEach((band) => {
    const btn = band.querySelector<HTMLButtonElement>("[data-open]")!;
    band.addEventListener("pointerenter", () => setHot(band));
    btn.addEventListener("focus", () => setHot(band));
    btn.addEventListener("click", () => (open === band ? undefined : openBand(band)));
  });
  fan.addEventListener("pointerleave", () => setHot(null));
  closeBtn.addEventListener("click", closeBand);

  addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeBand();
    if (!open) return;
    const i = bands.indexOf(open);
    if (e.key === "ArrowRight") openBand(bands[(i + 1) % bands.length]);
    if (e.key === "ArrowLeft") openBand(bands[(i - 1 + bands.length) % bands.length]);
  });

  // Deep link: /ideas/palette-strips/#pandemonium opens straight onto it.
  const fromHash = bands.find((b) => `#${b.dataset.id}` === location.hash);
  if (fromHash) openBand(fromHash);
</script>
