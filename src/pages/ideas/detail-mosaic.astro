---
import Idea from "@/layouts/Idea.astro";
import { getWorks } from "@/ideas/detail-mosaic/works";
import { tiles, COLS, ROWS, LEGEND } from "@/ideas/detail-mosaic/tiles";

const works = await getWorks();
const index = Object.fromEntries(works.map((w, i) => [w.id, i]));
const placed = tiles.map((t) => ({ ...t, p: index[t.id] }));
---
<Idea title="Detail mosaic" background="#050505">
  {works.map((w) => <link slot="head" rel="preload" as="image" href={w.full} />)}
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Familjen+Grotesk:wght@400;500&display=swap"
  />

  <main class="dm" id="dm">
    <div class="dm-grid" id="dm-grid" style={`--cols:${COLS};--rows:${ROWS}`}>
      {
        placed.map((t, k) => (
          <button
            class="dm-tile"
            data-k={k}
            data-p={t.p}
            style={`grid-area:${t.r} / ${t.c} / span ${t.h} / span ${t.w};--c:${works[t.p].palette[1]};--d:${(k * 37) % 9}`}
            data-w={t.w}
            data-h={t.h}
            aria-label={`${works[t.p].title}${t.note ? ` — ${t.note}` : ""}. Open the whole painting.`}
          >
            <img src={works[t.p].full} alt="" width={works[t.p].w} height={works[t.p].h} decoding="async" draggable="false" />
          </button>
        ))
      }
      <div class="dm-legend" id="dm-legend" style={`grid-area:${LEGEND.r} / ${LEGEND.c} / span ${LEGEND.h} / span ${LEGEND.w}`} aria-live="polite">
        <div class="dm-legend-rest">
          <span class="dm-kicker">Artyom Kulimov</span>
          <p class="dm-lede"><em>Paintings,</em> closely.</p>
          <span class="dm-small">{placed.length} fragments<br />of {works.length} paintings</span>
        </div>
        <div class="dm-legend-hover" aria-hidden="true">
          <span class="dm-kicker" id="dm-h-artist"></span>
          <p class="dm-lede"><em id="dm-h-title"></em></p>
          <span class="dm-small" id="dm-h-note"></span>
        </div>
      </div>
    </div>

    <div class="dm-view" id="dm-view" aria-hidden="true">
      {
        works.map((w, i) => (
          <div class="dm-full" data-p={i} style={`width:${w.w}px;height:${w.h}px`}>
            <img src={w.full} alt={`${w.title}, ${w.artist}, ${w.year}`} width={w.w} height={w.h} decoding="async" draggable="false" />
          </div>
        ))
      }
      <div class="dm-mark" id="dm-mark" aria-hidden="true"></div>
      <section class="dm-info" id="dm-info" role="dialog" aria-modal="true" aria-labelledby="dm-title">
        <div class="dm-info-l">
          <h1 id="dm-title"></h1>
          <p class="dm-meta"><span id="dm-artist"></span><i>·</i><span id="dm-year"></span><i>·</i><span id="dm-medium"></span><i>·</i><span id="dm-location"></span></p>
        </div>
        <div class="dm-info-r">
          <p class="dm-meta"><span id="dm-rights"></span><i>·</i><span id="dm-source"></span><i>·</i><a id="dm-original" target="_blank" rel="noreferrer">Full resolution ↗</a></p>
          <button class="dm-back" id="dm-back"><kbd>Esc</kbd> Back to the fragments</button>
        </div>
      </section>
    </div>
  </main>

  <script id="dm-data" type="application/json" set:html={JSON.stringify({ works, tiles: placed })} />

  <style is:global>
    html,
    body {
      margin: 0;
      height: 100%;
      overflow: hidden;
      background: #050505;
      color: #efe9dd;
      -webkit-font-smoothing: antialiased;
    }
    .dm {
      position: fixed;
      inset: 0;
      font-family: "Familjen Grotesk", system-ui, sans-serif;
      word-spacing: 0.14em;
    }
    .dm-grid {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: repeat(var(--cols), 1fr);
      grid-template-rows: repeat(var(--rows), 1fr);
      gap: 1px;
      background: #050505;
    }
    .dm-tile {
      position: relative;
      overflow: hidden;
      padding: 0;
      border: 0;
      margin: 0;
      background: var(--c);
      cursor: zoom-out;
      outline: none;
      transition: opacity 0.6s cubic-bezier(0.3, 0, 0.2, 1);
    }
    .dm-tile img {
      position: absolute;
      left: 0;
      top: 0;
      max-width: none;
      transform-origin: 0 0;
      opacity: 0;
      user-select: none;
      pointer-events: none;
    }
    .dm-tile.ready img {
      opacity: 1;
      transition: opacity 1.1s ease calc(var(--d) * 70ms);
    }
    .dm-tile::after {
      content: "";
      position: absolute;
      inset: 0;
      box-shadow: inset 0 0 0 1px rgba(255, 250, 240, 0);
      transition: box-shadow 0.4s ease;
      pointer-events: none;
    }
    .dm-tile:focus-visible::after {
      box-shadow: inset 0 0 0 1px rgba(255, 250, 240, 0.8);
    }
    .dm-grid.peek .dm-tile {
      opacity: 0.28;
    }
    .dm-grid.peek .dm-tile.kin {
      opacity: 1;
    }

    /* The single black cell: a wordmark that becomes a legend on hover. */
    .dm-legend {
      position: relative;
      background: #050505;
      padding: 22px 22px 20px;
      overflow: hidden;
    }
    .dm-legend-rest,
    .dm-legend-hover {
      position: absolute;
      inset: 22px 22px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition:
        opacity 0.45s ease,
        transform 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
    }
    .dm-legend-hover {
      opacity: 0;
      transform: translateY(8px);
    }
    .dm.peeking .dm-legend-rest {
      opacity: 0;
      transform: translateY(-8px);
    }
    .dm.peeking .dm-legend-hover {
      opacity: 1;
      transform: none;
    }
    .dm-kicker,
    .dm-small {
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(239, 233, 221, 0.5);
      line-height: 1.5;
    }
    .dm-small {
      letter-spacing: 0.08em;
      text-transform: none;
      font-size: 11px;
    }
    .dm-lede {
      margin: 0;
      font-family: "Bodoni Moda", serif;
      font-size: clamp(22px, 2.3vw, 36px);
      line-height: 1.02;
      letter-spacing: -0.01em;
    }
    .dm-lede em {
      font-style: italic;
    }

    /* The opened painting. */
    .dm-view {
      position: absolute;
      inset: 0;
      visibility: hidden;
      pointer-events: none;
      cursor: zoom-in;
    }
    .dm.open .dm-view {
      visibility: visible;
      pointer-events: auto;
    }
    .dm-full {
      position: absolute;
      left: 0;
      top: 0;
      transform-origin: 0 0;
      visibility: hidden;
      will-change: transform, clip-path;
      backface-visibility: hidden;
    }
    .dm-full.on {
      visibility: visible;
    }
    .dm-full img {
      display: block;
      width: 100%;
      height: 100%;
    }
    .dm-mark {
      position: absolute;
      left: 0;
      top: 0;
      border: 1px solid rgba(255, 250, 240, 0.85);
      opacity: 0;
      pointer-events: none;
    }
    .dm-info {
      position: absolute;
      left: 48px;
      right: 48px;
      bottom: 34px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 40px;
      pointer-events: none;
    }
    .dm-info > div > * {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.35s ease,
        transform 0.35s ease;
    }
    .dm.settled .dm-info > div > * {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.9s ease,
        transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: auto;
    }
    .dm.settled .dm-info .dm-meta {
      transition-delay: 0.12s;
    }
    .dm.settled .dm-info-r > * {
      transition-delay: 0.22s;
    }
    .dm-info h1 {
      margin: 0 0 10px;
      font-family: "Bodoni Moda", serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(30px, 3.3vw, 50px);
      line-height: 1;
      letter-spacing: -0.015em;
    }
    .dm-meta {
      margin: 0;
      font-size: 12px;
      letter-spacing: 0.02em;
      color: rgba(239, 233, 221, 0.62);
      line-height: 1.6;
    }
    .dm-meta i {
      font-style: normal;
      margin: 0 0.6em;
      opacity: 0.5;
    }
    .dm-info-r {
      text-align: right;
      flex-shrink: 0;
      max-width: 46%;
    }
    .dm-meta a {
      color: #efe9dd;
      text-decoration: none;
      border-bottom: 1px solid rgba(239, 233, 221, 0.35);
    }
    .dm-meta a:hover,
    .dm-meta a:focus-visible {
      border-color: #efe9dd;
      outline: none;
    }
    .dm-back {
      margin-top: 10px;
      font: inherit;
      font-size: 11px;
      letter-spacing: 0.06em;
      color: rgba(239, 233, 221, 0.5);
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
    }
    .dm-back kbd {
      font: inherit;
      font-size: 9.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      border: 1px solid rgba(239, 233, 221, 0.3);
      border-radius: 3px;
      padding: 2px 5px;
      margin-right: 8px;
    }
    .dm-back:hover,
    .dm-back:focus-visible {
      color: #efe9dd;
      outline: none;
    }

    @media (max-width: 760px) {
      .dm-grid {
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: none;
        grid-auto-rows: 25vw;
        grid-auto-flow: dense;
        overflow-y: auto;
      }
      .dm-tile,
      .dm-legend {
        grid-area: auto !important;
      }
      .dm-tile[data-w="2"],
      .dm-tile[data-w="3"] {
        grid-column: span 2 !important;
      }
      .dm-tile[data-h="2"] {
        grid-row: span 2 !important;
      }
      .dm-legend {
        grid-column: span 2 !important;
      }
      .dm-info {
        left: 20px;
        right: 20px;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
      .dm-info-r {
        text-align: left;
        max-width: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .dm-tile.ready img {
        transition-delay: 0s;
      }
    }
  </style>

  <script>
    import "@/ideas/detail-mosaic/main";
  </script>
</Idea>
