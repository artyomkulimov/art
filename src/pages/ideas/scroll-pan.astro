---
import Idea from "@/layouts/Idea.astro";
import { getWorks } from "@/ideas/scroll-pan/works";

const works = await getWorks();
const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];
---
<Idea title="Scroll pan" background="#000">
  <link slot="head" rel="preload" as="image" href={works[0].full} fetchpriority="high" />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..500&family=Libre+Caslon+Display&family=Libre+Caslon+Text:ital@0;1&display=swap"
  />

  <div class="sp-track" id="sp-track"></div>

  <main class="sp" id="sp">
    <div class="sp-stage" aria-hidden="true">
      {
        works.map((w, i) => (
          <div class="sp-layer" data-i={i} style={`width:${w.w}px;height:${w.h}px`}>
            <img class="sp-tiny" src={w.tiny} alt="" />
            <img
              class="sp-full"
              src={i === 0 ? w.full : undefined}
              data-src={w.full}
              alt=""
              width={w.w}
              height={w.h}
              decoding="async"
              fetchpriority={i === 0 ? "high" : "low"}
            />
          </div>
        ))
      }
    </div>
    <div class="sp-shade" aria-hidden="true"></div>

    <header class="sp-top">
      <span>Artyom Kulimov</span>
      <span class="sp-chapter" id="sp-chapter">I <i>/</i> {ROMAN[works.length - 1]}</span>
    </header>

    <!-- One caption per detail; the active one is lit by the scroll position. -->
    <div class="sp-captions" aria-live="polite">
      {
        works.map((w, i) =>
          w.details.map((d, k) => (
            <p class="sp-cap" data-i={i} data-k={k}>
              <span class="sp-cap-n">
                {ROMAN[i]}.{k + 1}
              </span>
              <span class="sp-cap-t">{d.note}</span>
            </p>
          )),
        )
      }
    </div>

    {
      works.map((w, i) => (
        <section class="sp-info" data-i={i} aria-label={w.title}>
          <p class="sp-kicker">
            {ROMAN[i]} <i>—</i> {w.artist}, {w.year}
          </p>
          <h2 class="sp-title">{w.title}</h2>
          <p class="sp-meta">
            {w.medium}
            <i>·</i>
            {w.location}
            <br />
            {w.rights}
            <i>·</i>
            {w.source}
            <i>·</i>
            <a href={w.original} target="_blank" rel="noreferrer">
              Full resolution ↗
            </a>
          </p>
        </section>
      ))
    }

    <nav class="sp-rail" id="sp-rail" aria-label="Progress">
      <span class="sp-rail-dot" id="sp-dot"></span>
    </nav>

    <p class="sp-hint" id="sp-hint" aria-hidden="true">Scroll <span></span></p>
    <h1 class="sp-sr">Paintings, travelled through by scrolling</h1>
  </main>

  <script id="sp-data" type="application/json" set:html={JSON.stringify(works)} />

  <style is:global>
    html {
      background: #000;
      scrollbar-width: none;
    }
    html::-webkit-scrollbar {
      display: none;
    }
    body {
      margin: 0;
      color: #f1ebdf;
      -webkit-font-smoothing: antialiased;
      font-family: "Archivo", system-ui, sans-serif;
    }
    .sp-sr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .sp-track {
      width: 1px;
    }
    .sp {
      position: fixed;
      inset: 0;
      overflow: hidden;
    }
    .sp-stage {
      position: absolute;
      inset: 0;
    }
    .sp-layer {
      position: absolute;
      left: 0;
      top: 0;
      transform-origin: 0 0;
      opacity: 0;
      will-change: transform, opacity;
      backface-visibility: hidden;
      contain: strict;
    }
    .sp-layer img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    .sp-full {
      opacity: 0;
      transition: opacity 0.8s ease;
    }
    .sp-full.ready {
      opacity: 1;
    }
    .sp-shade {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.12) 24%, transparent 40%),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.48), rgba(0, 0, 0, 0.1) 10%, transparent 18%);
    }

    .sp-top {
      position: absolute;
      top: 26px;
      left: 40px;
      right: 40px;
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      font-stretch: 85%;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(241, 235, 223, 0.68);
      text-shadow: 0 0 14px rgba(0, 0, 0, 0.6), 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .sp-chapter i {
      font-style: normal;
      opacity: 0.5;
      margin: 0 0.3em;
    }

    /* Detail captions: subtitles for the camera. */
    .sp-cap {
      position: absolute;
      left: 40px;
      bottom: 42px;
      margin: 0;
      display: flex;
      align-items: baseline;
      gap: 18px;
      max-width: 62vw;
      pointer-events: none;
      text-shadow: 0 0 20px rgba(0, 0, 0, 0.6), 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .sp-cap-n {
      font-size: 12px;
      font-stretch: 85%;
      letter-spacing: 0.14em;
      color: rgba(241, 235, 223, 0.72);
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    .sp-cap-t {
      font-family: "Libre Caslon Text", serif;
      font-style: italic;
      font-size: 24px;
      line-height: 1.2;
      color: #f6f0e5;
      clip-path: inset(0 100% 0 0);
      transition: clip-path 0.55s cubic-bezier(0.6, 0, 0.4, 1);
    }
    .sp-cap.on .sp-cap-n {
      opacity: 1;
      transition-delay: 0.1s;
    }
    .sp-cap.on .sp-cap-t {
      clip-path: inset(0 0 0 0);
      transition: clip-path 1.3s cubic-bezier(0.25, 0.8, 0.2, 1) 0.15s;
    }

    /* The painting, named, once the camera pulls back. */
    .sp-info {
      position: absolute;
      left: 40px;
      right: 120px;
      bottom: 38px;
      pointer-events: none;
      text-shadow: 0 0 18px rgba(0, 0, 0, 0.55);
    }
    .sp-info > * {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.4s ease,
        transform 0.5s ease;
    }
    .sp-info.on > * {
      opacity: 1;
      transform: none;
      transition:
        opacity 1s ease,
        transform 1.3s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: auto;
    }
    .sp-info.on .sp-title {
      transition-delay: 0.08s;
    }
    .sp-info.on .sp-meta {
      transition-delay: 0.22s;
    }
    .sp-kicker {
      margin: 0 0 12px;
      font-size: 11px;
      font-stretch: 85%;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(241, 235, 223, 0.7);
    }
    .sp-kicker i,
    .sp-meta i {
      font-style: normal;
      margin: 0 0.55em;
      opacity: 0.5;
    }
    .sp-title {
      margin: 0 0 14px;
      font-family: "Libre Caslon Display", serif;
      font-weight: 400;
      font-size: clamp(40px, 5vw, 76px);
      line-height: 0.98;
      letter-spacing: -0.01em;
    }
    .sp-meta {
      margin: 0;
      font-size: 12px;
      font-stretch: 92%;
      line-height: 1.7;
      color: rgba(241, 235, 223, 0.62);
    }
    .sp-meta a {
      color: #f1ebdf;
      text-decoration: none;
      border-bottom: 1px solid rgba(241, 235, 223, 0.35);
    }
    .sp-meta a:hover,
    .sp-meta a:focus-visible {
      border-color: #f1ebdf;
      outline: none;
    }

    /* A timeline rail: one tick per stop, a gap between paintings. */
    .sp-rail {
      position: absolute;
      right: 34px;
      top: 50%;
      height: 46vh;
      width: 20px;
      transform: translateY(-50%);
    }
    .sp-rail-tick {
      position: absolute;
      right: 0;
      height: 1px;
      width: 7px;
      background: rgba(241, 235, 223, 0.45);
      box-shadow: 0 0 3px rgba(0, 0, 0, 0.5);
      border: 0;
      padding: 0;
      cursor: pointer;
      transition:
        width 0.4s ease,
        background 0.4s ease;
    }
    .sp-rail-tick.full {
      width: 13px;
    }
    .sp-rail-tick.past {
      background: rgba(241, 235, 223, 0.75);
    }
    .sp-rail-tick::before {
      content: "";
      position: absolute;
      inset: -6px -4px;
    }
    .sp-rail-tick:hover,
    .sp-rail-tick:focus-visible {
      background: #fff;
      outline: none;
    }
    .sp-rail-dot {
      position: absolute;
      right: 0;
      top: 0;
      width: 20px;
      height: 1px;
      background: #f1ebdf;
      transform-origin: right;
    }

    .sp-hint {
      position: absolute;
      right: 76px;
      bottom: 44px;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 10.5px;
      font-stretch: 85%;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(241, 235, 223, 0.55);
      transition: opacity 0.8s ease;
    }
    .sp-hint span {
      display: block;
      width: 1px;
      height: 24px;
      background: rgba(241, 235, 223, 0.6);
      transform-origin: top;
      animation: sp-drop 2.2s cubic-bezier(0.6, 0, 0.3, 1) infinite;
    }
    .sp-hint.gone {
      opacity: 0;
    }
    @keyframes sp-drop {
      0% {
        transform: scaleY(0);
        transform-origin: top;
      }
      50% {
        transform: scaleY(1);
        transform-origin: top;
      }
      51% {
        transform-origin: bottom;
      }
      100% {
        transform: scaleY(0);
        transform-origin: bottom;
      }
    }

    @media (max-width: 760px) {
      .sp-top {
        left: 20px;
        right: 20px;
      }
      .sp-cap,
      .sp-info {
        left: 20px;
        right: 48px;
        max-width: none;
      }
      .sp-cap {
        flex-direction: column;
        gap: 6px;
      }
      .sp-cap-t {
        font-size: 20px;
      }
      .sp-rail {
        right: 14px;
      }
      .sp-hint {
        display: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .sp-cap-t,
      .sp-cap.on .sp-cap-t {
        transition: none;
      }
      .sp-hint span {
        animation: none;
      }
    }
  </style>

  <script>
    import "@/ideas/scroll-pan/main";
  </script>
</Idea>
