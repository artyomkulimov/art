---
/**
 * curtain — the painting is revealed through an aperture.
 * A hairline of light draws across the dark, parts into a slit that carries
 * the title, then the blades open to the whole painting. Scroll and the
 * shutter closes to a line, and reopens on the next.
 *
 * The aperture is four black blades moved with transforms only (no animated
 * clip-path), so it stays smooth even on slow machines.
 */
import { Picture } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();
const pad = (n: number) => String(n).padStart(2, "0");
// The slit opens across the painting's own horizon: the mean height of its
// points of interest, kept near the middle of the screen.
const slitY = (p: (typeof paintings)[number]) => {
  const ys = p.details.map((d) => d.y);
  const m = ys.length ? ys.reduce((a, b) => a + b, 0) / ys.length : 0.5;
  return Math.min(0.62, Math.max(0.38, m));
};
---

<Idea title="Curtain" background="#050404">
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Newsreader:ital,opsz,wght@1,6..72,300;1,6..72,400&display=swap" />

  <main class="theatre" aria-roledescription="carousel" aria-label="Paintings">
    {
      paintings.map((p, i) => {
        const aspect = p.image.width / p.image.height;
        return (
          <figure class:list={["plate", { "is-current": i === 0 }]} data-index={i} data-slit={slitY(p).toFixed(3)} aria-hidden={i === 0 ? "false" : "true"}>
            <Picture
              src={p.image}
              alt={`${p.title}, ${p.artist}, ${p.year}`}
              widths={[960, 1440, 1920, 2560, 3200]}
              sizes={`max(100vw, ${Math.ceil(aspect * 100)}vh)`}
              formats={["avif", "webp"]}
              quality={72}
              loading="eager"
              decoding="async"
              fetchpriority={i === 0 ? "high" : "low"}
            />
            <div class="dim" />
            <div class="slate" aria-hidden="true">
              <span class="meta meta-l">
                No.&thinsp;{pad(i + 1)}
                <span class="sep">/</span>
                {p.artist}
              </span>
              <span class="name">{p.title}</span>
              <span class="meta meta-r">{p.year}</span>
            </div>
          </figure>
        )
      })
    }
  </main>

  <div class="blades" aria-hidden="true">
    <div class="blade blade-t"></div>
    <div class="blade blade-b"></div>
    <div class="blade blade-l"></div>
    <div class="blade blade-r"></div>
  </div>

  <footer class="rail" aria-live="polite">
    {
      paintings.map((p, i) => (
        <div class:list={["line", { "is-current": i === 0 }]} data-index={i}>
          <span class="n">
            {pad(i + 1)}/{pad(paintings.length)}
          </span>
          <span class="t">
            <em>{p.title}</em> — {p.artist}, {p.year}
          </span>
          <span class="m">{p.medium}</span>
          <span class="r">
            {p.rights} · {p.source}
          </span>
          <a href={p.original} target="_blank" rel="noopener">
            Original ↗
          </a>
        </div>
      ))
    }
  </footer>

  <p class="hint" aria-hidden="true">Scroll</p>

  <style is:global>
    html,
    body {
      margin: 0;
      height: 100%;
      overflow: hidden;
      background: #050404;
    }
    body {
      -webkit-font-smoothing: antialiased;
    }
    body.is-idle {
      cursor: none;
    }
  </style>

  <style>
    :root {
      --ink: #efe8dc;
      --night: #050404;
    }
    .theatre {
      position: fixed;
      inset: 0;
      overflow: hidden;
    }
    .plate {
      position: absolute;
      inset: 0;
      margin: 0;
      visibility: hidden;
    }
    .plate.is-current {
      visibility: visible;
    }
    .plate :global(picture),
    .plate :global(img) {
      display: block;
      width: 100%;
      height: 100%;
    }
    .plate :global(img) {
      object-fit: cover;
      transform: scale(var(--zoom, 1));
      transform-origin: 50% var(--slit-y, 50%);
      will-change: transform;
    }
    .dim {
      position: absolute;
      inset: 0;
      background: rgb(5 4 4 / 0.55);
      opacity: var(--dim, 1);
    }

    /* ---- the slate: what you read through the slit ---- */
    .slate {
      position: absolute;
      left: 0;
      right: 0;
      top: var(--slit-y, 50%);
      transform: translateY(-50%);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 32px;
      padding: 0 40px;
      color: var(--ink);
      opacity: var(--slate, 0);
    }
    .name {
      font-family: "Newsreader", Georgia, serif;
      font-style: italic;
      font-weight: 300;
      font-size: clamp(30px, 3.6vw, 54px);
      line-height: 1;
      letter-spacing: calc(var(--track, 0) * 1em - 0.01em);
      white-space: nowrap;
      font-variation-settings: "opsz" 72;
    }
    .meta {
      font-family: "Fragment Mono", ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      white-space: nowrap;
      opacity: 0.8;
    }
    .meta-r {
      justify-self: end;
    }
    .sep {
      margin: 0 0.7em;
      opacity: 0.45;
    }

    /* ---- shutter blades ---- */
    .blades {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 2;
    }
    .blade {
      position: absolute;
      background: var(--night);
      will-change: transform;
    }
    .blade-t,
    .blade-b {
      left: -2px;
      right: -2px;
      height: 100vh;
      z-index: 2;
    }
    .blade-t {
      top: 0;
    }
    .blade-b {
      top: 0;
    }
    /* The lit edge of a blade: a hairline that catches the light from the slit. */
    .blade-t::after,
    .blade-b::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgb(239 232 220 / 0.32) 22%, rgb(239 232 220 / 0.32) 78%, transparent);
    }
    .blade-t::after {
      bottom: 0;
    }
    .blade-b::after {
      top: 0;
    }
    /* Side blades sit above, so the lit edges only show where the slit is open. */
    .blade-l,
    .blade-r {
      top: 0;
      width: 100vw;
      height: 100vh;
      z-index: 3;
    }
    .blade-l {
      left: 0;
    }
    .blade-r {
      left: 0;
    }

    /* ---- caption rail (appears with the mouse once the shutter is open) ---- */
    .rail {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 3;
      padding: 60px 32px 22px;
      background: linear-gradient(to top, rgb(5 4 4 / 0.7), rgb(5 4 4 / 0.25) 55%, transparent);
      color: var(--ink);
      font-family: "Fragment Mono", ui-monospace, monospace;
      font-size: 11px;
      letter-spacing: 0.06em;
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 1200ms cubic-bezier(0.4, 0, 0.2, 1),
        transform 1200ms cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
    }
    body.is-open.is-awake .rail {
      opacity: 1;
      transform: none;
      transition-duration: 500ms;
      pointer-events: auto;
    }
    .line {
      display: none;
      align-items: baseline;
      gap: 28px;
    }
    .line.is-current {
      display: flex;
    }
    .line em {
      font-family: "Newsreader", Georgia, serif;
      font-size: 17px;
      letter-spacing: 0;
      font-weight: 400;
    }
    .line .n,
    .line .m,
    .line .r {
      opacity: 0.6;
    }
    .line .r {
      margin-left: auto;
    }
    .line a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid rgb(239 232 220 / 0.4);
    }
    .line a:hover,
    .line a:focus-visible {
      border-color: var(--ink);
      outline: none;
    }

    .hint {
      position: fixed;
      left: 50%;
      bottom: 26px;
      z-index: 3;
      margin: 0;
      transform: translateX(-50%);
      color: var(--ink);
      font-family: "Fragment Mono", ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      opacity: 0;
      transition: opacity 1400ms ease;
      pointer-events: none;
    }
    body.show-hint.is-open:not(.is-awake) .hint {
      opacity: 0.45;
    }

    @media (max-width: 760px) {
      .slate {
        grid-template-columns: 1fr;
        justify-items: center;
        gap: 8px;
        padding: 0 16px;
      }
      .meta-r {
        justify-self: center;
      }
      .line {
        flex-wrap: wrap;
        gap: 4px 16px;
      }
      .line .m {
        display: none;
      }
      .line .r {
        margin-left: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .blades {
        display: none;
      }
      .plate {
        visibility: visible;
        opacity: 0;
        transition: opacity 500ms ease;
      }
      .plate.is-current {
        opacity: 1;
      }
      .dim,
      .slate {
        display: none;
      }
      .rail {
        opacity: 1;
        transform: none;
        pointer-events: auto;
      }
    }
  </style>

  <script>
    const plates = [...document.querySelectorAll<HTMLElement>(".plate")];
    const lines = [...document.querySelectorAll<HTMLElement>(".rail .line")];
    const bt = document.querySelector<HTMLElement>(".blade-t")!;
    const bb = document.querySelector<HTMLElement>(".blade-b")!;
    const bl = document.querySelector<HTMLElement>(".blade-l")!;
    const br = document.querySelector<HTMLElement>(".blade-r")!;
    const body = document.body;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ---------- easing ---------- */
    type Ease = (t: number) => number;
    const outExpo: Ease = (t) => (t >= 1 ? 1 : 1 - 2 ** (-10 * t));
    const inOutQuart: Ease = (t) => (t < 0.5 ? 8 * t ** 4 : 1 - (-2 * t + 2) ** 4 / 2);
    const inQuart: Ease = (t) => t ** 4;
    // A mechanical stop: fast travel, a whisker of overshoot, settle.
    const detent: Ease = (t) => {
      const c = 0.9;
      const u = t - 1;
      return 1 + (c + 1) * u ** 3 + c * u ** 2;
    };

    /* ---------- aperture state (px) ---------- */
    const st = { cy: innerHeight / 2, half: 0, wide: 0 }; // slit centre, half-height, half-width
    const render = () => {
      const W = innerWidth;
      const H = innerHeight;
      const top = st.cy - st.half;
      const bot = st.cy + st.half;
      bt.style.transform = `translate3d(0, ${top - H}px, 0)`;
      bb.style.transform = `translate3d(0, ${bot}px, 0)`;
      bl.style.transform = `translate3d(${W / 2 - st.wide - W}px, 0, 0)`;
      br.style.transform = `translate3d(${W / 2 + st.wide}px, 0, 0)`;
    };

    const tween = (ms: number, ease: Ease, step: (k: number) => void) =>
      new Promise<void>((resolve) => {
        const t0 = performance.now();
        const frame = (now: number) => {
          const t = Math.min(1, (now - t0) / ms);
          step(ease(t));
          render();
          if (t < 1) requestAnimationFrame(frame);
          else resolve();
        };
        requestAnimationFrame(frame);
      });
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const lerp = (a: number, b: number, k: number) => a + (b - a) * k;

    /* ---------- per-plate visual knobs ---------- */
    const setPlate = (el: HTMLElement, v: { dim?: number; slate?: number; zoom?: number; track?: number }) => {
      if (v.dim !== undefined) el.style.setProperty("--dim", v.dim.toFixed(3));
      if (v.slate !== undefined) el.style.setProperty("--slate", v.slate.toFixed(3));
      if (v.zoom !== undefined) el.style.setProperty("--zoom", v.zoom.toFixed(4));
      if (v.track !== undefined) el.style.setProperty("--track", v.track.toFixed(4));
    };

    const slitHalf = () => Math.round(Math.min(64, Math.max(40, innerHeight * 0.062)));
    const slitCentre = (el: HTMLElement) => innerHeight * Number(el.dataset.slit || 0.5);

    let current = 0;
    let busy = false;
    let queued: number | null = null;
    let skipHold: (() => void) | null = null;

    const ready = (el: HTMLElement) => {
      const img = el.querySelector("img");
      return img ? img.decode().catch(() => undefined) : Promise.resolve();
    };

    /* ---------- the choreography ---------- */
    const open = async (i: number) => {
      const el = plates[i];
      const W = innerWidth;
      el.style.setProperty("--slit-y", `${(Number(el.dataset.slit) * 100).toFixed(1)}%`);
      setPlate(el, { dim: 1, slate: 0, zoom: 1.08, track: 0.08 });
      st.cy = slitCentre(el);
      st.half = 0.5;
      st.wide = 0;
      render();
      body.classList.remove("is-open");

      // 1. a hairline of light draws outward from the centre
      await ready(el);
      await tween(900, outExpo, (k) => (st.wide = (W / 2 + 4) * k));
      // 2. the slit parts, the title condenses inside it
      const h = slitHalf();
      const slate = tween(1300, outExpo, (k) => setPlate(el, { slate: k, track: lerp(0.08, 0, k) }));
      await tween(820, detent, (k) => (st.half = lerp(0.5, h, k)));
      await slate;
      // 3. hold — long enough to read; a scroll or click cuts it short
      await Promise.race([sleep(1500), new Promise<void>((r) => (skipHold = r))]);
      skipHold = null;
      // 4. full aperture
      const from = st.cy;
      const H = innerHeight;
      const reach = Math.max(from, H - from) + 4;
      tween(500, (t) => t, (k) => setPlate(el, { slate: 1 - k }));
      await tween(1500, inOutQuart, (k) => {
        st.half = lerp(h, reach, k);
        setPlate(el, { dim: 1 - k, zoom: lerp(1.08, 1, k) });
      });
      body.classList.add("is-open");
    };

    const close = async (i: number) => {
      const el = plates[i];
      const W = innerWidth;
      body.classList.remove("is-open");
      const start = st.half;
      // blades fall back to a line, slightly faster than they opened
      await tween(1050, inOutQuart, (k) => {
        st.half = lerp(start, 0.5, k);
        setPlate(el, { dim: k * 0.8, zoom: lerp(1, 1.03, k) });
      });
      await tween(420, inQuart, (k) => (st.wide = lerp(W / 2 + 4, 0, k)));
      st.half = 0;
      render();
    };

    const go = async (next: number) => {
      const n = plates.length;
      next = ((next % n) + n) % n;
      if (next === current) return;
      if (busy) {
        // cut a lingering slit short, remember the request
        queued = next;
        skipHold?.();
        return;
      }
      busy = true;
      if (reduced) {
        swap(next);
      } else {
        await close(current);
        await sleep(220);
        swap(next);
        await open(current);
      }
      busy = false;
      if (queued !== null && queued !== current) {
        const q = queued;
        queued = null;
        go(q);
      } else queued = null;
    };

    const swap = (next: number) => {
      plates.forEach((el, i) => {
        el.classList.toggle("is-current", i === next);
        el.setAttribute("aria-hidden", String(i !== next));
      });
      lines.forEach((el, i) => el.classList.toggle("is-current", i === next));
      current = next;
    };

    /* ---------- input ---------- */
    let lastWheel = 0;
    let armed = true;
    let acc = 0;
    addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        const now = performance.now();
        if (now - lastWheel > 180) {
          armed = true;
          acc = 0;
        }
        lastWheel = now;
        if (!armed) return;
        acc += Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (Math.abs(acc) > 24) {
          armed = false;
          go(current + Math.sign(acc));
        }
      },
      { passive: false },
    );
    addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (["ArrowRight", "ArrowDown", "PageDown", " "].includes(e.key)) go(current + 1);
      else if (["ArrowLeft", "ArrowUp", "PageUp"].includes(e.key)) go(current - 1);
      else if (e.key === "Enter") skipHold?.();
      else if (e.key === "i") {
        body.classList.toggle("is-awake");
        return;
      } else return;
      e.preventDefault();
    });
    addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      skipHold?.();
    });
    let touchY: number | null = null;
    addEventListener("touchstart", (e) => (touchY = e.touches[0].clientY), { passive: true });
    addEventListener("touchend", (e) => {
      if (touchY === null) return;
      const dy = touchY - e.changedTouches[0].clientY;
      touchY = null;
      if (Math.abs(dy) > 40) go(current + Math.sign(dy));
      else wake();
    });

    // caption rail: surfaces with the mouse, sinks when still
    let idle = 0;
    const wake = () => {
      body.classList.add("is-awake");
      body.classList.remove("is-idle");
      clearTimeout(idle);
      idle = window.setTimeout(() => {
        if (document.querySelector(".rail a:hover, .rail :focus-visible")) return wake();
        body.classList.remove("is-awake");
        if (body.classList.contains("is-open")) body.classList.add("is-idle");
      }, 2200);
    };
    let last = { x: -1, y: -1 };
    addEventListener("pointermove", (e) => {
      if (Math.abs(e.clientX - last.x) + Math.abs(e.clientY - last.y) < 3) return;
      last = { x: e.clientX, y: e.clientY };
      wake();
    });
    addEventListener("focusin", wake);

    addEventListener("resize", () => {
      if (!busy && body.classList.contains("is-open")) {
        st.cy = innerHeight / 2;
        st.half = innerHeight;
        st.wide = innerWidth;
      }
      render();
    });

    /* ---------- curtain up ---------- */
    if (reduced) {
      st.half = innerHeight;
      st.wide = innerWidth;
      plates.forEach((el) => setPlate(el, { dim: 0, zoom: 1 }));
      render();
      body.classList.add("is-open");
    } else {
      render();
      busy = true;
      plates.forEach((el) => setPlate(el, { zoom: 1 }));
      setTimeout(() => body.classList.add("show-hint"), 9000);
      addEventListener("wheel", () => body.classList.remove("show-hint"), { once: true });
      open(0).then(() => {
        busy = false;
        if (queued !== null) {
          const q = queued;
          queued = null;
          go(q);
        }
      });
    }
  </script>
</Idea>
