---
/**
 * wall-canvas — every painting hangs on one dark, endless plane at its real
 * relative size. Drag or scroll to wander (with inertia); click a painting
 * and the camera flies to it (2D translate + scale only); Escape flies back.
 * Opens on a detail of the first painting and pulls back to the whole wall.
 */
import { Picture } from "astro:assets";
import Idea from "@/layouts/Idea.astro";
import { getPaintings } from "@/lib/paintings";

const paintings = await getPaintings();

/** Real size in cm, parsed from `medium` ("… 123 × 185 cm"). */
const APPROX: Record<string, [number, number]> = { "fall-of-babylon": [59.5, 90] };
const sizeOf = (p: (typeof paintings)[number]) => {
  const m = p.medium.match(/(\d+(?:\.\d+)?)\s*[×x]\s*(\d+(?:\.\d+)?)\s*cm/);
  if (m) return { h: Number(m[1]), w: Number(m[2]), approx: false };
  const a = APPROX[p.id];
  if (a) return { h: a[0], w: a[1], approx: true };
  // unknown: assume 60 cm tall at the image's own aspect
  return { h: 60, w: (60 * p.image.width) / p.image.height, approx: true };
};

// World unit: px per cm at camera zoom 1.
const U = 6;
const GAP = 150; // cm between neighbours
const ROW = 900; // cm before wrapping to a new row (salon hang)

// Lay out in loose staggered rows; a seeded wobble keeps it from feeling gridded.
let cx = 0;
let rowY = 0;
let rowH = 0;
const wobble = (i: number) => Math.sin(i * 12.9898 + 4.1) * 0.5;
const works = paintings.map((p, i) => {
  const s = sizeOf(p);
  if (cx > 0 && cx + s.w > ROW) {
    cx = 0;
    rowY += rowH + GAP * 1.2;
    rowH = 0;
  }
  const y = rowY + wobble(i) * 90;
  const out = { p, i, ...s, x: cx * U, y: y * U };
  cx += s.w + GAP + Math.abs(wobble(i + 7)) * 60;
  rowH = Math.max(rowH, s.h);
  return out;
});
---

<Idea title="Wall" background="#11100e">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500&family=DM+Mono:wght@300;400&display=swap"
  />

  <div class="wall" id="wall" data-u={U}>
    <canvas class="marks" aria-hidden="true"></canvas>
    <div class="world" id="world">
      {
        works.map((w) => (
          <button
            class="work"
            type="button"
            data-i={w.i}
            data-x={w.x}
            data-y={w.y}
            data-w={w.w * U}
            data-h={w.h * U}
            data-dx={w.p.details[0]?.x ?? 0.5}
            data-dy={w.p.details[0]?.y ?? 0.5}
            data-dz={w.p.details[0]?.zoom ?? 2}
            aria-label={`${w.p.title}, ${w.p.artist}, ${w.p.year}`}
            style={`left:${w.x}px;top:${w.y}px;width:${w.w * U}px;height:${w.h * U}px;background:${w.p.palette[0]}`}
          >
            <Picture
              src={w.p.image}
              formats={["avif", "webp"]}
              widths={[480, 800, 1200, 1600, 2400, 3200]}
              sizes={w.i === 0 ? "2400px" : "800px"}
              alt=""
              loading="eager"
              decoding="async"
              fetchpriority={w.i === 0 ? "high" : "auto"}
              draggable="false"
            />
          </button>
        ))
      }
    </div>
  </div>

  <div class="labels" aria-hidden="true">
    {
      works.map((w) => (
        <div class="label" data-i={w.i}>
          <span class="lt">{w.p.title}</span>
          <span class="la">
            {w.p.artist}, {w.p.year}
          </span>
        </div>
      ))
    }
  </div>

  {
    works.map((w) => (
      <aside class="card" data-i={w.i} aria-hidden="true">
        <p class="cn">
          {String(w.i + 1).padStart(2, "0")} — {String(works.length).padStart(2, "0")}
        </p>
        <h2 class="ct">{w.p.title}</h2>
        <p class="ca">
          {w.p.artist}, {w.p.year}
        </p>
        <p class="cd">
          {w.approx ? `${w.p.medium}. Hung at about ${w.h} × ${w.w} cm.` : w.p.medium}
          <br />
          {w.p.location}
        </p>
        <p class="cr">
          {w.p.rights}
          <br />
          via {w.p.source}
          <br />
          <a href={w.p.original} target="_blank" rel="noopener">
            Full-resolution original ↗
          </a>
        </p>
        <p class="ck">← → to walk on · Esc to step back</p>
      </aside>
    ))
  }

  <header class="mast">
    <span>Artyom Kulimov · Paintings</span>
  </header>
  <footer class="foot">
    <span class="scale" aria-hidden="true"><i></i><b>1 m</b></span>
    <span class="hint">Drag to wander · click a painting</span>
  </footer>
</Idea>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #11100e;
    color: #d9d4c7;
  }
  body {
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: "DM Mono", ui-monospace, monospace;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
    overscroll-behavior: none;
  }

  .wall {
    position: fixed;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .wall.dragging {
    cursor: grabbing;
  }
  .marks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }
  .world.moving {
    will-change: transform;
  }
  .work {
    position: absolute;
    display: block;
    padding: 0;
    border: 0;
    cursor: zoom-in;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.4);
  }
  .work picture,
  .work img {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .work:focus-visible {
    outline: 2px solid #d9d4c7;
    outline-offset: 10px;
  }
  .is-focused .work {
    cursor: grab;
  }

  /* screen-space captions under each painting */
  .labels {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }
  .label {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.35s linear;
  }
  .label.on {
    opacity: 0.78;
  }
  .label.hover {
    opacity: 1;
  }
  .lt {
    font-family: "Newsreader", serif;
    font-style: italic;
    font-size: 16px;
    font-variation-settings: "opsz" 16;
    color: #ece6d8;
  }
  .la {
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: #8f897c;
  }

  /* the wall label beside a focused painting */
  .card {
    position: fixed;
    left: 0;
    top: 0;
    width: 260px;
    pointer-events: none;
    visibility: hidden;
  }
  .card > * {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.25s linear,
      transform 0.4s var(--ease);
  }
  .card.show {
    visibility: visible;
    pointer-events: auto;
  }
  .card.show > * {
    opacity: 1;
    transform: none;
    transition-duration: 0.7s, 1s;
  }
  .card.show > :nth-child(2) {
    transition-delay: 0.06s;
  }
  .card.show > :nth-child(3) {
    transition-delay: 0.12s;
  }
  .card.show > :nth-child(4) {
    transition-delay: 0.18s;
  }
  .card.show > :nth-child(5) {
    transition-delay: 0.24s;
  }
  .card.show > :nth-child(6) {
    transition-delay: 0.36s;
  }
  .card p,
  .card h2 {
    margin: 0;
  }
  .cn {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: #8f897c;
    margin-bottom: 18px !important;
  }
  .ct {
    font-family: "Newsreader", serif;
    font-weight: 350;
    font-size: 34px;
    line-height: 1.02;
    font-variation-settings: "opsz" 48;
    letter-spacing: -0.01em;
    color: #f1ebdd;
    text-wrap: balance;
  }
  .ca {
    font-family: "Newsreader", serif;
    font-style: italic;
    font-size: 17px;
    margin-top: 6px !important;
    color: #cfc8b8;
  }
  .cd,
  .cr {
    font-size: 11px;
    line-height: 1.65;
    letter-spacing: 0.01em;
    color: #a39c8d;
    margin-top: 20px !important;
  }
  .cr a {
    color: #e6dfcf;
    text-decoration: none;
    border-bottom: 1px solid rgb(230 223 207 / 0.35);
  }
  .cr a:hover,
  .cr a:focus-visible {
    border-bottom-color: currentColor;
    outline: none;
  }
  .ck {
    font-size: 10px;
    color: #6b665b;
    margin-top: 26px !important;
  }

  .mast,
  .foot {
    position: fixed;
    left: 28px;
    right: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8f897c;
    pointer-events: none;
  }
  .mast {
    top: 24px;
  }
  .foot {
    bottom: 24px;
  }
  .hint {
    transition: opacity 0.5s linear;
  }
  .is-focused .hint {
    opacity: 0;
  }
  .scale {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .scale i {
    display: block;
    height: 5px;
    border: 1px solid #6b665b;
    border-top: 0;
    width: 100px;
  }

  @media (max-width: 760px) {
    .card {
      width: auto;
      right: 20px;
    }
    .ct {
      font-size: 26px;
    }
    .cd,
    .ck {
      display: none;
    }
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wall = document.getElementById("wall")!;
  const world = document.getElementById("world")!;
  const canvas = wall.querySelector("canvas")!;
  const ctx = canvas.getContext("2d")!;
  const U = Number(wall.dataset.u);
  const scaleBar = document.querySelector<HTMLElement>(".scale i")!;
  const scaleTxt = document.querySelector<HTMLElement>(".scale b")!;

  type Work = {
    el: HTMLButtonElement;
    imgs: (HTMLImageElement | HTMLSourceElement)[];
    asked: number;
    x: number;
    y: number;
    w: number;
    h: number;
    d: { x: number; y: number; z: number };
    label: HTMLElement;
    card: HTMLElement;
  };
  const works: Work[] = [...document.querySelectorAll<HTMLButtonElement>(".work")].map((el, i) => ({
    el,
    imgs: [...el.querySelectorAll<HTMLImageElement | HTMLSourceElement>("img, source")],
    asked: i === 0 ? 2400 : 800,
    x: Number(el.dataset.x),
    y: Number(el.dataset.y),
    w: Number(el.dataset.w),
    h: Number(el.dataset.h),
    d: { x: Number(el.dataset.dx), y: Number(el.dataset.dy), z: Number(el.dataset.dz) },
    label: document.querySelector<HTMLElement>(`.label[data-i="${i}"]`)!,
    card: document.querySelector<HTMLElement>(`.card[data-i="${i}"]`)!,
  }));

  // content bounds (world px)
  const bx0 = Math.min(...works.map((w) => w.x));
  const by0 = Math.min(...works.map((w) => w.y));
  const bx1 = Math.max(...works.map((w) => w.x + w.w));
  const by1 = Math.max(...works.map((w) => w.y + w.h));

  let vw = innerWidth;
  let vh = innerHeight;
  const dpr = Math.min(2, devicePixelRatio || 1);

  // camera: world point at screen centre + zoom
  const cam = { x: (bx0 + bx1) / 2, y: (by0 + by1) / 2, z: 0.3 };

  const overview = () => {
    const pad = Math.min(vw, vh) * 0.11;
    const z = Math.min((vw - pad * 2) / (bx1 - bx0), (vh - pad * 2) / (by1 - by0 + 40 * U));
    return { x: (bx0 + bx1) / 2, y: (by0 + by1) / 2 + 6 * U, z };
  };
  const narrow = () => vw < 760;
  const frameFor = (w: Work) => {
    const pad = Math.max(36, vw * 0.04);
    const side = narrow() ? 0 : 300;
    const below = narrow() ? 190 : 0;
    const aw = vw - pad * 2 - side;
    const ah = vh - pad * 2 - below;
    const z = Math.min(aw / w.w, ah / w.h);
    const sx = pad + aw / 2; // where the painting's centre should land on screen
    const sy = pad + ah / 2;
    return { x: w.x + w.w / 2 - (sx - vw / 2) / z, y: w.y + w.h / 2 - (sy - vh / 2) / z, z };
  };
  const zMin = () => overview().z * 0.45;
  const zMax = () => Math.max(...works.map((w) => frameFor(w).z)) * 3;

  // ---------- rendering ----------
  let focus = -1;
  let hover = -1;
  const toScreen = (x: number, y: number) => ({ x: (x - cam.x) * cam.z + vw / 2, y: (y - cam.y) * cam.z + vh / 2 });

  const NICE = [10, 20, 50, 100, 200, 500, 1000, 2000];
  const drawMarks = () => {
    const w = canvas.width / dpr;
    const h = canvas.height / dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    let step = 100 * U; // a registration mark every metre
    while (step * cam.z < 70) step *= 5;
    const a = toScreen(0, 0);
    const s = step * cam.z;
    const ox = ((a.x % s) + s) % s;
    const oy = ((a.y % s) + s) % s;
    ctx.strokeStyle = "rgba(217, 212, 199, 0.11)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    const r = 3.5;
    for (let x = ox - s; x < w + s; x += s)
      for (let y = oy - s; y < h + s; y += s) {
        const px = Math.round(x) + 0.5;
        const py = Math.round(y) + 0.5;
        ctx.moveTo(px - r, py);
        ctx.lineTo(px + r, py);
        ctx.moveTo(px, py - r);
        ctx.lineTo(px, py + r);
      }
    ctx.stroke();

    // scale bar: a round length that spans 70–170 px
    const cm = NICE.find((c) => c * U * cam.z >= 70) ?? 2000;
    scaleBar.style.width = `${cm * U * cam.z}px`;
    scaleTxt.textContent = cm >= 100 ? `${cm / 100} m` : `${cm} cm`;
  };

  const render = () => {
    world.style.transform = `translate(${vw / 2 - cam.x * cam.z}px, ${vh / 2 - cam.y * cam.z}px) scale(${cam.z})`;
    drawMarks();
    for (const [i, w] of works.entries()) {
      const p = toScreen(w.x, w.y + w.h);
      const sw = w.w * cam.z;
      const on = focus < 0 && sw > 110 && sw < vw * 0.9;
      w.label.style.transform = `translate(${Math.round(p.x)}px, ${Math.round(p.y + 14)}px)`;
      w.label.classList.toggle("on", on);
      w.label.classList.toggle("hover", on && hover === i);
      if (i === focus) {
        const br = toScreen(w.x + w.w, w.y + w.h);
        const card = w.card;
        if (narrow()) {
          card.style.transform = `translate(20px, ${Math.round(br.y + 24)}px)`;
        } else {
          card.style.transform = `translate(${Math.round(br.x + 44)}px, ${Math.round(br.y - card.offsetHeight)}px)`;
        }
      }
    }
  };

  // ask for sharper image candidates once a painting is shown larger
  const sharpen = () => {
    for (const w of works) {
      const need = Math.ceil(w.w * cam.z * dpr);
      if (need > w.asked * 1.05) {
        w.asked = Math.min(3200, Math.ceil(need / 200) * 200);
        for (const s of w.imgs) s.setAttribute("sizes", `${w.asked}px`);
      }
    }
  };

  // ---------- motion loop ----------
  let raf = 0;
  let idleTimer = 0;
  const kick = () => {
    world.classList.add("moving");
    clearTimeout(idleTimer);
    if (!raf) raf = requestAnimationFrame(tick);
  };
  const settle = () => {
    // drop the compositing hint so the browser re-rasterises crisply
    idleTimer = window.setTimeout(() => world.classList.remove("moving"), 160);
    sharpen();
  };

  type Fly = { t0: number; dur: number; at: (t: number) => { x: number; y: number; z: number }; done?: () => void };
  let fly: Fly | null = null;
  const vel = { x: 0, y: 0 }; // screen px per ms
  let dragging = false;
  let last = performance.now();

  // keep the camera within a generous margin of the paintings
  const bounds = () => {
    const mx = Math.max(vw, vh) / cam.z;
    return { x0: bx0 - mx * 0.6, x1: bx1 + mx * 0.6, y0: by0 - mx * 0.5, y1: by1 + mx * 0.5 };
  };
  const over = () => {
    const b = bounds();
    return {
      x: cam.x < b.x0 ? b.x0 - cam.x : cam.x > b.x1 ? b.x1 - cam.x : 0,
      y: cam.y < b.y0 ? b.y0 - cam.y : cam.y > b.y1 ? b.y1 - cam.y : 0,
    };
  };

  const tick = (now: number) => {
    const dt = Math.min(48, now - last);
    last = now;
    let moving = false;
    if (fly) {
      const t = Math.min(1, (now - fly.t0) / fly.dur);
      Object.assign(cam, fly.at(t));
      if (t >= 1) {
        const done = fly.done;
        fly = null;
        done?.();
      } else moving = true;
    } else if (!dragging) {
      // inertia, then rubber-band back inside the bounds
      const decay = Math.exp(-dt / 320);
      vel.x *= decay;
      vel.y *= decay;
      cam.x -= (vel.x * dt) / cam.z;
      cam.y -= (vel.y * dt) / cam.z;
      const o = over();
      cam.x += o.x * (1 - Math.exp(-dt / 140));
      cam.y += o.y * (1 - Math.exp(-dt / 140));
      if (o.x || o.y) {
        vel.x *= 0.85;
        vel.y *= 0.85;
      }
      moving = Math.hypot(vel.x, vel.y) > 0.005 || Math.abs(o.x) + Math.abs(o.y) > 0.5 / cam.z;
    } else moving = true;
    render();
    if (moving) raf = requestAnimationFrame(tick);
    else {
      raf = 0;
      settle();
    }
  };

  // van Wijk & Nuij smooth zoom: pulls back while travelling far, in for the last bit
  const RHO = 1.25;
  const flyTo = (to: { x: number; y: number; z: number }, done?: () => void, minDur = 900) => {
    vel.x = vel.y = 0;
    const w0 = vw / cam.z;
    const w1 = vw / to.z;
    const ux0 = cam.x;
    const uy0 = cam.y;
    const dx = to.x - ux0;
    const dy = to.y - uy0;
    const d2 = dx * dx + dy * dy;
    const r2 = RHO * RHO;
    let S: number;
    let at: (s: number) => { x: number; y: number; z: number };
    if (d2 < 1e-6) {
      S = Math.log(w1 / w0) / RHO;
      at = (t) => ({ x: ux0 + t * dx, y: uy0 + t * dy, z: vw / (w0 * Math.exp(RHO * t * S)) });
    } else {
      const d1 = Math.sqrt(d2);
      const b0 = (w1 * w1 - w0 * w0 + r2 * r2 * d2) / (2 * w0 * r2 * d1);
      const b1 = (w1 * w1 - w0 * w0 - r2 * r2 * d2) / (2 * w1 * r2 * d1);
      const r0 = Math.log(Math.sqrt(b0 * b0 + 1) - b0);
      const r1 = Math.log(Math.sqrt(b1 * b1 + 1) - b1);
      S = (r1 - r0) / RHO;
      at = (t) => {
        const s = t * S;
        const u = (w0 / (r2 * d1)) * (Math.cosh(r0) * Math.tanh(RHO * s + r0) - Math.sinh(r0));
        return { x: ux0 + u * dx, y: uy0 + u * dy, z: vw / ((w0 * Math.cosh(r0)) / Math.cosh(RHO * s + r0)) };
      };
    }
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    const dur = reduce ? 1 : Math.max(minDur, Math.min(2600, Math.abs(S) * 820));
    fly = { t0: performance.now(), dur, at: (t) => (t >= 1 ? to : at(ease(t))), done };
    // fetch sharper pixels for the destination before we arrive
    const was = { ...cam };
    Object.assign(cam, to);
    sharpen();
    Object.assign(cam, was);
    kick();
  };

  // ---------- focus ----------
  let back: { x: number; y: number; z: number } | null = null;
  const setFocus = (i: number) => {
    focus = i;
    document.body.classList.toggle("is-focused", i >= 0);
    works.forEach((w, k) => {
      w.card.classList.toggle("show", k === i);
      w.card.setAttribute("aria-hidden", String(k !== i));
    });
  };
  const focusOn = (i: number) => {
    if (focus < 0) back = { ...cam };
    setFocus(-1);
    hover = -1;
    flyTo(frameFor(works[i]), () => {
      setFocus(i);
      render();
    });
  };
  const unfocus = () => {
    if (focus < 0) return;
    const ov = overview();
    // return to where you were if you had zoomed in somewhere; otherwise re-centre
    const to = back && back.z > ov.z * 1.25 && back.z < frameFor(works[focus]).z * 0.8 ? back : ov;
    setFocus(-1);
    back = null;
    flyTo(to);
  };

  // ---------- input ----------
  let down: { x: number; y: number; t: number; id: number } | null = null;
  let moved = false;
  let samples: { x: number; y: number; t: number }[] = [];

  wall.addEventListener("pointerdown", (e) => {
    if (e.button !== 0) return;
    down = { x: e.clientX, y: e.clientY, t: e.timeStamp, id: e.pointerId };
    moved = false;
    samples = [{ x: e.clientX, y: e.clientY, t: e.timeStamp }];
    fly = null;
    vel.x = vel.y = 0;
  });
  addEventListener("pointermove", (e) => {
    if (!down || e.pointerId !== down.id) {
      const t = (e.target as Element).closest?.(".work") as HTMLElement | null;
      const h = t ? Number(t.dataset.i) : -1;
      if (h !== hover) {
        hover = h;
        render();
      }
      return;
    }
    const prev = samples[samples.length - 1];
    if (!moved && Math.hypot(e.clientX - down.x, e.clientY - down.y) > 5) {
      moved = true;
      dragging = true;
      wall.classList.add("dragging");
      wall.setPointerCapture(e.pointerId);
      if (focus >= 0) setFocus(-1);
    }
    if (!moved) return;
    let dx = e.clientX - prev.x;
    let dy = e.clientY - prev.y;
    const o = over();
    if (o.x) dx *= 0.35; // resist past the edge
    if (o.y) dy *= 0.35;
    cam.x -= dx / cam.z;
    cam.y -= dy / cam.z;
    samples.push({ x: e.clientX, y: e.clientY, t: e.timeStamp });
    if (samples.length > 6) samples.shift();
    kick();
  });
  const release = (e: PointerEvent) => {
    if (!down || e.pointerId !== down.id) return;
    if (moved) {
      const a = samples[0];
      const b = samples[samples.length - 1];
      const dt = Math.max(1, b.t - a.t);
      if (e.timeStamp - b.t < 80 && !reduce) {
        vel.x = (b.x - a.x) / dt;
        vel.y = (b.y - a.y) / dt;
      }
    }
    dragging = false;
    wall.classList.remove("dragging");
    down = null;
    setTimeout(() => (moved = false), 0);
    kick();
  };
  addEventListener("pointerup", release);
  addEventListener("pointercancel", release);

  works.forEach((w, i) =>
    w.el.addEventListener("click", (e) => {
      if (moved) {
        e.preventDefault();
        return;
      }
      if (e.detail > 0) w.el.blur(); // pointer clicks shouldn't leave a focus ring
      if (focus === i) unfocus();
      else focusOn(i);
    }),
  );
  wall.addEventListener("dblclick", (e) => {
    if (!(e.target as Element).closest(".work")) {
      setFocus(-1);
      flyTo(overview());
    }
  });

  wall.addEventListener(
    "wheel",
    (e) => {
      e.preventDefault();
      fly = null;
      const k = e.deltaMode === 1 ? 16 : 1;
      if (e.ctrlKey || e.metaKey) {
        // pinch / ctrl-wheel: zoom about the pointer
        const f = Math.exp(-e.deltaY * k * 0.008);
        const z = Math.min(zMax(), Math.max(zMin(), cam.z * f));
        const wx = (e.clientX - vw / 2) / cam.z + cam.x;
        const wy = (e.clientY - vh / 2) / cam.z + cam.y;
        cam.z = z;
        cam.x = wx - (e.clientX - vw / 2) / z;
        cam.y = wy - (e.clientY - vh / 2) / z;
      } else {
        const o = over();
        cam.x += ((e.deltaX * k) / cam.z) * (o.x ? 0.3 : 1);
        cam.y += ((e.deltaY * k) / cam.z) * (o.y ? 0.3 : 1);
      }
      if (focus >= 0) setFocus(-1);
      vel.x = vel.y = 0;
      kick();
    },
    { passive: false },
  );

  addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const n = works.length;
    if (e.key === "Escape") unfocus();
    else if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
      e.preventDefault();
      const base = focus >= 0 ? focus : e.key === "ArrowRight" ? -1 : n;
      focusOn((base + (e.key === "ArrowRight" ? 1 : -1) + n) % n);
    } else if (e.key === "0" || e.key === "Home") {
      setFocus(-1);
      flyTo(overview());
    } else if (e.key === "+" || e.key === "=" || e.key === "-") {
      const f = e.key === "-" ? 1 / 1.5 : 1.5;
      setFocus(-1);
      flyTo({ ...cam, z: Math.min(zMax(), Math.max(zMin(), cam.z * f)) }, undefined, 500);
    }
  });

  const resize = () => {
    vw = innerWidth;
    vh = innerHeight;
    canvas.width = vw * dpr;
    canvas.height = vh * dpr;
    if (focus >= 0) Object.assign(cam, frameFor(works[focus]));
    render();
    sharpen();
  };
  addEventListener("resize", resize);

  // ---------- intro: open on a detail, then pull back to the whole wall ----------
  const first = works[0];
  const start = () => {
    const f = frameFor(first);
    const z = Math.min(f.z * Math.min(first.d.z, 2.2), (2400 / first.w) * 1.05);
    Object.assign(cam, { x: first.x + first.w * first.d.x, y: first.y + first.h * first.d.y, z });
  };
  resize();
  start();
  render();
  const img = first.el.querySelector("img");
  const ready = img ? Promise.race([img.decode(), new Promise((r) => setTimeout(r, 2500))]) : Promise.resolve();
  ready
    .catch(() => {})
    .then(() => {
      if (reduce) {
        Object.assign(cam, overview());
        render();
        sharpen();
        return;
      }
      setTimeout(() => flyTo(overview(), undefined, 2800), 700);
    });
</script>
